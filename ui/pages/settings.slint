// Settings page: app updates, the compositor's latest commit, about.

import { AboutSlint, ComboBox, Switch } from "std-widgets.slint";
import {
    ActionButton,
    PageHeader,
    PrefRow,
    SectionHeader,
} from "../widgets.slint";
import { Theme } from "../theme.slint";

export component SettingsPage inherits Rectangle {
    in property <string> app-version;
    in property <bool> check-updates-on-start;
    in property <int> update-channel;
    in property <bool> canary-auto-install;
    in property <bool> update-can-install;
    in property <string> update-hint;
    in property <bool> update-installed;
    in property <string> update-note;
    in property <bool> update-available;
    in property <string> update-notes;
    in property <string> upstream-note;
    in property <bool> umbriel-missing;
    in property <bool> dark-mode: true;
    in property <string> config-path;
    in property <[string]> include-files;
    in property <string> sync-note;
    in property <bool> sync-clean: true;
    callback check-now();
    callback toggled(bool);
    callback theme-selected(bool);
    callback open-url(string);
    callback relaunch();
    callback sync-schema();
    callback channel-selected(int);
    callback auto-install-toggled(bool);
    callback install-update();
    callback restart-app();
    callback view-changelog();
    callback view-update-notes();
    in-out property <bool> files-open: false;

    VerticalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 28px;
        alignment: start;

        PageHeader {
            title: "Settings";
            description: "Change how this app behaves and its updates.";
        }

        // ── your config ─────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "Your config";
            }

            VerticalLayout {
                PrefRow {
                    title: "Config file";
                    subtitle: root.config-path;
                }

                PrefRow {
                    title: "Include files";
                    subtitle: root.include-files.length == 0 ? "None. Everything lives in config.toml."
                        : root.include-files.length + " file" + (root.include-files.length == 1 ? "" : "s") + ", read before config.toml.";

                    ActionButton {
                        text: root.files-open ? "Hide" : "Show";
                        visible: root.include-files.length > 0;
                        clicked => { root.files-open = !root.files-open; }
                    }
                }

                if root.files-open: VerticalLayout {
                    padding-left: Theme.space-s;
                    padding-top: Theme.space-s;
                    padding-bottom: Theme.space-s;
                    spacing: Theme.space-xs;

                    for file in root.include-files: Text {
                        text: file;
                        color: Theme.text-2;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                        overflow: elide;
                    }
                }

                PrefRow {
                    title: "Settings list";
                    subtitle: root.sync-note;
                    subtitle-color: root.sync-clean ? Theme.text-2 : Theme.accent;

                    ActionButton {
                        text: "Sync from umbriel";
                        clicked => { root.sync-schema(); }
                    }
                }

                PrefRow {
                    title: "Guided setup";
                    subtitle: "Walk through the settings people change most: outputs, layout, input, general, appearance. Values you already set are left alone.";

                    ActionButton {
                        text: "Run";
                        clicked => { root.relaunch(); }
                    }
                }
            }
        }

        // ── appearance ──────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "Appearance";
            }

            PrefRow {
                title: "Theme";
                subtitle: "Dark or light";

                ComboBox {
                    width: 140px;
                    model: ["Dark", "Light"];
                    current-index: root.dark-mode ? 0 : 1;
                    selected => {
                        root.theme-selected(self.current-index == 0);
                    }
                }
            }
        }

        // ── updates ─────────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "Updates";
            }

            VerticalLayout {
                PrefRow {
                    title: "Check on startup";
                    subtitle: "Look for a new version when the app opens, at most once a day.";

                    Switch {
                        checked: root.check-updates-on-start;
                        toggled => { root.toggled(self.checked); }
                    }
                }

                PrefRow {
                    title: "Update channel";
                    subtitle: root.update-channel == 0
                        ? "Stable: tested releases only."
                        : "Canary: a build for every commit to dev. Recommended for now, may break.";

                    ComboBox {
                        width: 140px;
                        model: ["Stable", "Canary"];
                        current-index: root.update-channel;
                        selected => {
                            root.channel-selected(self.current-index);
                        }
                    }
                }

                if root.update-channel == 1: PrefRow {
                    title: "Install canary builds on app launch";
                    subtitle: "Undo with: umbriel-config rollback";

                    Switch {
                        checked: root.canary-auto-install;
                        toggled => { root.auto-install-toggled(self.checked); }
                    }
                }

                PrefRow {
                    title: "Version " + root.app-version;
                    subtitle: root.update-note == "" ? "Checks against GitHub releases." : root.update-note;
                    subtitle-color: root.update-available ? Theme.success : Theme.text-2;

                    ActionButton {
                        text: "Changelog";
                        clicked => { root.view-changelog(); }
                    }

                    ActionButton {
                        text: "Check now";
                        clicked => { root.check-now(); }
                    }
                }

                // Only a tarball install may replace itself; the others
                // get the command for their own tool.
                if root.update-available: PrefRow {
                    title: "New version";
                    subtitle: root.update-can-install ? (root.update-installed ? "Installed. Restart to use it." : "Ready to install.") : root.update-hint;

                    if root.update-notes != "": ActionButton {
                        text: "What's new";
                        clicked => { root.view-update-notes(); }
                    }

                    if root.update-can-install && !root.update-installed: ActionButton {
                        text: "Install update";
                        primary: true;
                        clicked => { root.install-update(); }
                    }

                    if root.update-installed: ActionButton {
                        text: "Restart now";
                        primary: true;
                        clicked => { root.restart-app(); }
                    }
                }
            }
        }

        // ── umbriel (the compositor) ────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "Umbriel";
            }

            VerticalLayout {
                PrefRow {
                    title: root.umbriel-missing ? "Not detected" : "Detected";
                    subtitle: root.umbriel-missing ? "Without umbriel, saves can't be validated."
                        : root.upstream-note == "" ? "The compositor's latest commit loads while you're here."
                        : "Latest commit: " + root.upstream-note;
                    subtitle-color: root.umbriel-missing ? Theme.warning : Theme.text-2;

                    ActionButton {
                        text: "Repository";
                        clicked => { root.open-url("https://github.com/noctalia-dev/umbriel"); }
                    }
                }
            }
        }

        // ── about ───────────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "About";
            }

            VerticalLayout {
                PrefRow {
                    title: "umbriel-config";
                    subtitle: "Version " + root.app-version + ". Source code and issue tracker on GitHub.";

                    ActionButton {
                        text: "Open on GitHub";
                        clicked => { root.open-url("https://github.com/GhostEagle68/umbriel-config"); }
                    }
                }

                PrefRow {
                    title: "Built with Slint";
                    subtitle: "The UI toolkit.";

                    // The widget asks for 100% of its parent; pin it to
                    // badge size or it swallows the page.
                    AboutSlint {
                        width: 160px;
                        height: 80px;
                    }
                }
            }
        }
    }
}
