// One settings category page: collapsible sections of setting rows,
// label and hint left, editor right. Also renders the guided
// setup's steps.

import { Theme } from "../theme.slint";
import { PageHeader, SectionHeader, SettingRowView } from "../widgets.slint";
import { SettingsCard } from "../types.slint";

export component CategoryPage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <[SettingsCard]> cards;
    callback set-value(string, string);
    callback reset-key(string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int, string);
    callback toggle-card(string);

    // Click-away focus: empty page space falls through to the TouchArea,
    // which hands focus to the sink and thereby blurs (committing) any
    // open editor. Declared first so real widgets stay on top.
    sink := FocusScope { }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { sink.focus(); }
    }

    VerticalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 28px;
        alignment: start;

        if root.title != "": PageHeader {
            title: root.title;
            description: root.description;
        }

        for card in root.cards: VerticalLayout {
            spacing: Theme.space-s;

            if card.title != "": SectionHeader {
                title: card.title;
                collapsible: true;
                expanded: card.expanded;
                toggle => { root.toggle-card(card.key); }
            }

            if card.expanded: VerticalLayout {
                for row in card.rows: SettingRowView {
                    setting: row;
                    set-value(k, v) => { root.set-value(k, v); }
                    reset-key(k) => { root.reset-key(k); }
                    set-slider-value(k, v) => { root.set-slider-value(k, v); }
                    slider-preview(k, v) => { root.slider-preview(k, v); }
                    view-file(i, key) => { root.view-file(i, key); }
                }
            }
        }
    }
}
