// Shaders page and the shader editor's reusable panels: the library of
// discovered GLSL effects, the per-event assignment rows, the visual
// effect builder, and the live preview row.

import {
    ComboBox,
    LineEdit,
    ScrollView,
    Slider,
    Switch,
} from "std-widgets.slint";
import {
    ActionButton,
    PageHeader,
    PrefRow,
    SectionHeader,
    Segmented,
} from "../widgets.slint";
import {
    CodeEdit,
    CodeHint,
    Diagnostic,
    Mark,
    ShaderAssignment,
    KindCount,
    ShaderInfo,
    ShaderStep,
} from "../types.slint";
import { Theme } from "../theme.slint";

// A warning that needs one click to fix: icon, text, the fix.
component Notice inherits Rectangle {
    in property <string> text;
    in property <string> action;
    callback clicked();
    border-radius: Theme.radius-l;
    background: Theme.bg-1;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;

        VerticalLayout {
            alignment: center;

            Image {
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/alert.svg");
                colorize: Theme.warning;
            }
        }

        Text {
            text: root.text;
            color: Theme.text-1;
            wrap: TextWrap.word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;

            ActionButton {
                text: root.action;
                clicked => { root.clicked(); }
            }
        }
    }
}

// A shader's picture: its still thumbnail, or the live preview while
// it plays. Before a thumbnail exists (or when the shader won't
// compile) a quiet placeholder stands in.
component ShaderThumb inherits Rectangle {
    in property <ShaderInfo> shader;
    in property <bool> live;
    in property <image> live-image;
    // The "No shader" entry: umbriel's built-in animation.
    in property <bool> none;
    border-radius: Theme.radius-m;
    background: Theme.bg-2;
    clip: true;

    if root.live || root.shader.has-thumb: Image {
        width: 100%;
        height: 100%;
        image-fit: ImageFit.cover;
        source: root.live ? root.live-image : root.shader.thumb;
    }

    if !root.live && !root.shader.has-thumb: Image {
        width: min(24px, parent.height / 3);
        height: self.width;
        source: root.none ? @image-url("../../assets/icons/windows.svg")
            : root.shader.invalid != "" ? @image-url("../../assets/icons/alert.svg")
            : @image-url("../../assets/icons/sparkle.svg");
        colorize: root.shader.invalid != "" ? Theme.warning : Theme.text-2;
    }

    // Too small a picture (the list's) leaves the badge to its row.
    if root.shader.is-new && root.width > 120px: Rectangle {
        x: 6px;
        y: 6px;
        width: badge-text.preferred-width + 12px;
        height: 18px;
        border-radius: 9px;
        background: Theme.accent;

        badge-text := Text {
            text: "New";
            color: Theme.bg-0;
            font-size: Theme.font-small;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One tile of the grid: the picture, then the name and who uses it.
component ShaderTile inherits Rectangle {
    in property <ShaderInfo> shader;
    in property <bool> selected;
    in property <bool> live;
    in property <image> live-image;
    in property <bool> none;
    callback clicked();
    callback hovered(bool);
    border-radius: Theme.radius-l;
    background: root.selected ? Theme.accent-soft : ta.has-hover ? Theme.bg-1 : transparent;
    border-width: root.selected ? 1.5px : 0px;
    border-color: Theme.accent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        alignment: start;

        ShaderThumb {
            height: self.width * 9 / 16;
            shader: root.shader;
            live: root.live;
            live-image: root.live-image;
            none: root.none;
        }

        VerticalLayout {
            padding-left: 2px;
            padding-right: 2px;
            spacing: 1px;

            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: root.shader.name;
                    color: Theme.text-1;
                    overflow: elide;
                }

                Text {
                    text: root.shader.kind;
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.shader.invalid != "" ? "Won't load" : root.shader.used-by != "" ? "Used by " + root.shader.used-by : root.shader.source;
                color: root.shader.invalid != "" ? Theme.warning : root.shader.used-by != "" ? Theme.accent : Theme.text-2;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
    }
}

// One row of the list: a small picture, the name with who uses it,
// what it does, and (in the library) its actions.
component ShaderListRow inherits Rectangle {
    in property <ShaderInfo> shader;
    in property <bool> selected;
    in property <bool> live;
    in property <image> live-image;
    in property <bool> none;
    in property <bool> actions;
    callback clicked();
    callback hovered(bool);
    callback edit();
    callback fork();
    callback delete();
    min-height: 64px;
    border-radius: Theme.radius-m;
    background: root.selected ? Theme.accent-soft : ta.has-hover ? Theme.bg-1 : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }

    HorizontalLayout {
        padding: Theme.space-s;
        spacing: Theme.space-m;

        VerticalLayout {
            alignment: center;

            ShaderThumb {
                width: 88px;
                height: 50px;
                shader: root.shader;
                live: root.live;
                live-image: root.live-image;
                none: root.none;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.shader.name;
                    color: Theme.text-1;
                }

                if root.shader.is-new: Text {
                    text: "New";
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.shader.kind;
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }

                if root.shader.used-by != "": Text {
                    text: "used by " + root.shader.used-by;
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }

            if root.shader.invalid != "": Text {
                text: root.shader.invalid + ". Umbriel will use the built-in animation.";
                color: Theme.warning;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }

            if root.shader.invalid == "" && root.shader.description != "": Text {
                text: root.shader.description;
                color: Theme.text-2;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }
        }

        if root.actions: VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: Theme.space-s;

                if root.shader.is-own: ActionButton {
                    text: "Edit";
                    clicked => { root.edit(); }
                }

                // Two clicks: deleting a file can't be undone.
                if root.shader.is-own: ActionButton {
                    property <bool> confirming: false;
                    text: !self.confirming ? "Delete" : root.shader.used-by == "" ? "Really delete?" : "Delete? It's in use";
                    clicked => {
                        if (self.confirming) {
                            root.delete();
                        } else {
                            self.confirming = true;
                        }
                    }
                }

                if !root.shader.is-own: ActionButton {
                    text: "Fork";
                    clicked => { root.fork(); }
                }
            }
        }
    }
}

// The library's shaders as a list or a grid, in two collapsible
// sections: yours, then built-in and community. Shared by the Library
// tab and the picker. Hovering can play a shader: in the library the
// hovered picture plays itself (this runs the clock); the picker plays
// it in its big preview instead.
component ShaderGallery inherits VerticalLayout {
    in property <[ShaderInfo]> shaders;
    in property <int> own-count;
    in property <int> other-count;
    // The picker shows one kind (an index into the kinds; -1 shows
    // all), so it counts and places tiles among that kind alone.
    in property <int> kind: -1;
    in property <[KindCount]> kind-counts;
    in property <bool> grid;
    in property <bool> hover-preview;
    // Picker: a "No shader" entry first, selection, no row actions.
    in property <bool> picking;
    // Index into `shaders`; -1 is "No shader", below that nothing.
    in property <int> selected: -2;
    in property <image> live-image;
    in property <bool> inline-play;
    callback activate(int);
    callback hover(int);
    callback scrub(float);
    callback edit(int);
    callback fork(int);
    callback delete(int);

    property <int> hovered: -2;
    property <int> shown-own: root.kind < 0 ? root.own-count : root.kind-counts[root.kind].own;
    property <int> shown-other: root.kind < 0 ? root.other-count : root.kind-counts[root.kind].other;
    property <bool> own-open: true;
    property <bool> other-open: true;
    // The grid: as many ~200px columns as fit.
    property <length> gap: Theme.space-s;
    property <int> columns: max(1, floor((self.width + self.gap) / (200px + self.gap)));
    property <length> tile-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> tile-height: self.tile-width * 9 / 16 + 60px;
    property <ShaderInfo> none-info: { name: "No shader", source: "Umbriel's built-in animation" };

    // Plays the hovered picture: a loop with a short hold on the end.
    property <float> play: 0;
    property <int> hold-ms: 0;
    Timer {
        interval: 16ms;
        running: root.inline-play && root.hover-preview && root.hovered >= 0;
        triggered => {
            if (root.hold-ms > 0) {
                root.hold-ms -= 16;
                if (root.hold-ms <= 0) {
                    root.play = 0;
                }
            } else {
                root.play = min(1, root.play + 16 / 900);
                if (root.play >= 1) {
                    root.hold-ms = 400;
                }
            }
            root.scrub(root.play);
        }
    }

    function hovered-changed(index: int, on: bool) {
        if (on) {
            root.hovered = index;
            root.play = 0.3;
            root.hold-ms = 0;
            root.hover(index);
        } else if (root.hovered == index) {
            root.hovered = -2;
            root.hover(-2);
        }
    }

    pure function shows(shader: ShaderInfo) -> bool {
        return root.kind < 0 || shader.kind-index == root.kind;
    }

    pure function slot-of(shader: ShaderInfo) -> int {
        return root.kind < 0 ? shader.slot : shader.kind-slot;
    }

    function live(index: int) -> bool {
        return root.inline-play && root.hover-preview && root.hovered == index;
    }

    spacing: 28px;

    if root.picking: VerticalLayout {
        if root.grid: HorizontalLayout {
            alignment: start;

            ShaderTile {
                width: root.tile-width;
                height: root.tile-height;
                shader: root.none-info;
                none: true;
                selected: root.selected == -1;
                clicked => { root.activate(-1); }
            }
        }

        if !root.grid: ShaderListRow {
            shader: root.none-info;
            none: true;
            selected: root.selected == -1;
            clicked => { root.activate(-1); }
        }
    }

    if root.shown-own > 0: VerticalLayout {
        spacing: Theme.space-s;

        SectionHeader {
            title: "Your shaders";
            caption: root.shown-own;
            collapsible: true;
            expanded: root.own-open;
            toggle => { root.own-open = !root.own-open; }
        }

        if root.own-open && root.grid: Rectangle {
            height: ceil(root.shown-own / root.columns) * (root.tile-height + root.gap) - root.gap;

            for shader[i] in root.shaders: Rectangle {
                if shader.is-own && root.shows(shader): ShaderTile {
                    x: mod(root.slot-of(shader), root.columns) * (root.tile-width + root.gap);
                    y: floor(root.slot-of(shader) / root.columns) * (root.tile-height + root.gap);
                    width: root.tile-width;
                    height: root.tile-height;
                    shader: shader;
                    selected: root.selected == i;
                    live: root.live(i);
                    live-image: root.live-image;
                    clicked => { root.activate(i); }
                    hovered(on) => { root.hovered-changed(i, on); }
                }
            }
        }

        if root.own-open && !root.grid: VerticalLayout {
            for shader[i] in root.shaders: VerticalLayout {
                if shader.is-own && root.shows(shader): ShaderListRow {
                    shader: shader;
                    selected: root.selected == i;
                    live: root.live(i);
                    live-image: root.live-image;
                    actions: !root.picking;
                    clicked => { root.activate(i); }
                    hovered(on) => { root.hovered-changed(i, on); }
                    edit => { root.edit(i); }
                    delete => { root.delete(i); }
                }
            }
        }
    }

    if root.shown-other > 0: VerticalLayout {
        spacing: Theme.space-s;

        SectionHeader {
            title: "Built-in and community";
            caption: root.shown-other;
            collapsible: true;
            expanded: root.other-open;
            toggle => { root.other-open = !root.other-open; }
        }

        if root.other-open && root.grid: Rectangle {
            height: ceil(root.shown-other / root.columns) * (root.tile-height + root.gap) - root.gap;

            for shader[i] in root.shaders: Rectangle {
                if !shader.is-own && root.shows(shader): ShaderTile {
                    x: mod(root.slot-of(shader), root.columns) * (root.tile-width + root.gap);
                    y: floor(root.slot-of(shader) / root.columns) * (root.tile-height + root.gap);
                    width: root.tile-width;
                    height: root.tile-height;
                    shader: shader;
                    selected: root.selected == i;
                    live: root.live(i);
                    live-image: root.live-image;
                    clicked => { root.activate(i); }
                    hovered(on) => { root.hovered-changed(i, on); }
                }
            }
        }

        if root.other-open && !root.grid: VerticalLayout {
            for shader[i] in root.shaders: VerticalLayout {
                if !shader.is-own && root.shows(shader): ShaderListRow {
                    shader: shader;
                    selected: root.selected == i;
                    live: root.live(i);
                    live-image: root.live-image;
                    actions: !root.picking;
                    clicked => { root.activate(i); }
                    hovered(on) => { root.hovered-changed(i, on); }
                    fork => { root.fork(i); }
                }
            }
        }
    }

    if root.shown-own + root.shown-other == 0: Text {
        text: "No shaders found. Download the community shaders, or copy .glsl files into a shaders/ folder next to your config.";
        color: Theme.text-2;
        wrap: TextWrap.word-wrap;
    }
}

// List or grid, and whether hovering plays: shared by the Library tab
// and the picker, remembered in the app's settings.
component GalleryOptions inherits HorizontalLayout {
    in-out property <bool> grid;
    in-out property <bool> hover-preview;
    // How the library is ordered: an index into `shaders::sorted`.
    in-out property <int> sort;
    callback changed();
    spacing: Theme.space-l;

    ComboBox {
        width: 140px;
        model: ["As found", "Name A–Z", "Name Z–A", "Newest first", "Oldest first"];
        current-index: root.sort;
        selected => {
            root.sort = self.current-index;
            root.changed();
        }
    }

    Segmented {
        options: ["List", "Grid"];
        selected: root.grid ? 1 : 0;
        changed => {
            root.grid = self.selected == 1;
            root.changed();
        }
    }

    HorizontalLayout {
        spacing: Theme.space-s;

        Text {
            text: "Play on hover";
            color: Theme.text-2;
            vertical-alignment: center;
        }

        Switch {
            checked: root.hover-preview;
            toggled => {
                root.hover-preview = self.checked;
                root.changed();
            }
        }
    }
}

// Shaders page, in two tabs: Assignments (which shader each event
// plays; a row opens the picker) and Library (your shaders and the
// others, as a list or a grid). Assignments write straight into the
// owning document (dirty → Save → validate); "No shader" removes the
// key so umbriel's default animation applies.
export component ShadersPage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <[ShaderInfo]> shaders;
    in property <int> own-count;
    in property <int> other-count;
    in property <[ShaderAssignment]> assignments;
    in property <string> download-note;
    in property <bool> include-missing;
    // Set while old `shader = "<path>"` assignments remain; umbriel
    // ignores them.
    in property <string> legacy-note;
    in property <bool> community-installed;
    in property <bool> update-available;
    in-out property <bool> downloading;
    // 0 Assignments, 1 Library; kept by the window across rebuilds.
    in-out property <int> tab: 0;
    in-out property <bool> grid;
    in-out property <int> sort;
    in-out property <bool> hover-preview;
    in property <image> live-image;
    callback download();
    callback fix-include();
    callback convert-legacy();
    callback timing(int);
    callback editor-new();
    callback editor-edit(string);
    callback editor-fork(string, string);
    callback editor-delete(string);
    // Open the picker for an assignment row: (key, event index, the
    // row's current shader: index into `shaders`, -1 none, -2 other).
    callback pick(string, int, int);
    // Open the picker to look at library shader `index`.
    callback open-preview(int);
    callback play(int);
    callback scrub(float);
    callback view-changed();
    callback thumbs-wanted();

    init => { root.thumbs-wanted(); }

    VerticalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: Theme.space-xl;
        alignment: start;

        PageHeader {
            title: root.title;
            description: root.description;

            ActionButton {
                text: "New shader";
                clicked => { root.editor-new(); }
            }
        }

        // A shaders.toml the include chain never loads: umbriel would
        // silently ignore every assignment in it.
        if root.include-missing: Notice {
            text: "shaders.toml in your config folder isn't in your [include] list, so umbriel ignores it.";
            action: "Add to includes";
            clicked => { root.fix-include(); }
        }

        if root.legacy-note != "": Notice {
            text: root.legacy-note;
            action: "Convert";
            clicked => { root.convert-legacy(); }
        }

        HorizontalLayout {
            spacing: Theme.space-l;

            Segmented {
                options: ["Assignments", "Library"];
                selected <=> root.tab;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.tab == 1: GalleryOptions {
                grid <=> root.grid;
                hover-preview <=> root.hover-preview;
                sort <=> root.sort;
                changed => { root.view-changed(); }
            }
        }

        // ── assignments ─────────────────────────────────────
        if root.tab == 0: VerticalLayout {
            // Animations first (EVENTS keeps them ahead of the effects),
            // then a header where the effects start.
            VerticalLayout {
                padding-bottom: Theme.space-s;

                SectionHeader {
                    title: "Animations";
                }
            }

            for row[event] in root.assignments: VerticalLayout {
                if row.kind > 0 && root.assignments[event - 1].kind == 0: VerticalLayout {
                    padding-top: 28px;
                    padding-bottom: Theme.space-s;

                    SectionHeader {
                        title: "Effects";
                    }
                }

                PrefRow {
                    property <int> index: row.current >= 1 && row.current <= root.shaders.length ? row.current - 1 : row.current == 0 ? -1 : -2;
                    title: row.label;
                    subtitle: row.warning == "" ? "" : row.current-name + ": " + row.warning;
                    subtitle-color: Theme.warning;

                    // The event's curve and duration, over a preview.
                    if row.kind == 0: ActionButton {
                        text: "Timing";
                        clicked => { root.timing(event); }
                    }

                    // The current shader; click to pick another.
                    Rectangle {
                        width: 280px;
                        height: 44px;
                        border-radius: Theme.radius-m;
                        background: pick-ta.has-hover ? Theme.bg-2 : Theme.bg-1;
                        border-width: 1px;
                        border-color: Theme.border;

                        pick-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick(row.key, event, index); }
                        }

                        HorizontalLayout {
                            padding: 5px;
                            padding-right: Theme.space-s;
                            spacing: Theme.space-s;

                            ShaderThumb {
                                width: 60px;
                                shader: index >= 0 ? root.shaders[index] : { name: row.current-name };
                                none: index == -1;
                            }

                            Text {
                                text: row.current-name;
                                color: index == -1 ? Theme.text-2 : Theme.text-1;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            VerticalLayout {
                                alignment: center;

                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("../../assets/icons/chevron-right.svg");
                                    colorize: Theme.text-2;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── library ─────────────────────────────────────────
        if root.tab == 1: VerticalLayout {
            spacing: 28px;

            PrefRow {
                title: "Community shaders";
                subtitle: root.download-note != "" ? root.download-note
                    : !root.community-installed ? "A shared collection of effects from the umbriel community."
                    : root.update-available ? "Installed. An update is available with the newest effects."
                    : "Installed and up to date.";
                subtitle-color: root.community-installed && root.update-available ? Theme.warning : Theme.text-2;

                ActionButton {
                    text: root.downloading ? "Downloading…" : root.community-installed ? "Update" : "Download";
                    enabled: !root.downloading;
                    clicked => { root.download(); }
                }
            }

            ShaderGallery {
                shaders: root.shaders;
                own-count: root.own-count;
                other-count: root.other-count;
                grid: root.grid;
                hover-preview: root.hover-preview;
                live-image: root.live-image;
                inline-play: true;
                activate(i) => { root.open-preview(i); }
                hover(i) => {
                    if (i >= 0 && root.hover-preview) {
                        root.play(i);
                    }
                }
                scrub(v) => { root.scrub(v); }
                edit(i) => { root.editor-edit(root.shaders[i].path); }
                fork(i) => { root.editor-fork(root.shaders[i].path, root.shaders[i].name); }
                delete(i) => { root.editor-delete(root.shaders[i].path); }
            }
        }
    }
}

// The shader editor's effect-builder panel: the step stack plus the
// Add-an-effect row. Shown for new, forked and edited shaders alike;
// when the code isn't builder output the panel locks and offers a
// confirmed reset instead of overwriting hand-written code.
export component ShaderBuilderPanel inherits Rectangle {
    in property <[ShaderStep]> steps;
    in property <[string]> kinds;
    in property <bool> locked;
    callback add(string);
    callback reset();
    callback step-remove(int);
    callback step-move(int, int);
    callback step-param(int, int, float);
    // While dragging: code and preview follow, the cards stay put.
    callback step-param-live(int, int, float);

    VerticalLayout {
        spacing: Theme.space-s;

        Text {
            text: "Build an effect";
            color: Theme.text-2;
            font-size: Theme.font-small;
            font-weight: 700;
        }

        if root.locked: Rectangle {
            background: Theme.bg-0;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-s;
                spacing: Theme.space-s;

                Text {
                    text: "This code was edited by hand, so the builder can't read it. Your code is safe: the builder stays off until you start over.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;

                    // Two clicks: starting over replaces the code pane.
                    ActionButton {
                        property <bool> confirming: false;
                        text: self.confirming ? "Replace the code?" : "Start over with builder";
                        clicked => {
                            if (self.confirming) {
                                self.confirming = false;
                                root.reset();
                            } else {
                                self.confirming = true;
                            }
                        }
                    }
                }
            }
        }

        // Add row sits above the stack so it never fights the list for
        // space at the bottom of the panel. The combo flexes to the
        // column's width, so the row can't overflow into the preview.
        HorizontalLayout {
            spacing: Theme.space-s;

            Text {
                text: "Add an effect:";
                color: Theme.text-2;
                vertical-alignment: center;
            }

            add-kind := ComboBox {
                min-width: 110px;
                horizontal-stretch: 1;
                model: root.kinds;
                enabled: !root.locked;
            }

            ActionButton {
                text: "Add";
                enabled: !root.locked;
                clicked => { root.add(add-kind.current-value); }
            }
        }

        // The stack fills the remaining panel height and scrolls when the
        // steps outgrow it.
        ScrollView {
            vertical-stretch: 1;
            min-height: 120px;

            VerticalLayout {
                // Pin cards to their natural height: with the default
                // stretch alignment they would split the whole scroll
                // height between them and balloon.
                alignment: start;
                spacing: Theme.space-s;

                for step in root.steps: Rectangle {
                    background: Theme.bg-0;
                    border-radius: Theme.radius-m;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: Theme.space-s;
                        spacing: Theme.space-xs;

                        HorizontalLayout {
                            spacing: Theme.space-s;

                            Text {
                                text: step.label;
                                color: Theme.text-1;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            ActionButton {
                                text: "↑";
                                clicked => { root.step-move(step.index, -1); }
                            }

                            ActionButton {
                                text: "↓";
                                clicked => { root.step-move(step.index, 1); }
                            }

                            ActionButton {
                                text: "×";
                                clicked => { root.step-remove(step.index); }
                            }
                        }

                        if step.p-count > 0: HorizontalLayout {
                            spacing: Theme.space-m;

                            Text {
                                text: step.p1-label;
                                color: Theme.text-2;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                min-width: 64px;
                            }

                            slider1 := Slider {
                                minimum: step.p1-min;
                                maximum: step.p1-max;
                                value: step.p1-value;
                                changed(v) => { root.step-param-live(step.index, 0, v); }
                                released(v) => { root.step-param(step.index, 0, v); }
                            }

                            Text {
                                text: slider1.value.to-fixed(step.p1-decimals);
                                color: Theme.text-1;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                min-width: 44px;
                            }
                        }

                        if step.p-count > 1: HorizontalLayout {
                            spacing: Theme.space-m;

                            Text {
                                text: step.p2-label;
                                color: Theme.text-2;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                min-width: 64px;
                            }

                            slider2 := Slider {
                                minimum: step.p2-min;
                                maximum: step.p2-max;
                                value: step.p2-value;
                                changed(v) => { root.step-param-live(step.index, 1, v); }
                                released(v) => { root.step-param(step.index, 1, v); }
                            }

                            Text {
                                text: slider2.value.to-fixed(step.p2-decimals);
                                color: Theme.text-1;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                min-width: 44px;
                            }
                        }

                        if step.p-count > 2: HorizontalLayout {
                            spacing: Theme.space-m;

                            Text {
                                text: step.p3-label;
                                color: Theme.text-2;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                min-width: 64px;
                            }

                            slider3 := Slider {
                                minimum: step.p3-min;
                                maximum: step.p3-max;
                                value: step.p3-value;
                                changed(v) => { root.step-param-live(step.index, 2, v); }
                                released(v) => { root.step-param(step.index, 2, v); }
                            }

                            Text {
                                text: slider3.value.to-fixed(step.p3-decimals);
                                color: Theme.text-1;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                min-width: 44px;
                            }
                        }
                    }
                }
            }
        }
    }
}

// The preview's free-running clock, in seconds: what `umbriel_time`
// reads. The playing row advances it; Rust reads it for each frame.
export global PreviewClock {
    in-out property <float> seconds;
}

// The shader editor's live preview: the rendered frame with its scrub
// slider beside the description and the In/Out toggle. The frame keeps
// the test texture's 16:9 shape at any width.
export component ShaderPreviewRow inherits Rectangle {
    in property <image> source;
    in property <string> note;
    in property <bool> direction-in;
    in-out property <float> progress;
    in property <[string]> events;
    in-out property <int> event-index;
    // The chosen event's own length (a spring's settle time, else its
    // duration_ms): the "As set" playback speed.
    in property <int> configured-ms;
    callback event-picked(int);
    callback scrub(float);
    callback toggle-direction();
    in property <string> hint: "Scrub or play the animation on a stand-in for the chosen event, with that event's curve and timing from your config. Saving asks which events should use the shader.";
        // Start playing on open (the picker); the editor starts paused.
    in property <bool> autoplay: false;
    // The "Preview as" picker: off where the event is fixed.
    in property <bool> pick-event: true;
    // The playback length to start on: 0 "As set", else a fixed one.
    in property <int> initial-length: 3;

    // Playback: a frame tick advances the scrubber over the chosen
    // length, holds briefly on the last frame, then loops. Dragging the
    // scrubber takes over and pauses.
    property <bool> playing: root.autoplay;
    property <[string]> lengths: ["As set (" + root.configured-ms + " ms)", "0.3 s", "0.6 s", "1.2 s"];
    property <int> length-index: root.initial-length;
    property <float> length-ms: root.length-index == 0 ? max(1, root.configured-ms) : root.length-index == 1 ? 300 : root.length-index == 2 ? 600 : 1200;
    property <float> hold-ms: 0;
    // When the last tick ran, so the clock follows real time when ticks slip.
    property <duration> last-tick;

    horizontal-stretch: 1;

    Timer {
        interval: 16ms;
        running: root.playing;
        triggered => {
            // A tick that follows a pause counts for at most 100 ms.
            PreviewClock.seconds += min(100ms, animation-tick() - root.last-tick) / 1s;
            root.last-tick = animation-tick();
            if (root.hold-ms > 0) {
                root.hold-ms -= 16;
                if (root.hold-ms <= 0) {
                    root.progress = 0;
                }
                root.scrub(root.progress);
                return;
            }
            root.progress = min(1, root.progress + 16 / root.length-ms);
            root.scrub(root.progress);
            if (root.progress >= 1) {
                root.hold-ms = 500;
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-m;

        // Frame column: shrinks on narrow cards, never dominates.
        VerticalLayout {
            min-width: 220px;
            max-width: 360px;
            horizontal-stretch: 3;
            spacing: Theme.space-xs;

            Rectangle {
                height: self.width * 9 / 16;
                border-radius: Theme.radius-s;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                Image {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.contain;
                    source: root.source;
                }
            }

            Slider {
                minimum: 0;
                maximum: 1;
                value <=> root.progress;
                changed(v) => {
                    root.playing = false;
                    root.scrub(v);
                }
            }
        }

        // Description column.
        VerticalLayout {
            min-width: 150px;
            horizontal-stretch: 2;
            spacing: Theme.space-xs;
            alignment: start;

            Text {
                text: "Preview";
                color: Theme.text-2;
                font-size: Theme.font-small;
                font-weight: 700;
            }

            Text {
                text: root.hint;
                color: Theme.text-2;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }

            if root.pick-event: HorizontalLayout {
                spacing: Theme.space-s;
                alignment: start;

                Text {
                    text: "Preview as";
                    color: Theme.text-2;
                    vertical-alignment: center;
                }

                ComboBox {
                    width: 170px;
                    model: root.events;
                    current-index <=> root.event-index;
                    selected => { root.event-picked(self.current-index); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-s;
                alignment: start;

                Text {
                    text: "Direction";
                    color: Theme.text-2;
                    vertical-alignment: center;
                }

                ActionButton {
                    text: root.direction-in ? "In" : "Out";
                    clicked => { root.toggle-direction(); }
                }

                ActionButton {
                    text: root.playing ? "Pause" : "Play";
                    clicked => {
                        if (!root.playing && root.progress >= 1) {
                            root.progress = 0;
                            root.scrub(0);
                        }
                        root.hold-ms = 0;
                        root.playing = !root.playing;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            // How long one play-through takes; the controls above stay
            // short enough for a narrow column.
            HorizontalLayout {
                alignment: start;

                ComboBox {
                    width: 160px;
                    model: root.lengths;
                    current-index <=> root.length-index;
                }
            }

            if root.note != "": Text {
                text: root.note;
                color: Theme.warning;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}

// The shader code pane: a plain TextInput (std TextEdit hides the
// cursor offsets) so code keys work like an editor. Tab indents,
// Shift+Tab outdents, Enter keeps the indentation; Rust does the text
// surgery through `code-key` ("indent" / "outdent" / "newline").
// Undo/redo come from Rust too (`history`): the TextInput's own history
// goes stale once the text is replaced from outside, and replaying it
// can crash.
//
// Highlighting: the input's text is transparent and sits over one copy
// of the code per token class (`layer`), each blanked except for its
// class, so the copies lay out exactly like the input. The input then
// can't draw its caret, so the editor draws one. The gutter is another
// `layer` copy (line numbers) that follows the scroll.
export component ShaderCodeEditor inherits Rectangle {
    in-out property <string> text <=> input.text;
    // (text, anchor, cursor, kind): kind 0 = typed, 1 = a key edit
    // (Tab/Enter), 2 = an undo/redo restore (not recorded again).
    callback edited(string, int, int, int);
    callback code-key(string, int, int, string) -> CodeEdit;
    // "undo" / "redo": the state to restore, or cursor -1 for none.
    callback history(string) -> CodeEdit;
    // A copy of the text for one layer: 0..7 the token classes (plain,
    // comment, keyword, type, builtin, umbriel, number, preprocessor),
    // 8 the line numbers. See src/config/shaders/tokens.rs.
    pure callback layer(string, int) -> string;
    // The shader's kind (an index into the kinds), for suggestions.
    in property <int> kind;
    // Suggestions for the word at the caret (after typing), and the
    // text with one accepted.
    pure callback suggest(string, int, int) -> [CodeHint];
    callback complete(string, int, string) -> CodeEdit;
    // The compile problems to mark (gutter bar, line band, list below).
    in property <[Diagnostic]> problems;
    // The byte offset where a 1-based line starts, for jumping to it.
        callback line-offset(string, int) -> int;
    // What to highlight at the caret: the bracket it sits beside and
    // that bracket's partner.
        pure callback marks(string, int) -> [Mark];
    // The find bar: every match of a query, and a button's step (text,
    // anchor, caret, query, replacement, "from" / "next" / "previous" /
    // "replace" / "replace-all") as a new text and selection.
        pure callback find-marks(string, string) -> [Mark];
    // "2 of 4": the count the bar shows for (text, query, selection start).
    pure callback find-status(string, string, int) -> string;

    callback find-step(string, int, int, string, string, string) -> CodeEdit;

    property <length> caret-x;
    property <length> caret-y;
    property <bool> caret-on: true;
    // Set by typing, cleared by moving the caret or Escape, so clicking
    // into a word doesn't pop suggestions up.
    property <bool> suggesting;
    property <int> hint-index;
    property <[CodeHint]> hints: root.suggest(input.text, input.cursor-position-byte-offset, root.kind);
    property <bool> hints-open: root.suggesting && root.hints.length > 0 && input.has-focus;
    // The distance between lines. Measured over many lines: one line's
    // own height is rounded up and would drift down the page.
        property <length> line-height: probe.preferred-height / 50;
    property <length> char-width: width-probe.preferred-width / 50;
    property <[Mark]> bracket-marks: root.marks(input.text, input.cursor-position-byte-offset);
    property <bool> goto-open;
    property <bool> find-open;
    property <string> find-text;
    property <string> replace-text;
    property <[Mark]> match-marks: root.find-marks(input.text, root.find-open ? root.find-text : "");
    property <string> find-count: root.find-status(input.text, root.find-open ? root.find-text : "", min(input.anchor-position-byte-offset, input.cursor-position-byte-offset));

    function token-color(index: int) -> color {
        return index == 1 ? Theme.text-2
            : index == 2 ? Theme.accent
            : index == 3 ? Theme.syn-type
            : index == 4 ? Theme.syn-builtin
            : index == 5 ? Theme.syn-umbriel
            : index == 6 ? Theme.syn-number
            : index == 7 ? Theme.syn-preproc
            : Theme.text-1;
    }

    background: Theme.bg-0;
    border-radius: Theme.radius-s;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    forward-focus: input;

    // Run an editor key in Rust; false when it left the text and caret as
    // they were, so the text box should handle the key itself.
    function apply(kind: string) -> bool {
        let result = root.code-key(input.text, input.anchor-position-byte-offset, input.cursor-position-byte-offset, kind);
        if (result.text == input.text && result.anchor == input.anchor-position-byte-offset && result.cursor == input.cursor-position-byte-offset) {
            return false;
        }
        input.text = result.text;
        input.set-selection-offsets(result.anchor, result.cursor);
        // Read back from the input: reusing result.text after the
        // assignment trips a move bug in Slint 1.16's Rust codegen.
                root.edited(input.text, input.anchor-position-byte-offset, input.cursor-position-byte-offset, 1);
        return true;
    }

    // A find-bar button: select the match (or replace), as Rust says.
    function find(action: string) {
        let result = root.find-step(input.text, input.anchor-position-byte-offset, input.cursor-position-byte-offset, root.find-text, root.replace-text, action);
        let changed = result.text != input.text;
        if (!changed && result.anchor == input.anchor-position-byte-offset && result.cursor == input.cursor-position-byte-offset) {
            return;
        }
        input.text = result.text;
        input.set-selection-offsets(result.anchor, result.cursor);
        if (changed) {
            root.edited(input.text, input.anchor-position-byte-offset, input.cursor-position-byte-offset, 1);
        }
    }

    function close-find() {
        root.find-open = false;
        input.focus();
    }

    changed hints => { root.hint-index = 0; }

    function accept-hint(index: int) {
        let result = root.complete(input.text, input.cursor-position-byte-offset, root.hints[index].label);
        input.text = result.text;
        input.set-selection-offsets(result.anchor, result.cursor);
        root.suggesting = false;
        root.edited(input.text, input.anchor-position-byte-offset, input.cursor-position-byte-offset, 1);
        input.focus();
    }

    // Put the caret at the start of a problem's line (the editor
    // scrolls to it as it does for any caret move).
    function jump(line: int) {
        let at = root.line-offset(input.text, line);
        input.set-selection-offsets(at, at);
        input.focus();
    }

    function step-history(kind: string) {
        let result = root.history(kind);
        if (result.cursor < 0) {
            return;
        }
        input.text = result.text;
        input.set-selection-offsets(result.anchor, result.cursor);
        root.edited(input.text, input.anchor-position-byte-offset, input.cursor-position-byte-offset, 2);
    }

    probe := Text {
        visible: false;
        text: "M\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM\nM";
        font-family: Theme.font-mono;
        font-size: Theme.font-small;
    }

    // One character's width, for placing highlights by column.
    width-probe := Text {
        visible: false;
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
        font-family: Theme.font-mono;
        font-size: Theme.font-small;
    }

    // Blinks while focused; a move shows the caret at once.
    Timer {
        interval: 530ms;
        running: input.has-focus;
        triggered => { root.caret-on = !root.caret-on; }
    }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            gutter := Rectangle {
            // Whole pixels, so the code never starts between two.
            width: ceil(numbers.preferred-width / 1px) * 1px + 2 * Theme.space-s;
                clip: true;

                numbers := Text {
                    x: Theme.space-s;
                    y: Theme.space-s + scroll.viewport-y;
                    text: root.layer(input.text, 8);
                    color: Theme.text-2;
                    horizontal-alignment: right;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-small;
                }

                for problem in root.problems: Rectangle {
                    visible: problem.line > 0;
                    x: 0;
                    y: Theme.space-s + scroll.viewport-y + (problem.line - 1) * root.line-height;
                    width: 3px;
                    height: root.line-height;
                    background: Theme.danger;
                }
            }

            ContextMenuArea {
                Menu {
                    MenuItem {
                        title: "Cut";
                        activated => { input.cut(); }
                    }

                    MenuItem {
                        title: "Copy";
                        activated => { input.copy(); }
                    }

                    MenuItem {
                        title: "Paste";
                        activated => { input.paste(); }
                    }

                    MenuItem {
                        title: "Select All";
                        activated => { input.select-all(); }
                    }
                }

                scroll := ScrollView {
                    viewport-width: max(self.visible-width, input.preferred-width + 2 * Theme.space-s);
                    viewport-height: max(self.visible-height, input.preferred-height + 2 * Theme.space-s);

                    // Every match of the find bar's query.
                    for mark in root.match-marks: Rectangle {
                        x: Theme.space-s + mark.col * root.char-width;
                        y: Theme.space-s + mark.line * root.line-height;
                        width: mark.len * root.char-width;
                        height: root.line-height;
                        border-radius: 2px;
                        background: Theme.warning.with-alpha(0.3);
                    }

                    // The brackets that match at the caret.
                    for mark in root.bracket-marks: Rectangle {
                        x: Theme.space-s + mark.col * root.char-width;
                        y: Theme.space-s + mark.line * root.line-height;
                        width: mark.len * root.char-width;
                        height: root.line-height;
                        border-radius: 2px;
                        background: Theme.accent.with-alpha(0.35);
                    }

                    // A band behind each problem's line.
                for problem in root.problems: Rectangle {
                        visible: problem.line > 0;
                        x: 0;
                        y: Theme.space-s + (problem.line - 1) * root.line-height;
                        width: scroll.viewport-width;
                        height: root.line-height;
                        background: Theme.danger.with-alpha(0.14);
                    }

                    for index in 8: Text {
                        x: Theme.space-s;
                        y: Theme.space-s;
                        text: root.layer(input.text, index);
                        color: root.token-color(index);
                        wrap: no-wrap;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                    }

                    input := TextInput {
                        x: Theme.space-s;
                        y: Theme.space-s;
                        width: max(scroll.visible-width, self.preferred-width + 2 * Theme.space-s) - 2 * Theme.space-s;
                        height: max(scroll.visible-height, self.preferred-height + 2 * Theme.space-s) - 2 * Theme.space-s;
                        single-line: false;
                        wrap: no-wrap;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                    // The colored copies underneath show through. Not fully
                    // transparent (alpha 1 of 255): the renderers skip a
                    // text input drawn in a transparent color altogether,
                    // selection highlight included.
                    color: #ffffff01;
                        selection-foreground-color: #ffffff01;
                        selection-background-color: Theme.accent.with-alpha(0.35);

                        edited => {
                            root.suggesting = true;
                            root.edited(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset, 0);
                        }

                        key-pressed(event) => {
                            if (root.hints-open) {
                                if (event.text == Key.DownArrow) {
                                    root.hint-index = min(root.hint-index + 1, root.hints.length - 1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.hint-index = max(root.hint-index - 1, 0);
                                    return accept;
                                }
                                if (event.text == Key.Tab && !event.modifiers.shift) {
                                    root.accept-hint(root.hint-index);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.suggesting = false;
                                    return accept;
                                }
                            }
                            if (event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Home || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown) {
                                root.suggesting = false;
                            }
                        // Undo/redo before the TextInput's own (stale) history.
                        if (event.modifiers.control && !event.modifiers.alt) {
                                if (event.text == "/" && root.apply("comment")) {
                                    return accept;
                                }
                                if (event.text == "f" || event.text == "F" || event.text == "h" || event.text == "H") {
                                    root.find-open = true;
                                    find-edit.focus();
                                    return accept;
                                }
                                if (event.text == "g" || event.text == "G") {
                                    root.goto-open = true;
                                    return accept;
                                }
                                if ((event.text == "z" || event.text == "Z") && !event.modifiers.shift) {
                                    root.step-history("undo");
                                    return accept;
                                }
                                if (event.text == "z" || event.text == "Z" || event.text == "y" || event.text == "Y") {
                                    root.step-history("redo");
                                    return accept;
                                }
                            }
                            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                                return reject;
                            }
                            // Brackets close themselves and are typed over;
                            // Backspace between a pair takes both.
                            if ((event.text == "(" || event.text == "[" || event.text == "{") && root.apply("open" + event.text)) {
                                return accept;
                            }
                            if ((event.text == ")" || event.text == "]" || event.text == "}") && root.apply("close" + event.text)) {
                                return accept;
                            }
                            if (event.text == Key.Backspace && root.apply("backspace")) {
                                return accept;
                            }
                            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                                root.apply("outdent");
                                return accept;
                            }
                            if (event.text == Key.Tab) {
                                root.apply("indent");
                                return accept;
                            }
                            if (event.text == Key.Return && !event.modifiers.shift) {
                                root.apply("newline");
                                return accept;
                            }
                            return reject;
                        }

                    // Keep the caret in view, as std TextEdit does.
                    cursor-position-changed(cpos) => {
                            root.caret-x = cpos.x;
                            root.caret-y = cpos.y;
                            root.caret-on = true;
                            if (cpos.x + scroll.viewport-x < 12px) {
                                scroll.viewport-x = min(0px, max(scroll.visible-width - scroll.viewport-width, -cpos.x + 12px));
                            } else if (cpos.x + scroll.viewport-x > scroll.visible-width - 12px) {
                                scroll.viewport-x = min(0px, max(scroll.visible-width - scroll.viewport-width, scroll.visible-width - cpos.x - 12px));
                            }
                            if (cpos.y + scroll.viewport-y < 12px) {
                                scroll.viewport-y = min(0px, max(scroll.visible-height - scroll.viewport-height, -cpos.y + 12px));
                            } else if (cpos.y + scroll.viewport-y > scroll.visible-height - 32px) {
                                scroll.viewport-y = min(0px, max(scroll.visible-height - scroll.viewport-height, scroll.visible-height - cpos.y - 32px));
                            }
                        }
                    }

                    // The caret: hidden while a range is selected.
                Rectangle {
                        x: input.x + root.caret-x;
                        y: input.y + root.caret-y;
                        width: 2px;
                        height: root.line-height;
                        background: Theme.text-1;
                        visible: input.has-focus && root.caret-on && input.anchor-position-byte-offset == input.cursor-position-byte-offset;
                    }
                }
            }
        }

        // The first few problems; a row jumps to its line.
    if root.problems.length > 0: Rectangle {
            height: problem-list.preferred-height;

            problem-list := VerticalLayout {
                padding: Theme.space-s;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                for problem[i] in root.problems: VerticalLayout {
                    if i < 4: Rectangle {
                        height: 22px;

                        TouchArea {
                            enabled: problem.line > 0;
                            mouse-cursor: problem.line > 0 ? pointer : default;
                            clicked => { root.jump(problem.line); }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-m;

                            Text {
                                text: problem.line > 0 ? "Line " + problem.line : "";
                                color: Theme.danger;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                width: 64px;
                            }

                            Text {
                                text: problem.message;
                                color: Theme.text-1;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }

                if root.problems.length > 4: Text {
                    text: "and " + (root.problems.length - 4) + " more";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                }
            }
        }
    }
    // Ctrl+F (or Ctrl+H): find and replace. Typing selects the first
    // match; Enter goes to the next, Esc closes.
    Rectangle {
        visible: root.find-open;
        width: 460px;
        height: find-grid.preferred-height;
        x: root.width - self.width - 16px;
        y: 8px;
        background: Theme.bg-3;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000055;

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-find();
                    return accept;
                }
                return reject;
            }

            // One grid, so both text boxes are the same width whatever
            // the buttons beside them need.
                        find-grid := GridLayout {
                padding: Theme.space-s;
                spacing: Theme.space-s;

                Row {
                    find-edit := LineEdit {
                        placeholder-text: "Find";
                        text <=> root.find-text;
                        edited => { root.find("from"); }
                        accepted => { root.find("next"); }
                    }

                    Text {
                        text: root.find-count;
                        color: root.find-count == "No matches" ? Theme.danger : Theme.text-2;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }

                    ActionButton {
                        text: "Prev";
                        clicked => { root.find("previous"); }
                    }

                    ActionButton {
                        text: "Next";
                        clicked => { root.find("next"); }
                    }

                    ActionButton {
                        text: "×";
                        clicked => { root.close-find(); }
                    }
                }

                Row {
                    LineEdit {
                        placeholder-text: "Replace with";
                        text <=> root.replace-text;
                        accepted => { root.find("replace"); }
                    }

                    ActionButton {
                        colspan: 2;
                        text: "Replace";
                        clicked => { root.find("replace"); }
                    }

                    ActionButton {
                        colspan: 2;
                        text: "All";
                        clicked => { root.find("replace-all"); }
                    }
                }
            }
        }
    }

    // Ctrl+G: a line number, Enter to go, Esc to close.
    if root.goto-open: Rectangle {
        width: 220px;
        height: 40px;
        x: root.width - self.width - 16px;
        y: 8px;
        background: Theme.bg-3;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000055;

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.goto-open = false;
                    input.focus();
                    return accept;
                }
                return reject;
            }

            HorizontalLayout {
                padding: Theme.space-s;
                spacing: Theme.space-s;

                Text {
                    text: "Go to line";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }

                LineEdit {
                    input-type: number;
                    horizontal-stretch: 1;
                    init => { self.focus(); }
                    accepted(text) => {
                        root.goto-open = false;
                        root.jump(text.to-float());
                    }
                }
            }
        }
    }

    // The suggestions, under the caret (above it near the bottom).
    if root.hints-open: Rectangle {
        property <length> caret-left: scroll.absolute-position.x - root.absolute-position.x + input.x + root.caret-x + scroll.viewport-x;
        property <length> caret-top: scroll.absolute-position.y - root.absolute-position.y + input.y + root.caret-y + scroll.viewport-y;

        width: 380px;
        height: hint-list.preferred-height;
        x: max(0px, min(self.caret-left, root.width - self.width - 4px));
        y: self.caret-top + root.line-height + 2px + self.height <= root.height ? self.caret-top + root.line-height + 2px : max(0px, self.caret-top - self.height - 2px);
        background: Theme.bg-3;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000055;

        hint-list := VerticalLayout {
            padding: 4px;

            for hint[i] in root.hints: Rectangle {
                height: 24px;
                border-radius: Theme.radius-s;
                background: i == root.hint-index ? Theme.accent-soft : transparent;

                TouchArea {
                    clicked => { root.accept-hint(i); }
                }

                HorizontalLayout {
                    padding-left: Theme.space-s;
                    padding-right: Theme.space-s;
                    spacing: Theme.space-m;

                    Text {
                        text: hint.label;
                        color: Theme.text-1;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }

                    Text {
                        text: hint.detail;
                        color: Theme.text-2;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }

            if root.hints[min(root.hint-index, root.hints.length - 1)].doc != "": HorizontalLayout {
                padding: 4px;

                Text {
                    text: root.hints[min(root.hint-index, root.hints.length - 1)].doc;
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Pick a shader for one event: the chosen shader plays in the big
// preview on top, the library sits below as a list or grid. Hovering
// (when on) plays the hovered one in the big preview; leaving goes back
// to the chosen one. Opened from the library (no key) it shows just
// that shader with its own actions.
export component ShaderPicker inherits Rectangle {
    in property <string> title;
    // An assignment key; "" is just looking (no Assign).
    in property <string> key;
    // The kind the assignment takes; -1 when just looking.
    in property <int> kind: -1;
    in property <[ShaderInfo]> shaders;
    in property <int> own-count;
    in property <int> other-count;
    in property <[KindCount]> kind-counts;
    in-out property <bool> grid;
    in-out property <int> sort;
    in-out property <bool> hover-preview;
    in-out property <int> selected;
    // The live preview, as the editor has it.
    in property <image> preview-image;
    in property <bool> preview-ready;
    in property <string> preview-note;
    in property <bool> direction-in;
    in-out property <float> progress;
    in property <[string]> events;
    in-out property <int> event-index;
    in property <int> configured-ms;
    callback close();
    callback assign(int);
    // Play library shader `index` in the preview.
    callback show(int);
    callback event-picked(int);
    callback scrub(float);
    callback toggle-direction();
    callback view-changed();
    callback edit(int);
    callback fork(int);
    callback delete(int);

    // What the big preview plays: the hovered shader, else the chosen.
    property <int> hovered: -2;
    property <int> shown: root.hovered >= 0 ? root.hovered : root.selected;

    width: 100%;
    height: 100%;
    background: #00000099;

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 64px, root.key == "" ? 760px : 1040px);
        height: root.key == "" ? min(parent.height - 64px, box.preferred-height) : parent.height - 64px;
        border-radius: Theme.radius-xl;
        background: Theme.bg-3;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000066;

        TouchArea { }

        box := VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-l;

            HorizontalLayout {
                spacing: Theme.space-l;

                Text {
                    text: root.title;
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.key != "": GalleryOptions {
                    grid <=> root.grid;
                    hover-preview <=> root.hover-preview;
                    sort <=> root.sort;
                    changed => { root.view-changed(); }
                }
            }

            // The preview's room is kept while picking, so hovering in
            // and out of it doesn't move the tiles under the pointer.
            VerticalLayout {
                min-height: root.key != "" ? 360px * 9 / 16 + 40px : 0;
                spacing: Theme.space-l;

                if root.shown >= 0 && root.preview-ready: ShaderPreviewRow {
                    source: root.preview-image;
                    note: root.preview-note;
                    hint: root.shaders[root.shown].description;
                    autoplay: true;
                    direction-in: root.direction-in;
                    progress <=> root.progress;
                    events: root.events;
                    event-index <=> root.event-index;
                    configured-ms: root.configured-ms;
                    event-picked(i) => { root.event-picked(i); }
                    scrub(v) => { root.scrub(v); }
                    toggle-direction() => { root.toggle-direction(); }
                }

                if root.shown == -1: Text {
                    text: "No shader: umbriel plays its built-in animation for this event.";
                    color: Theme.text-2;
                }

                if root.shown >= 0 && !root.preview-ready: Text {
                    text: root.preview-note != "" ? root.preview-note : "Starting the preview…";
                    color: Theme.text-2;
                }
            }

            if root.key != "": gsv := ScrollView {
                vertical-stretch: 1;
                viewport-height: gallery.preferred-height;

                gallery := ShaderGallery {
                    width: gsv.visible-width;
                    shaders: root.shaders;
                    own-count: root.own-count;
                    other-count: root.other-count;
                    kind: root.kind;
                    kind-counts: root.kind-counts;
                    grid: root.grid;
                    hover-preview: root.hover-preview;
                    picking: root.key != "";
                    selected: root.selected;
                    activate(i) => {
                        root.selected = i;
                        if (i >= 0) {
                            root.show(i);
                        }
                    }
                    hover(i) => {
                        root.hovered = root.hover-preview ? i : -2;
                        if (!root.hover-preview) {
                            return;
                        }
                        if (i >= 0) {
                            root.show(i);
                        } else if (root.selected >= 0) {
                            root.show(root.selected);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-s;

                // Just looking: the chosen shader's own action.
                if root.key == "" && root.selected >= 0 && root.shaders[root.selected].is-own: ActionButton {
                    text: "Edit";
                    clicked => { root.edit(root.selected); }
                }

                // Two clicks: deleting a file can't be undone.
                if root.key == "" && root.selected >= 0 && root.shaders[root.selected].is-own: ActionButton {
                    property <bool> confirming: false;
                    text: !self.confirming ? "Delete" : root.shaders[root.selected].used-by == "" ? "Really delete?" : "Delete? It's in use";
                    clicked => {
                        if (self.confirming) {
                            root.delete(root.selected);
                        } else {
                            self.confirming = true;
                        }
                    }
                }

                if root.key == "" && root.selected >= 0: ActionButton {
                    text: "Fork";
                    clicked => { root.fork(root.selected); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                ActionButton {
                    text: root.key == "" ? "Close" : "Cancel";
                    clicked => { root.close(); }
                }

                if root.key != "": ActionButton {
                    text: "Assign";
                    primary: true;
                    enabled: root.selected >= -1;
                    clicked => { root.assign(root.selected); }
                }
            }
        }
    }
}
