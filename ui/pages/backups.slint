// Backups page: location and retention rows, the list of backups, and
// the selected backup's diff. Results arrive as toasts.

import { LineEdit } from "std-widgets.slint";
import {
    ActionButton,
    NavRow,
    PageHeader,
    PrefRow,
    SectionHeader,
} from "../widgets.slint";
import { Theme } from "../theme.slint";

export component BackupsPage inherits Rectangle {
    in property <string> backup-note;
    in property <[string]> backups;
    in-out property <int> selected-backup: 0;
    in property <bool> restore-possible: false;
    in property <string> restore-diff;
    in-out property <string> count-text;
    in-out property <string> dir-text;
    callback backup-now();
    callback backup-chosen(int);
    callback restore-backup();
    callback count-chosen(string);
    callback dir-chosen(string);
    callback browse-location();

    VerticalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 28px;
        alignment: start;

        PageHeader {
            title: "Backups";
            description: "Every save snapshots your config first. Restoring backs up the current files too, so a restore can be undone.";

            ActionButton {
                text: "Back up now";
                clicked => { root.backup-now(); }
            }
        }

        // ── where and how many ──────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "Settings";
            }

            VerticalLayout {
                PrefRow {
                    title: "Save backups to";
                    subtitle: "Press Enter to apply a typed path.";

                    LineEdit {
                        width: 260px;
                        text <=> root.dir-text;
                        placeholder-text: "default location";
                        accepted(t) => { root.dir-chosen(t); }
                    }

                    ActionButton {
                        text: "Browse…";
                        clicked => { root.browse-location(); }
                    }
                }

                PrefRow {
                    title: "Keep";
                    subtitle: "Older backups are deleted. Press Enter to apply.";

                    LineEdit {
                        width: 72px;
                        text <=> root.count-text;
                        input-type: number;
                        accepted(t) => { root.count-chosen(t); }
                    }

                    Text {
                        text: "backups";
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── the list ────────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "Your backups";
            }

            Text {
                text: root.backup-note;
                color: Theme.text-2;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }

            VerticalLayout {
                padding-top: Theme.space-xs;

                for backup[idx] in backups: NavRow {
                    label: backup;
                    selected: idx == root.selected-backup;
                    selected-fired => { root.backup-chosen(idx); }
                }

                if backups.length == 0: Text {
                    text: "No backups yet. They appear here after your first save or \"Back up now\".";
                    color: Theme.text-2;
                    wrap: TextWrap.word-wrap;
                }
            }
        }

        // ── restore ─────────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            HorizontalLayout {
                spacing: Theme.space-m;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-xs;

                    SectionHeader {
                        title: "Restore";
                    }

                    Text {
                        text: "The selected backup compared with your files now.";
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    ActionButton {
                        text: "Restore this backup";
                        enabled: root.restore-possible;
                        clicked => { root.restore-backup(); }
                    }
                }
            }

            Rectangle {
                background: Theme.bg-1;
                border-radius: Theme.radius-l;

                VerticalLayout {
                    padding: Theme.space-l;

                    Text {
                        text: root.restore-diff;
                        color: Theme.text-1;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                        wrap: TextWrap.word-wrap;
                    }
                }
            }
        }
    }
}
