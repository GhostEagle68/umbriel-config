// Rule page: one row per rule that opens to its Match fields, then
// its Settings. Every field starts unset — clearing one (or picking
// "(unset)") removes it from the config. Rules living in an include
// show a pointer instead of editors.

import {
    ActionButton,
    ExpandRow,
    PageHeader,
    SettingRowView,
} from "../widgets.slint";
import { RuleCard } from "../types.slint";
import { Theme } from "../theme.slint";

export component RulePage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <[RuleCard]> rule-cards;
    callback add-rule();
    callback remove-rule(int, int);
    callback toggle-rule(int, int);
    callback set-value(string, string);
    callback reset-key(string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int, string);

    VerticalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 28px;
        alignment: start;

        PageHeader {
            title: root.title;
            description: root.description;

            ActionButton {
                text: "Add rule";
                clicked => { root.add-rule(); }
            }
        }

        VerticalLayout {
            for card in root.rule-cards: VerticalLayout {
                ExpandRow {
                    title: card.title;
                    caption: card.file-label != "" ? "in " + card.file-label : "";
                    expanded: card.expanded;
                    toggle => { root.toggle-rule(card.file, card.index); }

                    // Only on the opened rule: a Remove on every line is noise.
                    if card.expanded: ActionButton {
                        text: "Remove";
                        clicked => { root.remove-rule(card.file, card.index); }
                    }
                }

                if card.expanded: VerticalLayout {
                    padding-left: Theme.space-xl;
                    padding-top: Theme.space-s;
                    padding-bottom: Theme.space-m;

                    VerticalLayout {
                        padding-left: Theme.space-s;

                        Text {
                            text: "Match";
                            color: Theme.text-2;
                            font-size: Theme.font-small;
                            font-weight: 600;
                        }
                    }

                    for row in card.match-rows: SettingRowView {
                        setting: row;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i, key) => { root.view-file(i, key); }
                    }

                    VerticalLayout {
                        padding-top: Theme.space-l;
                        padding-left: Theme.space-s;

                        Text {
                            text: "Settings";
                            color: Theme.text-2;
                            font-size: Theme.font-small;
                            font-weight: 600;
                        }
                    }

                    for row in card.setting-rows: SettingRowView {
                        setting: row;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i, key) => { root.view-file(i, key); }
                    }
                }
            }

            if root.rule-cards.length == 0: Text {
                text: "No rules yet. Add one, every field starts unset, and only what you fill in is written.";
                color: Theme.text-2;
                wrap: TextWrap.word-wrap;
            }
        }
    }
}
