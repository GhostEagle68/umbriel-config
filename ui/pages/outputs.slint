// Outputs page: one row per monitor (live-detected first, then
// configured-but-away), the fields underneath, and the add-output card.
// Removing an output deletes its block — the last one stays.

import { LineEdit } from "std-widgets.slint";
import {
    ActionButton,
    ExpandRow,
    PageHeader,
    PrefRow,
    SectionHeader,
    SettingRowView,
} from "../widgets.slint";
import { MonitorCard } from "../types.slint";
import { Theme } from "../theme.slint";

export component OutputsPage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <[MonitorCard]> monitors;
    in property <string> live-note;
    in-out property <string> add-name;
    callback refresh();
    callback add(string);
    callback remove(string);
    callback toggle-monitor(string);
    callback set-value(string, string);
    callback reset-key(string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int, string);

    VerticalLayout {
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 28px;
        alignment: start;

        VerticalLayout {
            spacing: Theme.space-s;

            PageHeader {
                title: root.title;
                description: root.description;

                ActionButton {
                    text: "Refresh";
                    clicked => { root.refresh(); }
                }
            }

            if root.live-note != "": Text {
                text: root.live-note;
                color: Theme.warning;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }
        }

        VerticalLayout {
            for monitor in root.monitors: VerticalLayout {
                ExpandRow {
                    icon: @image-url("../../assets/icons/monitor.svg");
                    has-icon: true;
                    title: monitor.name;
                    caption: monitor.connected ? monitor.info : (monitor.info == "" ? "Not connected" : "Not connected · " + monitor.info);
                    expanded: monitor.expanded;
                    toggle => { root.toggle-monitor(monitor.name); }

                    if monitor.expanded && monitor.configured && monitor.removable: ActionButton {
                        text: "Remove";
                        clicked => { root.remove(monitor.name); }
                    }
                }

                // Indented under the monitor's name.
                if monitor.expanded: VerticalLayout {
                    padding-left: 30px;
                    padding-bottom: Theme.space-m;

                    for row in monitor.rows: SettingRowView {
                        setting: row;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i, key) => { root.view-file(i, key); }
                    }
                }
            }

            if root.monitors.length == 0: Text {
                text: "No outputs connected or configured. Add one below to set its mode, scale, or workspaces, umbriel's defaults apply until then.";
                color: Theme.text-2;
                wrap: TextWrap.word-wrap;
            }
        }

        // ── add output ──────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;

            SectionHeader {
                title: "Add output";
            }

            PrefRow {
                title: "Connector name";
                subtitle: "For a monitor that isn't plugged in right now.";

                LineEdit {
                    width: 220px;
                    text <=> root.add-name;
                    placeholder-text: "e.g. DP-3 or eDP-1";
                    accepted(t) => { root.add(t); }
                }

                ActionButton {
                    text: "Add";
                    clicked => { root.add(root.add-name); }
                }
            }
        }
    }
}
