// Main window shell for the Slint UI. Phase 0: chrome + navigation + a
// read-only content placeholder. Pages replace the placeholder in Phases 1–3;
// everything visual reads tokens from theme.slint.

import { Theme } from "theme.slint";
import { Palette } from "std-widgets.slint";
// Re-export so the generated Rust code exposes the global (set_dark).
export { Theme }
import {
    AboutSlint,
    CheckBox,
    ComboBox,
    LineEdit,
    ScrollView,
    Slider,
} from "std-widgets.slint";

// Embedded fonts (compiler bakes these into the binary). Family names are
// the fonts' internal names, verified with fc-scan.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/JetBrainsMono-Regular.ttf";

export struct SectionRow {
    label: string,
    home-label: string,
    home-section: string,
}
export enum ValueKind { unset, boolean, integer, float, text, list, choice, color, curve }

export  struct SettingRow {
    label: string,
    value: string,
    key: string,
    kind: ValueKind,
    choices: [string],
    swatch: brush,
    checked: bool,
    hint: string,
    min: float,
    max: float,
    // Chain index of the file that owns this key (-1 = not set anywhere).
    home: int,
    home-label: string,
    // Differs from the on-disk saved value.
    changed: bool,
    // True while the key isn't set in any file yet.
    available: bool,
    // Added by an umbriel update or the last schema sync.
    is-new: bool,
    // Live slider feedback for the text box; empty when not dragging.
    preview: string,
}

export struct SettingsCard {
    title: string,
    rows: [SettingRow],
}

// One changed key, as shown in the save popup.
export struct SaveEntry {
    key: string,
    label: string,
    value: string,
    dest-label: string,
    dest-index: int,
}

// One sidebar section entry, with how many of its keys are NEW.
// One sidebar entry: a dimmed header (group caption) or a page row.
// `label` is what's shown; `id` is what navigation keys off.
export struct SectionNav {
    label: string,
    id: string,
    new-count: int,
    is-header: bool,
}

export enum Page { section, search, settings }

// Small token-driven button; std-widgets are avoided until the styled-page
// pass so the whole shell carries one identity from day one.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    width: label.width + 24px;
    border-radius: Theme.radius-s;
    background: !root.enabled ? Theme.bg-2
        : ta.has-hover ? (root.primary ? Theme.accent-hover : Theme.border)
        : (root.primary ? Theme.accent : Theme.bg-2);
    opacity: root.enabled ? 1.0 : 0.5;

    label := Text {
        text: root.text;
        // White only rides on the accent; a disabled primary sits on the
        // neutral card color and must stay readable in both designs.
        color: root.primary && root.enabled ? white : Theme.text-1;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One sidebar navigation row (group header or page). Headers are small-caps
// captions (uppercase label comes from the shell); pages indent under them
// and the selected page carries the accent bar.
component NavRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <int> count: 0;
    in property <bool> header: false;
    callback selected-fired();

    height: root.header ? 22px : 30px;
    border-radius: Theme.radius-s;
    background: root.header ? transparent
        : root.selected ? Theme.accent-soft
        : ta.has-hover ? Theme.bg-2
        : transparent;

    // Selected page: accent bar hugging the row's left edge.
    if root.selected && !root.header: Rectangle {
        x: 0;
        width: 3px;
        border-radius: Theme.radius-s;
        background: Theme.accent;
    }

    Text {
        x: root.header ? Theme.space-m : Theme.space-m + 16px;
        text: root.label;
        color: root.header ? Theme.text-2
            : root.selected ? Theme.text-1
            : Theme.text-2;
        font-size: root.header ? Theme.font-small : Theme.font-body;
        letter-spacing: root.header ? 1px : 0px;
        font-weight: root.header ? 700 : 400;
        vertical-alignment: center;
    }

    if root.count > 0 && !root.header: Text {
        x: parent.width - self.preferred-width - Theme.space-m;
        text: "· " + root.count;
        color: Theme.accent;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: !root.header;
        clicked => { root.selected-fired(); }
    }
}

// A "setting lives in file X" pointer row used by section and search pages.
component PointerRow inherits Rectangle {
    in property <string> label;
    in property <string> home-label;
    callback open();

    height: 32px;
    border-radius: Theme.radius-s;
    background: ta.has-hover ? Theme.bg-2 : transparent;

    ta := TouchArea {
        clicked => { root.open(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;

        Text {
            text: root.label;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "in " + root.home-label + " — open";
            color: Theme.accent;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
}

// LineEdit that commits on Enter or when focus leaves with edits pending.
// `draft` holds the working text so blur can compare against the stored
// value and only commits real changes.
component DraftEdit inherits LineEdit {
    in property <string> value;
    callback commit(string);

    property <string> draft: root.value;
    text <=> draft;
    changed value => { self.draft = self.value; }
    accepted(t) => { root.commit(t); }
    changed has-focus => {
        if (!self.has-focus && self.draft != root.value) {
            root.commit(self.draft);
        }
    }
}

// One settings category page: curated cards of rows, label left /
// editor right, descriptions under the labels.
component CategoryPage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <[SettingsCard]> cards;
    callback set-value(string, string);
    callback reset-key(string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int);

    // Click-away focus: empty page space falls through to the TouchArea,
    // which hands focus to the sink and thereby blurs (committing) any
    // open editor. Declared first so real widgets stay on top.
    sink := FocusScope { }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { sink.focus(); }
    }

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-l;
        alignment: start;

        Text {
            text: root.title;
            color: Theme.text-1;
            font-size: Theme.font-title;
            font-weight: 700;
        }

        if root.description != "": Text {
            text: root.description;
            color: Theme.text-2;
            font-size: Theme.font-small;
        }

        for card in root.cards: VerticalLayout {
            spacing: Theme.space-xs;

            Text {
                text: card.title;
                color: Theme.text-2;
                font-size: Theme.font-small;
                font-weight: 700;
            }

            Rectangle {
                background: Theme.bg-1;
                border-radius: Theme.radius-m;

                VerticalLayout {
                    padding: Theme.space-m;

                    for row in card.rows: VerticalLayout {
                        spacing: 2px;
                        opacity: row.available ? 0.55 : 1.0;

                        HorizontalLayout {
                            min-height: 32px;
                            spacing: Theme.space-m;

                            if row.changed: Rectangle {
                                width: 7px;
                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 4px;
                                        background: Theme.accent;
                                    }
                                }
                            }

                            Text {
                                text: row.label;
                                width: 260px;
                                wrap: TextWrap.word-wrap;
                                vertical-alignment: center;
                            }

                            if row.is-new: Text {
                                text: "NEW";
                                color: Theme.accent;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            if row.kind == ValueKind.boolean: CheckBox {
                                checked: row.checked;
                                toggled => { root.set-value(row.key, self.checked ? "true" : "false"); }
                            }
                            if row.kind == ValueKind.integer || row.kind == ValueKind.float: HorizontalLayout {
                                spacing: Theme.space-s;
                                alignment: start;

                                if row.max > row.min && row.value.to-float() == row.value.to-float(): Slider {
                                    width: 160px;
                                    minimum: row.min;
                                    maximum: row.max;
                                    value: row.value.to-float();
                                    // A drag detaches the slider's value
                                    // from the binding above, so watch the
                                    // row and push resets/external edits
                                    // back into the thumb.
                                    property <string> watched: row.value;
                                    changed watched => {
                                        self.value = row.value.to-float();
                                    }
                                    changed(v) => { root.slider-preview(row.key, v); }
                                    released(v) => { root.set-slider-value(row.key, v); }
                                }

                                DraftEdit {
                                    width: 140px;
                                    value: row.preview == "" ? row.value : row.preview;
                                    commit(t) => { root.set-value(row.key, t); }
                                }

                                if row.changed: ActionButton {
                                    text: "Reset";
                                    clicked => { root.reset-key(row.key); }
                                }
                            }
                            if row.kind == ValueKind.color: HorizontalLayout {
                                spacing: Theme.space-s;
                                alignment: start;

                                Rectangle {
                                    width: 28px;
                                    border-radius: Theme.radius-s;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: row.swatch;
                                }

                                DraftEdit {
                                    width: 140px;
                                    value: row.value;
                                    commit(t) => { root.set-value(row.key, t); }
                                }
                            }
                            if row.kind == ValueKind.curve: ComboBox {
                                width: 180px;
                                model: row.choices;
                                current-value: row.value;
                                selected(v) => { root.set-value(row.key, v); }
                            }
                            if row.kind == ValueKind.list: DraftEdit {
                                width: 220px;
                                value: row.value;
                                commit(t) => { root.set-value(row.key, t); }
                            }
                            if row.kind == ValueKind.text: DraftEdit {
                                width: 220px;
                                value: row.value;
                                commit(t) => { root.set-value(row.key, t); }
                            }
                            if row.kind == ValueKind.choice: ComboBox {
                                width: 180px;
                                model: row.choices;
                                current-value: row.value;
                                selected(v) => { root.set-value(row.key, v); }
                            }
                            if row.kind == ValueKind.unset: Text {
                                text: row.value;
                                color: Theme.text-2;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-s;
                            alignment: start;

                            if row.hint != "": Text {
                                text: row.hint;
                                color: Theme.text-2;
                                font-size: Theme.font-small;
                                opacity: 0.7;
                                vertical-alignment: center;
                            }

                            // Ownership badge: click to view the file that
                            // owns this key (read-only).
                            if row.home >= 0: Rectangle {
                                width: badge-text.preferred-width + 10px;
                                height: badge-text.preferred-height + 4px;
                                border-radius: Theme.radius-s;

                                badge-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.view-file(row.home); }
                                }

                                badge-text := Text {
                                    text: "in " + row.home-label;
                                    color: badge-ta.has-hover ? Theme.accent : Theme.text-2;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Settings page: app updates, the compositor's latest commit, about.
component SettingsPage inherits Rectangle {
    in property <string> app-version;
    in property <bool> check-updates-on-start;
    in property <string> update-note;
    in property <bool> update-available;
    in property <string> upstream-note;
    in property <bool> umbriel-missing;
    in property <bool> dark-mode: true;
    callback check-now();
    callback toggled(bool);
    callback theme-selected(bool);
    callback open-url(string);
    callback relaunch();

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-l;
        alignment: start;

        Text {
            text: "Settings";
            color: Theme.text-1;
            font-size: Theme.font-title;
            font-weight: 700;
        }

        // ── appearance ──────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;
            alignment: start;

            Text {
                text: "Appearance";
                color: Theme.text-1;
                font-size: Theme.font-large;
                font-weight: 700;
            }

            HorizontalLayout {
                spacing: Theme.space-m;

                Text {
                    text: "Theme";
                    color: Theme.text-2;
                    vertical-alignment: center;
                }

                ComboBox {
                    width: 140px;
                    model: ["Dark", "Light"];
                    current-index: root.dark-mode ? 0 : 1;
                    selected => {
                        root.theme-selected(self.current-index == 0);
                    }
                }
            }
        }

        // ── updates ─────────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;
            alignment: start;

            Text {
                text: "Updates";
                color: Theme.text-1;
                font-size: Theme.font-large;
                font-weight: 700;
            }

            CheckBox {
                text: "Check for updates on startup";
                checked: root.check-updates-on-start;
                toggled => { root.toggled(self.checked); }
            }

            HorizontalLayout {
                spacing: Theme.space-m;

                ActionButton {
                    text: "Check for update";
                    clicked => { root.check-now(); }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.update-note == ""
                        ? "Checks against GitHub releases"
                        : root.update-note;
                    color: root.update-available ? Theme.success : Theme.text-2;
                    vertical-alignment: center;
                    wrap: TextWrap.word-wrap;
                }
            }
        }

        // ── Umbriel (the compositor) ────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;
            alignment: start;

            Text {
                text: "Umbriel Latest Commit";
                color: Theme.text-1;
                font-size: Theme.font-large;
                font-weight: 700;
            }

            Text {
                text: root.upstream-note == ""
                    ? "The compositor's latest commit loads while you're here."
                    : root.upstream-note;
                color: Theme.text-2;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }

            ActionButton {
                text: "Open repository";
                clicked => { root.open-url("https://github.com/noctalia-dev/umbriel"); }
            }
        }

        // ── Umbriel detection ───────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;
            alignment: start;

            Text {
                text: "Umbriel";
                color: Theme.text-1;
                font-size: Theme.font-large;
                font-weight: 700;
            }

            Text {
                text: root.umbriel-missing ? "Not detected on this system." : "Detected.";
                color: root.umbriel-missing ? Theme.warning : Theme.success;
                font-size: Theme.font-small;
            }
        }

        // ── guided setup ────────────────────────────────────
        VerticalLayout {
            spacing: Theme.space-s;
            alignment: start;

            Text {
                text: "Guided setup";
                color: Theme.text-1;
                font-size: Theme.font-large;
                font-weight: 700;
            }

            Text {
                text: "Walk through the settings people change most — outputs, layout, input, general, appearance. Values you already set are left alone.";
                color: Theme.text-2;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }

            ActionButton {
                text: "Run guided setup";
                clicked => { root.relaunch(); }
            }

            // ── about ───────────────────────────────────────
            Text {
                text: "About";
                color: Theme.text-1;
                font-size: Theme.font-large;
                font-weight: 700;
            }

            Text {
                text: "umbriel-config v" + root.app-version;
                color: Theme.text-1;
            }

            ActionButton {
                text: "Source & issue tracker";
                clicked => { root.open-url("https://github.com/GhostEagle68/umbriel-config"); }
            }

            // The widget asks for 100% of its parent — pin it to badge
            // size or it swallows the whole page.
            AboutSlint {
                width: 200px;
                height: 100px;
            }
        }
    }
}

export component AppWindow inherits Window {
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 480px;
    title: "Umbriel Config";
    background: Theme.bg-0;
    default-font-family: "Inter";
    default-font-size: Theme.font-body;

    in property <string> config-path;
    in property <int> include-count;
    in property <string> include-note;
    in property <bool> dirty;
    in property <[SectionNav]> sections;
    in property <string> page-title;
    in property <string> page-description;
    in property <string> status;
    in-out property <string> current-section;
    in-out property <bool> show-exit-confirm: false;
    in-out property <Page> page: Page.section;
    in property <[SettingsCard]> cards;
    in property <[SectionRow]> search-rows;
    // Keys whose current value differs from the on-disk snapshot.
    in property <int> changed-count;
    in property <[string]> destinations;
    in-out property <bool> show-save-popup: false;
    in property <[SaveEntry]> save-entries;
    // Validation result of the last save (empty = nothing to report).
    in-out property <string> validate-note;
    in-out property <bool> show-file-popup: false;
    in property <string> popup-file-title;
    in property <string> popup-file-path;
    in property <string> popup-file-text;
    in property <string> file-stats;

    callback search-edited(string);
    callback section-selected(string);
    callback set-value(string, string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int);
    callback save-dest-chosen(string, string);
    callback save-confirmed();
    callback reset-entry(string);
    callback reset-key(string);
    callback discard-all();
    callback save-requested();
    callback sync-schema-requested();
    callback exit-requested();

    // Settings page
    in property <string> app-version;
    in-out property <bool> check-updates-on-start: true;
    in-out property <bool> dark-mode: true;
    // Standard widgets (LineEdit, CheckBox, ComboBox, AboutSlint) follow
    // Slint's builtin palette, not our tokens — keep it in step.
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    in property <string> update-note;
    in property <bool> update-available: false;
    in property <string> upstream-note;
    callback settings-requested();
    callback check-updates-requested();
    callback check-updates-toggled(bool);
    callback theme-selected(bool);
    callback open-url(string);

    // First-run onboarding (plain install) + missing-umbriel banner.
    in-out property <bool> show-onboarding: false;
    in-out property <bool> umbriel-missing: false;
    // No schema source (umbriel not detected): the section page becomes
    // an empty-state pointer instead of a blank page.
    in property <bool> schema-empty: false;
    callback onboarding-create();

    // Guided setup after create (schema present): one card per section,
    // suggested defaults filled in and editable.
    in-out property <bool> show-guide: false;
    in property <string> guide-title;
    in property <bool> guide-first: false;
    in property <bool> guide-last: false;
    callback guide-back();
    callback guide-next();
    callback guide-relaunch();

    VerticalLayout {
        // ── header ─────────────────────────────────────────────
        Rectangle {
            height: 44px;
            background: Theme.bg-1;

            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                spacing: Theme.space-m;
                alignment: start;

                Text {
                    text: "Umbriel Config";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.config-path;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }

                Text {
                    text: "+" + root.include-count + " included";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    visible: root.include-count > 0;
                }

                LineEdit {
                    width: 200px;
                    placeholder-text: "Search Settings";
                    edited(t) => { root.search-edited(t); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                ActionButton {
                    text: "Sync schema";
                    clicked => { root.sync-schema-requested(); }
                }

                ActionButton {
                    text: "Save" + (root.changed-count > 0 ? " · " + root.changed-count : "");
                    primary: true;
                    enabled: root.dirty;
                    clicked => { root.save-requested(); }
                }
            }
        }

        // include warning strip (only when notes exist)
        if root.include-note != "": Rectangle {
            height: 24px;
            background: Theme.bg-1;
            Text {
                x: Theme.space-l;
                text: "⚠ " + root.include-note;
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        // validation result of the last save (errors and warnings)
        if root.validate-note != "": Rectangle {
            height: 24px;
            background: Theme.bg-1;
            Text {
                x: Theme.space-l;
                text: "⚠ " + root.validate-note;
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        // quiet banner: umbriel missing but a config exists
        if root.umbriel-missing: Rectangle {
            height: 24px;
            background: Theme.bg-1;

            banner-ta := TouchArea {
                clicked => { root.umbriel-missing = false; }
            }

            Text {
                x: Theme.space-l;
                text: "Umbriel not detected, validation unavailable · click to dismiss";
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            // ── sidebar ─────────────────────────────────────────
                        Rectangle {
                width: 208px;
                background: Theme.bg-1;

                VerticalLayout {
                    spacing: Theme.space-xs;

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: Theme.space-s;
                            spacing: Theme.space-xs;
                            alignment: start;

                            Text {
                                text: "Settings";
                                color: Theme.text-1;
                                font-size: Theme.font-large;
                                font-weight: 700;
                            }

                            for section in root.sections: NavRow {
                                label: section.label;
                                count: section.new-count;
                                header: section.is-header;
                                selected: !section.is-header
                                    && root.page == Page.section
                                    && section.id == root.current-section;
                                selected-fired => { root.section-selected(section.id); }
                            }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        padding: Theme.space-s;
                        spacing: Theme.space-xs;

                        NavRow {
                            label: "Settings" + (root.update-available ? " •" : "");
                            selected: root.page == Page.settings;
                            selected-fired => { root.settings-requested(); }
                        }

                        ActionButton {
                            text: "Exit";
                            clicked => {
                                if (root.dirty) {
                                    root.show-exit-confirm = true;
                                } else {
                                    root.exit-requested();
                                }
                            }
                        }
                    }
                }
            }

            // ── content ─────────────────────────────────────────
            Rectangle {
                background: Theme.bg-0;

                if root.page == Page.section && !root.schema-empty: svs := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: section-page.preferred-height;

                    // Full content width; the page's own layout padding
                    // insets the cards. Width depends only on the
                    // ScrollView's visible width, so no intrinsic-size
                    // feedback cycles.
                    section-page := CategoryPage {
                        width: svs.visible-width;
                        title: root.page-title;
                        description: root.page-description;
                        cards: root.cards;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i) => { root.view-file(i); }
                    }
                }

                if root.page == Page.search: ScrollView {
                    VerticalLayout {
                        padding: Theme.space-l;
                        spacing: Theme.space-m;
                        alignment: start;
                        Text {
                            text: root.page-title;
                            color: Theme.text-1;
                            font-size: Theme.font-title;
                            font-weight: 700;
                        }

                        for row in root.search-rows: PointerRow {
                            label: row.label;
                            home-label: row.home-label;
                            open => { root.section-selected(row.home-section); }
                        }
                        if root.search-rows.length == 0: Text {
                            text: "No matches.";
                            color: Theme.text-2;
                        }
                    }
                }
                if root.page == Page.settings: stv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: settings-page.preferred-height;

                    settings-page := SettingsPage {
                        width: stv.visible-width;
                        app-version: root.app-version;
                        umbriel-missing: root.umbriel-missing;
                        check-updates-on-start: root.check-updates-on-start;
                        dark-mode: root.dark-mode;
                        update-note: root.update-note;
                        update-available: root.update-available;
                        upstream-note: root.upstream-note;
                        check-now => { root.check-updates-requested(); }
                        toggled(v) => { root.check-updates-toggled(v); }
                        theme-selected(d) => { root.theme-selected(d); }
                        open-url(u) => { root.open-url(u); }
                        relaunch => { root.guide-relaunch(); }
                    }
                }

                // No schema source: an honest empty state instead of a
                // blank page (plain install after create / continue).
                if root.page == Page.section && root.schema-empty: Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-m;
                        padding: Theme.space-xl;

                        Text {
                            text: "No settings to show";
                            color: Theme.text-1;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Umbriel isn't detected, so there are no setting pages. The packaged default config is the schema source.";
                            color: Theme.text-2;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Your config: " + root.config-path;
                            color: Theme.text-2;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        if root.status != "": Text {
                            text: root.status;
                            color: Theme.success;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Install umbriel, then click \"Sync schema\". Its settings will appear here.";
                            color: Theme.text-2;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: center;

                            ActionButton {
                                text: "Install docs";
                                clicked => { root.open-url("https://docs.noctalia.dev/umbriel/"); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── first-run onboarding (plain install state) ──────────
    if root.show-onboarding: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        Rectangle {
            width: min(parent.width - 96px, 520px);
            height: min(parent.height - 96px, 440px);
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-m;
                alignment: start;

                Text {
                    text: "Welcome to Umbriel Config";
                    color: Theme.text-1;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }

                Text {
                    text: root.umbriel-missing
                        ? "Umbriel wasn't detected on this system or no config file exists."
                        : "No config file exists yet, create one to be guided on setting the frequently used settings.";
                    color: Theme.text-1;
                    wrap: TextWrap.word-wrap;
                }

                Text {
                    text: "Right now you can create and edit config.toml, change values, and use include files.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                }

                Text {
                    text: "Without umbriel there are no schema-driven setting pages (the packaged default is the schema source), no defaults shown, and validation is unavailable.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                    visible: root.umbriel-missing;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Install docs";
                        visible: root.umbriel-missing;
                        clicked => { root.open-url("https://docs.noctalia.dev/umbriel/"); }
                    }

                    ActionButton {
                        text: "Continue anyway";
                        clicked => { root.show-onboarding = false; }
                    }

                    ActionButton {
                        text: "Create config.toml";
                        primary: true;
                        clicked => { root.onboarding-create(); }
                    }
                }
            }
        }
    }

    // ── guided setup (after create, schema present) ─────────
    if root.show-guide: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        Rectangle {
            width: min(parent.width - 128px, 760px);
            height: min(parent.height - 96px, 560px);
            border-radius: Theme.radius-l;
            background: Theme.bg-0;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: root.guide-title;
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Suggested defaults are filled in, change anything you like. A value you leave alone is saved as the suggested default.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                }

                gsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: guide-page.preferred-height;

                    guide-page := CategoryPage {
                        width: gsv.visible-width;
                        title: "";
                        description: "";
                        cards: root.cards;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i) => { root.view-file(i); }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Back";
                        enabled: !root.guide-first;
                        clicked => { root.guide-back(); }
                    }

                    ActionButton {
                        text: root.guide-last ? "Finish and save" : "Next";
                        primary: true;
                        clicked => { root.guide-next(); }
                    }
                }
            }
        }
    }

    // ── save popup: per-key destinations + confirm ──────────
    if root.show-save-popup: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        // Scrim click cancels; the card absorbs its own clicks.
        TouchArea {
            clicked => { root.show-save-popup = false; }
        }

        Rectangle {
            width: min(parent.width - 96px, 640px);
            height: min(parent.height - 96px, 480px);
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: "Save changes";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Pick where each changed setting should live, or reset it.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                }

                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;

                        for entry in root.save-entries: HorizontalLayout {
                            spacing: Theme.space-m;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                Text {
                                    text: entry.label;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: entry.value;
                                    color: Theme.text-2;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                            }

                            ComboBox {
                                width: 200px;
                                model: root.destinations;
                                current-index: entry.dest-index;
                                selected(v) => { root.save-dest-chosen(entry.key, v); }
                            }

                            ActionButton {
                                text: "Reset";
                                clicked => { root.reset-entry(entry.key); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Discard all";
                        clicked => { root.discard-all(); }
                    }

                    ActionButton {
                        text: "Cancel";
                        clicked => { root.show-save-popup = false; }
                    }

                    ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => { root.save-confirmed(); }
                    }
                }
            }
        }
    }

    // ── unsaved-changes confirm overlay ──────────────────────
    if root.show-exit-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        Rectangle {
            width: 340px;
            height: 150px;
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: "Unsaved changes";
                    color: Theme.danger;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Quit without saving?";
                    color: Theme.text-2;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;
                    ActionButton {
                        text: "Keep editing";
                        clicked => { root.show-exit-confirm = false; }
                    }

                    ActionButton {
                        text: "Quit anyway";
                        primary: true;
                        clicked => { root.exit-requested(); }
                    }
                }
            }
        }
    }

    // ── read-only file view popup (opened from a row's "in <file>" badge) ──
    if root.show-file-popup: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        // Clicking the scrim closes the popup…
        TouchArea {
            clicked => { root.show-file-popup = false; }
        }

        Rectangle {
            width: min(parent.width - 96px, 760px);
            height: parent.height - 96px;
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            // …the card absorbs its own clicks so it stays open.
            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                HorizontalLayout {
                    spacing: Theme.space-m;

                    VerticalLayout {
                        spacing: 2px;

                        Text {
                            text: root.popup-file-title;
                            color: Theme.text-1;
                            font-size: Theme.font-large;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.popup-file-path;
                            color: Theme.text-2;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.file-stats;
                            color: Theme.text-2;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            visible: root.file-stats != "";
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: "Close";
                        clicked => { root.show-file-popup = false; }
                    }
                }

                ScrollView {
                    width: 100%;
                    height: 100%;
                    // Non-layout child: the viewport must be pinned to the
                    // content's natural size or nothing ever scrolls.
                    viewport-width: file-text.preferred-width;
                    viewport-height: file-text.preferred-height;

                    file-text := Text {
                        text: root.popup-file-text;
                        color: Theme.text-1;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                        wrap: no-wrap;
                        width: self.preferred-width;
                        height: self.preferred-height;
                    }
                }
            }
        }
    }
}
