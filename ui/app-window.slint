// Main window shell for the Slint UI. Phase 0: chrome + navigation + a
// read-only content placeholder. Pages replace the placeholder in Phases 1–3;
// everything visual reads tokens from theme.slint.

import { Theme } from "theme.slint";
import {CheckBox, ComboBox, LineEdit, ScrollView} from "std-widgets.slint";

// Embedded fonts (compiler bakes these into the binary). Family names are
// the fonts' internal names, verified with fc-scan.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/JetBrainsMono-Regular.ttf";

export struct SectionRow {
    label: string,
    home-label:string,
    home-index: int,
}

export enum ValueKind {unset,boolean,integer,float,text,list,choice,color,curve}

export  struct FileRow {
    label: string,
    value: string,
    key: string,
    kind: ValueKind,
    choices: [string],
    swatch: brush,
    checked: bool,
    hint: string,
}

export struct FileGroup {
    title: string,
    rows: [FileRow],
}

export enum Page {section,file,search,raw}

// Small token-driven button; std-widgets are avoided until the styled-page
// pass so the whole shell carries one identity from day one.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    width: label.width + 24px;
    border-radius: Theme.radius-s;
    background: !root.enabled ? Theme.bg-2
        : ta.has-hover ? (root.primary ? Theme.accent-hover : Theme.border)
        : (root.primary ? Theme.accent : Theme.bg-2);
    opacity: root.enabled ? 1.0 : 0.5;

    label := Text {
        text: root.text;
        color: root.primary ? white : Theme.text-1;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One sidebar navigation row (section or file).
component NavRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback selected-fired();

    height: 30px;
    border-radius: Theme.radius-s;
    background: root.selected ? Theme.bg-2
        : ta.has-hover ? Theme.bg-2
        : transparent;

    Text {
        x: Theme.space-m;
        text: root.label;
        color: root.selected ? Theme.text-1 : Theme.text-2;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.selected-fired(); }
    }
}

// A "setting lives in file X" pointer row used by section and search pages.
component PointerRow inherits Rectangle {
    in property <string> label;
    in property <string> home-label;
    callback open();

    height: 32px;
    border-radius: Theme.radius-s;
    background: ta.has-hover ? Theme.bg-2 : transparent;

    ta := TouchArea {
        clicked => { root.open(); }
    }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;

        Text {
            text: root.label;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: "in " + root.home-label + " — open";
            color: Theme.accent;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
}

// One file page: schema groups + everything the file holds beyond the schema.
component FilePage inherits Rectangle {
    in property <string> title;
    in property <[FileGroup]> groups;
    in property <[FileRow]> others;
    callback set-value(string, string);

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;
        alignment: start;

        Text {
            text: root.title;
            color: Theme.text-1;
            font-size: Theme.font-title;
            font-weight: 700;
        }

        for group in root.groups: VerticalLayout {
            spacing: Theme.space-xs;
            alignment: start;

            Text {
                text: group.title;
                color: Theme.accent;
                font-size: Theme.font-small;
                font-weight: 700;
            }
                for row in group.rows: HorizontalLayout {
                height: 28px;
                spacing: Theme.space-m;

                Text {
                    text: row.label;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if row.kind == ValueKind.boolean: CheckBox {
                    checked: row.checked;
                    toggled => { root.set-value(row.key, self.checked ? "true" : "false"); }
                }
                if row.kind == ValueKind.integer || row.kind == ValueKind.float: LineEdit {
                    width: 140px;
                    text: row.value;
                    accepted(t) => { root.set-value(row.key, t); }
                }
                if row.kind == ValueKind.color: HorizontalLayout {
                    spacing: Theme.space-s;
                    alignment: start;

                    Rectangle {
                        width: 28px;
                        border-radius: Theme.radius-s;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: row.swatch;
                    }
                    LineEdit {
                        width: 140px;
                        text: row.value;
                        accepted(t) => { root.set-value(row.key, t); }
                    }
                }
                if row.kind == ValueKind.curve: ComboBox {
                    width: 180px;
                    model: row.choices;
                    current-value: row.value;
                    selected(v) => { root.set-value(row.key, v); }
                }
                if row.kind == ValueKind.list: LineEdit {
                    width: 220px;
                    text: row.value;
                    accepted(t) => { root.set-value(row.key, t); }
                }
                if row.kind == ValueKind.text: LineEdit {
                    width: 220px;
                    text: row.value;
                    accepted(t) => { root.set-value(row.key, t); }
                }
                if row.kind == ValueKind.choice: ComboBox {
                    width: 180px;
                    model: row.choices;
                    current-value: row.value;
                    selected(v) => { root.set-value(row.key, v); }
                }
                if row.kind == ValueKind.unset: Text {
                    text: row.value;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                if row.hint != "": Text {
                    text: row.hint;
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    opacity: 0.7;
                    vertical-alignment: center;
                }
            }
        }
        if root.others.length > 0: VerticalLayout {
            spacing: Theme.space-xs;
            alignment: start;

            Text {
                text: "OTHER KEYS IN THIS FILE";
                color: Theme.text-2;
                font-size: Theme.font-small;
                font-weight: 700;
            }
            for row in root.others: HorizontalLayout {
                height: 28px;
                spacing: Theme.space-m;

                Text {
                    text: row.label;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: row.value;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

export component AppWindow inherits Window {
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 480px;
    title: "Umbriel Config";
    background: Theme.bg-0;
    default-font-family: "Inter";
    default-font-size: Theme.font-body;

    in property <string> config-path;
    in property <int> include-count;
    in property <string> include-note;
    in property <bool> dirty;
    in property <[string]> sections;
    in property <[string]> files;
    in property <string> page-title;
    in property <string> status;
    in-out property <string> current-section;
    in-out property <bool> show-exit-confirm: false;
    in-out property <Page> page: Page.section;
    in-out property <int> current-file: -1;
    in property <[SectionRow]> section-rows;
    in property <[string]> available-rows;
    in property <[FileGroup]> file-groups;
    in property <[FileRow]> other-rows;
    in property <[SectionRow]> search-rows;
    in property <[FileGroup]> raw-groups;
    // Never filled; keeps FilePage's Other-keys section empty on other pages.
    in property <[FileRow]> no-rows;

    callback search-edited(string);
    callback raw-requested();
    callback section-selected(string);
    callback open-file(int);
    callback set-value(string, string);
    callback save-requested();
    callback sync-schema-requested();
    callback exit-requested();

    VerticalLayout {
        // ── header ─────────────────────────────────────────────
        Rectangle {
            height: 44px;
            background: Theme.bg-1;

            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                spacing: Theme.space-m;
                alignment: start;

                Text {
                    text: "Umbriel Config";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.config-path;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                Text {
                    text: "+" + root.include-count + " included";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    visible: root.include-count > 0;
                }
                LineEdit {
                    width: 200px;
                    placeholder-text: "Search Settings";
                    edited(t) => {root.search-edited(t);}
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    text: "Sync schema";
                    clicked => { root.sync-schema-requested(); }
                }
                ActionButton {
                    text: "Save";
                    primary: true;
                    enabled: root.dirty;
                    clicked => { root.save-requested(); }
                }
            }
        }

        // include warning strip (only when notes exist)
        if root.include-note != "": Rectangle {
            height: 24px;
            background: Theme.bg-1;
            Text {
                x: Theme.space-l;
                text: "⚠ " + root.include-note;
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            // ── sidebar ─────────────────────────────────────────
            Rectangle {
                width: 208px;
                background: Theme.bg-1;

                VerticalLayout {
                    padding: Theme.space-s;
                    spacing: Theme.space-xs;
                    alignment: start;

                    Text {
                        text: "SECTIONS";
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                    }
                    for section in root.sections: NavRow {
                        label: section;
                        selected: section == root.current-section;
                        selected-fired => { root.section-selected(section); }
                    }

                    Rectangle { height: Theme.space-l; }
                    Text {
                        text: "FILES";
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                    }
                    for file[i] in root.files: NavRow {
                        label: file;
                        selected-fired => { root.open-file(i); }
                    }

                    Rectangle { vertical-stretch: 1; }
                    NavRow {
                        label: "Other Settings";
                        selected-fired => {root.raw-requested();}
                    }
                    ActionButton {
                        text: "Exit";
                        clicked => {
                            if (root.dirty) {
                                root.show-exit-confirm = true;
                            } else {
                                root.exit-requested();
                            }
                        }
                    }
                }
            }

            // ── content ─────────────────────────────────────────
            Rectangle {
                background: Theme.bg-0;

                if root.page == Page.section: VerticalLayout {
                    padding: Theme.space-l;
                    spacing: Theme.space-m;
                    alignment: start;

                    Text {
                        text: root.page-title;
                        color: Theme.text-1;
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }
                    Text {
                        text: root.status;
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                    }
                    Text {
                        text: "IN USE";
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                    }
                                            for row in root.section-rows: PointerRow {
                            label: row.label;
                            home-label: row.home-label;
                            open => { root.open-file(row.home-index); }
                        }
                    Text {
                        text: "AVAILABLE";
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                        visible: root.available-rows.length > 0;
                    }
                    for label in root.available-rows: Text {
                        text: label;
                        color: Theme.text-2;
                    }
                }

                if root.page == Page.file: ScrollView {
                    FilePage {
                        title: root.page-title;
                        groups: root.file-groups;
                        others: root.other-rows;
                        set-value(k, v) => { root.set-value(k, v); }

                    }
                }
                
                if root.page == Page.search: ScrollView {
                        VerticalLayout {
                            padding: Theme.space-l;
                            spacing: Theme.space-m;
                            alignment: start;
                            Text {
                                text: root.page-title;
                                color: Theme.text-1;
                                font-size: Theme.font-title;
                                font-weight: 700;
                            }
                            for row in root.search-rows: PointerRow {
                                label: row.label;
                                home-label: row.home-label;
                                open => { root.open-file(row.home-index); }
                            }
                            if root.search-rows.length == 0: Text {
                                text: "No matches.";
                                color: Theme.text-2;
                            }
                        }
                    }
                    if root.page == Page.raw: ScrollView {
                        FilePage {
                            title: "Other settings";
                            groups: root.raw-groups;
                            others: root.no-rows;
                        }
                    }
            }
        }
    }

    // ── unsaved-changes confirm overlay ──────────────────────
    if root.show-exit-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        Rectangle {
            width: 340px;
            height: 150px;
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: "Unsaved changes";
                    color: Theme.danger;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }
                Text {
                    text: "Quit without saving?";
                    color: Theme.text-2;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;
                    ActionButton {
                        text: "Keep editing";
                        clicked => { root.show-exit-confirm = false; }
                    }
                    ActionButton {
                        text: "Quit anyway";
                        primary: true;
                        clicked => { root.exit-requested(); }
                    }
                }
            }
        }
    }
}
