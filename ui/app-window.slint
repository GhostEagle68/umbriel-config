// Main window shell: header, sidebar, page frame, and the app-level
// overlays (onboarding, guide, save popup, exit confirm, what's-new,
// file view, shader editor). Pages live in ui/pages/, shared widgets in
// ui/widgets.slint, shared structs in ui/types.slint; everything visual
// reads tokens from theme.slint.

import { Theme } from "theme.slint";
import { Palette } from "std-widgets.slint";
// Re-export so the generated Rust code exposes the global (set_dark).
export {
    Theme,
}
// Re-exported for the Rust side too: rows.rs installs the ColorMath
// handlers that the picker popup's bindings call; page_keybinds.rs drives
// the Keybinds page through KeybindsState.
export { ColorMath, KeybindsState }
import {
    CheckBox,
    ComboBox,
    LineEdit,
    ScrollView,
    TextEdit,
} from "std-widgets.slint";

import {
    ActionButton,
    ColorPickerCard,
    NavRow,
    PointerRow,
    ReleaseNotes,
} from "widgets.slint";
import {
    ColorMath,
    MonitorCard,
    NotesCard,
    PickerState,
    RuleCard,
    SaveEntry,
    SectionNav,
    SectionRow,
    SettingsCard,
    CodeEdit,
    DeskMonitor,
    DeskStyle,
    HomeLink,
    ShaderAssignment,
    KindCount,
    ShaderInfo,
    ShaderStep,
    ShaderUse,
    Toast,
    ToastKind,
    CodeLine,
} from "types.slint";
import { CategoryPage } from "pages/category.slint";
import { HomePage } from "pages/home.slint";
import { FileViewer } from "pages/file-viewer.slint";
import { SettingsPage } from "pages/settings.slint";
import { BackupsPage } from "pages/backups.slint";
import { KeybindsPage, KeybindsState } from "pages/keybinds.slint";
import { OutputsPage } from "pages/outputs.slint";
import { RulePage } from "pages/rules.slint";
import { ShaderEditorPage } from "pages/shader-editor.slint";
import { ShaderPicker, ShadersPage } from "pages/shaders.slint";

// Embedded fonts (compiler bakes these into the binary). Family names are
// the fonts' internal names, verified with fc-scan.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/JetBrainsMono-Regular.ttf";

export enum Page { home, section, search, settings, backups, keybinds, outputs, rules, shaders }

export component AppWindow inherits Window {
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 480px;
    title: "Umbriel Config";
    background: Theme.bg-0;
    default-font-family: "Inter";
    default-font-size: Theme.font-body;

    in property <string> config-path;
    in property <[string]> include-files;
    in property <string> sync-note;
    in property <bool> sync-clean: true;
    in property <bool> dirty;
    in property <[SectionNav]> sections;
    in property <string> page-title;
    in property <string> page-description;
    in-out property <string> current-section;
    in-out property <bool> show-exit-confirm: false;
    in-out property <Page> page: Page.home;
    in property <[SettingsCard]> cards;
    in property <[SectionRow]> search-rows;
    // Keys whose current value differs from the on-disk snapshot.
    in property <int> changed-count;
    in property <[string]> destinations;
    in-out property <bool> show-save-popup: false;
    in property <[SaveEntry]> save-entries;
    // Bottom-right notes (common::toast) and the one blocking alert
    // (common::alert); an empty title hides the alert.
    in property <[Toast]> toasts;
    callback toast-action(int, string);
    callback toast-closed(int);
    in-out property <string> alert-title;
    in property <string> alert-body;
    in-out property <bool> show-file-popup: false;
    in property <string> popup-file-title;
    in property <string> popup-file-path;
    in property <[CodeLine]> popup-file-lines;
    // The line that sets the viewed setting; -1 for none.
    in property <int> popup-focus-line: -1;
    in property <string> file-stats;
    // Home page models, filled by page_home.rs.
    in property <[HomeLink]> home-changes;
    in property <[HomeLink]> home-new-settings;
    in property <[DeskMonitor]> home-monitors;
    in property <DeskStyle> home-desk-style;
    callback home-requested();
    // Shaders page tab (0 Assignments, 1 Library), kept across rebuilds.
    in-out property <int> shader-tab: 0;
    // The sidebar group of the page on show, for the top bar's icon.
    in property <string> page-group;
    pure function group-icon(group: string) -> image {
        if group == "outputs" {
            return @image-url("../assets/icons/monitor.svg");
        }
        if group == "desktop" {
            return @image-url("../assets/icons/desktop.svg");
        }
        if group == "windows" {
            return @image-url("../assets/icons/windows.svg");
        }
        if group == "look" {
            return @image-url("../assets/icons/look.svg");
        }
        if group == "input" {
            return @image-url("../assets/icons/input.svg");
        }
        if group == "system" {
            return @image-url("../assets/icons/system.svg");
        }
        return @image-url("../assets/icons/more.svg");
    }

    callback search-edited(string);
    // Home: clear every New pill and count.
    callback mark-all-seen();
    callback section-selected(string);
    // Open the keybinds page with its filter pre-filled.
    callback keybinds-search-requested(string);
    callback set-value(string, string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int, string);
    callback save-dest-chosen(string, string);
    callback save-confirmed();
    callback reset-entry(string);
    callback reset-key(string);
    callback discard-all();
    callback save-requested();
    callback sync-schema-requested();
    // A docs download finished; the text is its error, empty on success.
    callback schema-source-updated(string);
    callback exit-requested();
    callback outputs-refresh();
    callback output-add(string);
    callback output-remove(string);
    callback rule-add();
    callback rule-remove(int, int);
    callback toggle-card(string);
    callback toggle-monitor(string);
    callback toggle-rule(int, int);
    callback shaders-download();
    // Assign a shader: (key, 0 for none or library index + 1).
    callback shader-assign(string, int);
    callback shader-fix-include();
    callback shader-convert-legacy();
    // What's new / changelog overlay.
    in-out property <bool> show-whatsnew;
    in property <string> whatsnew-title;
    in property <[NotesCard]> whatsnew-cards;
    // true while it shows every release: hides "Show full changelog".
    in property <bool> whatsnew-full;
    // A canary build's commits since the last release, linked from the
    // changelog; empty for other builds.
    in property <string> whatsnew-canary-url;
    // One-time notice above the notes; empty once it has been read.
    in-out property <string> whatsnew-notice;
    callback view-changelog();
    callback view-update-notes();

    in property <[MonitorCard]> monitors;
    in property <string> outputs-live-note;
    in-out property <string> outputs-add-name;
    in property <[RuleCard]> rule-cards;
    in property <[ShaderInfo]> shaders;
    // How many shaders are yours, and the rest, for the grid.
    in property <[KindCount]> shader-kind-counts;
    in property <int> shader-own-count;
    in property <int> shader-other-count;
    // Library and picker view, remembered in the app's settings.
    in-out property <bool> shader-grid: true;
    in-out property <bool> shader-hover-preview: true;
    callback shader-view-changed();
    // Draw thumbnails for library shaders that don't have one yet.
    callback shader-thumbs-wanted();
    // Play library shader (index) in the live preview as event (index).
    callback shader-preview-file(int, int);
    // The shader picker: for an assignment key, or "" to just look.
    in-out property <bool> shader-picker-open;
    in-out property <string> shader-picker-key;
    in-out property <int> shader-picker-kind: -1;
    in-out property <string> shader-picker-title;
    in-out property <int> shader-picker-selected;
    in property <[ShaderAssignment]> shader-assignments;
    in property <string> shader-download-note;
    in property <bool> shader-include-missing;
    in property <string> shader-legacy-note;
    in property <bool> shader-community-installed;
    in property <bool> shader-update-available;
    in-out property <bool> shader-downloading;
    // Shader editor page.
    in-out property <bool> shader-editor-open;
    in property <bool> shader-editor-editing;
    // Events assigned the shader being edited, for the delete confirm.
    in property <string> shader-editor-used-by;
    in-out property <string> shader-editor-name;
    in-out property <string> shader-editor-text;
    in property <string> shader-editor-note;
    in property <[ShaderStep]> shader-steps;
    // The code pane isn't builder output (hand-edited or foreign), so
    // the builder is read-only until reset.
    in property <bool> shader-builder-locked;
    in property <[string]> shader-step-kinds;
    // The kinds a shader can be, and the one the code's entry point
    // names (an index into them); picking one starts a fresh shader of it.
    in property <[string]> shader-kinds;
    in-out property <int> shader-editor-kind;
    callback shader-editor-kind-picked(int);
    callback shader-editor-new();
    callback shader-editor-edit(string);
    callback shader-editor-fork(string, string);
    // Save asks which events use the shader first: request fills the
    // checklist and opens it, save does the work.
    callback shader-editor-save-request();
    // true: apply the "Use for" ticks; false: save the file only.
    callback shader-editor-save(bool);
    in-out property <[ShaderUse]> shader-use-for;
    in-out property <bool> shader-use-open;
    callback shader-editor-delete();
    // Delete a library card's own shader by path.
    callback shader-delete-file(string);
    // Close request; with unsaved code Rust raises confirm-close instead.
    callback shader-editor-close();
    in-out property <bool> shader-editor-confirm-close;
    // (text, anchor, cursor, kind); see ShaderCodeEditor.edited.
    callback shader-editor-text-changed(string, int, int, int);
    callback shader-code-history(string) -> CodeEdit;
    // Editor keys (Tab/Shift+Tab/Enter) done in Rust; see ShaderCodeEditor.
    callback shader-code-key(string, int, int, string) -> CodeEdit;
    pure callback shader-code-layer(string, int) -> string;
    callback shader-step-add(string);
    callback shader-builder-reset();
    callback shader-step-remove(int);
    callback shader-step-move(int, int);
    callback shader-step-param(int, int, float);
    callback shader-step-param-live(int, int, float);
    // Preview scrubber for the editor.
    in property <image> shader-preview-image;
    in-out property <float> shader-preview-progress: 0;
    in-out property <float> shader-preview-direction: 1;
    in property <bool> shader-preview-ready;
    in property <string> shader-preview-note;
    callback shader-preview-scrub(float);
    // "Preview as": the events (labels, umbriel order), the chosen one,
    // and how long that event runs as configured.
    in property <[string]> shader-preview-events;
    in-out property <int> shader-preview-event;
    in property <int> shader-preview-length-ms: 250;
    callback shader-preview-event-picked(int);
    callback shader-preview-direction-toggled();

    // Backups page
    in property <[string]> backup-choices;
    in-out property <int> backup-selected: 0;
    in property <bool> restore-possible: false;
    in property <string> restore-diff;
    in property <string> backup-note;
    in-out property <string> backup-count-text;
    in-out property <string> backup-dir-text;
    callback backups-requested();
    callback backup-now();
    callback backup-chosen(int);
    callback restore-backup();
    callback backup-count-chosen(string);
    callback backup-dir-chosen(string);
    callback browse-location();

    // Settings page
    in property <string> app-version;
    in-out property <bool> check-updates-on-start: true;
    // Index into Channel::ALL: 0 Stable, 1 Canary.
    in-out property <int> update-channel: 1;
    in-out property <bool> canary-auto-install: false;
    callback canary-auto-install-toggled(bool);
    in-out property <bool> dark-mode: true;
    // Standard widgets (LineEdit, Switch, ComboBox, AboutSlint) follow
    // Slint's builtin palette, not our tokens — keep it in step.
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    in property <string> update-note;
    in property <bool> update-available: false;
    in property <string> update-notes;
    // Tarball installs replace themselves; the rest show update-hint.
    in property <bool> update-can-install: false;
    in property <string> update-hint;
    in-out property <string> update-version;
    in-out property <bool> update-installed: false;
    in property <string> upstream-note;
    callback settings-requested();
    callback check-updates-requested();
    callback check-updates-toggled(bool);
    callback update-channel-selected(int);
    callback install-update();
    callback restart-app();
    callback theme-selected(bool);
    callback open-url(string);

    // First-run onboarding (plain install); umbriel missing also dims
    // what needs it.
    in-out property <bool> show-onboarding: false;
    in-out property <bool> umbriel-missing: false;
    // No settings could be read from umbriel's docs: the section page
    // becomes an empty-state pointer instead of a blank page.
    in property <bool> schema-empty: false;
    callback onboarding-create();

    // Guided setup after create (schema present): one card per section,
    // suggested defaults filled in and editable.
    in-out property <bool> show-guide: false;
    in property <string> guide-title;
    in property <bool> guide-first: false;
    in property <bool> guide-last: false;
    // Off on first run: the config was just created, nothing to return to.
    in property <bool> guide-cancellable: false;
    callback guide-back();
    callback guide-cancel();
    callback guide-next();
    callback guide-relaunch();

    HorizontalLayout {
        // ── sidebar ─────────────────────────────────────────────
        Rectangle {
            width: 248px;
            background: Theme.bg-0;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.divider;
            }

            VerticalLayout {
                padding: Theme.space-m;
                padding-right: Theme.space-m + 1px;
                spacing: Theme.space-xs;

                // Brand
                HorizontalLayout {
                    height: 44px;
                    padding-left: 10px;
                    spacing: 10px;

                    Image {
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../assets/umbriel-config.svg");
                    }

                    Text {
                        text: "Umbriel Config";
                        color: Theme.text-1;
                        font-size: Theme.font-large;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Search lives in the sidebar, above what it searches.
                Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-m;
                    background: Theme.bg-1;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.border : Theme.divider;

                    Image {
                        x: 10px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../assets/icons/search.svg");
                        colorize: Theme.text-2;
                    }

                    search-input := TextInput {
                        x: 34px;
                        width: parent.width - 44px;
                        color: Theme.text-1;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.search-edited(self.text); }
                    }

                    if search-input.text == "": Text {
                        x: 34px;
                        text: "Search";
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: Theme.space-s;
                }

                NavRow {
                    label: "Home";
                    icon: @image-url("../assets/icons/home.svg");
                    has-icon: true;
                    selected: root.page == Page.home;
                    selected-fired => { root.home-requested(); }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        for section in root.sections: NavRow {
                            label: section.label;
                            icon: root.group-icon(section.group);
                            has-icon: !section.child;
                            count: section.new-count;
                            header: section.is-header;
                            expanded: section.expanded;
                            child: section.child;
                            last: section.last;
                            selected: !section.is-header
                                && section.id == root.current-section
                                && (root.page == Page.section
                                || root.page == Page.keybinds
                                || root.page == Page.outputs
                                || root.page == Page.rules
                                || root.page == Page.shaders);
                            selected-fired => { root.section-selected(section.id); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                NavRow {
                    label: "Backups";
                    icon: @image-url("../assets/icons/backups.svg");
                    has-icon: true;
                    selected: root.page == Page.backups;
                    selected-fired => { root.backups-requested(); }
                }

                NavRow {
                    label: "Settings";
                    icon: @image-url("../assets/icons/settings.svg");
                    has-icon: true;
                    count: root.update-available ? 1 : 0;
                    neutral-count: true;
                    selected: root.page == Page.settings;
                    selected-fired => { root.settings-requested(); }
                }

                NavRow {
                    label: "Exit";
                    icon: @image-url("../assets/icons/exit.svg");
                    has-icon: true;
                    selected-fired => {
                        if (root.dirty) {
                            root.show-exit-confirm = true;
                        } else {
                            root.exit-requested();
                        }
                    }
                }
            }
        }

        VerticalLayout {
            // ── top bar: where you are, and Save ────────────────
            Rectangle {
                height: 56px;
                background: Theme.bg-0;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    padding-left: Theme.space-xl;
                    padding-right: Theme.space-xl;
                    spacing: 10px;

                    Image {
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        source: root.page == Page.home ? @image-url("../assets/icons/home.svg")
                            : root.page == Page.settings ? @image-url("../assets/icons/settings.svg")
                            : root.page == Page.backups ? @image-url("../assets/icons/backups.svg")
                            : root.page == Page.search ? @image-url("../assets/icons/search.svg")
                            : root.group-icon(root.page-group);
                        colorize: Theme.text-2;
                    }

                    Text {
                        text: root.page == Page.home ? "Home"
                            : root.page == Page.settings ? "Settings"
                            : root.page == Page.backups ? "Backups"
                            : root.page == Page.search ? "Search"
                            : root.page-title;
                        color: Theme.text-2;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Only while there is something to save.
                    if root.dirty: VerticalLayout {
                        alignment: center;

                        ActionButton {
                            text: "Save " + root.changed-count + " change" + (root.changed-count == 1 ? "" : "s");
                            primary: true;
                            clicked => { root.save-requested(); }
                        }
                    }
                }
            }

            // ── content ─────────────────────────────────────────
            Rectangle {
                background: Theme.bg-0;

                if root.page == Page.home: hsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: home-page.preferred-height;

                    home-page := HomePage {
                        width: min(1040px, hsv.visible-width);
                        x: (hsv.visible-width - self.width) / 2;
                        include-count: root.include-files.length;
                        include-files: root.include-files;
                        config-path: root.config-path;
                        view-file(i, key) => { root.view-file(i, key); }
                        changed-count: root.changed-count;
                        changes: root.home-changes;
                        new-settings: root.home-new-settings;
                        monitors: root.home-monitors;
                        desk: root.home-desk-style;
                        umbriel-missing: root.umbriel-missing;
                        upstream-note: root.upstream-note;
                        update-available: root.update-available;
                        update-note: root.update-note;
                        update-notes: root.update-notes;
                        update-can-install: root.update-can-install;
                        update-installed: root.update-installed;
                        update-hint: root.update-hint;
                        view-changelog => { root.view-changelog(); }
                        open-page(id) => {
                            if id == "" {
                                root.save-requested();
                            } else {
                                root.section-selected(id);
                            }
                        }
                        view-main-file => { root.view-file(root.include-files.length, ""); }
                        install-update => { root.install-update(); }
                        restart-app => { root.restart-app(); }
                        view-update-notes => { root.view-update-notes(); }
                        open-settings => { root.settings-requested(); }
                        run-guide => { root.guide-relaunch(); }
                        mark-all-seen => { root.mark-all-seen(); }
                    }
                }

                if root.page == Page.keybinds: kbv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: keybinds-page.preferred-height;

                    keybinds-page := KeybindsPage {
                        width: min(1100px, kbv.visible-width);
                        x: (kbv.visible-width - self.width) / 2;
                    }
                }

                if root.page == Page.outputs: opsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: outputs-page.preferred-height;

                    outputs-page := OutputsPage {
                        width: min(1100px, opsv.visible-width);
                        x: (opsv.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        monitors: root.monitors;
                        live-note: root.outputs-live-note;
                        add-name <=> root.outputs-add-name;
                        refresh => { root.outputs-refresh(); }
                        add(n) => { root.output-add(n); }
                        remove(n) => { root.output-remove(n); }
                        toggle-monitor(n) => { root.toggle-monitor(n); }
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i, key) => { root.view-file(i, key); }
                    }
                }

                if root.page == Page.rules: rpv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: rule-page.preferred-height;

                    rule-page := RulePage {
                        width: min(1100px, rpv.visible-width);
                        x: (rpv.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        rule-cards: root.rule-cards;
                        add-rule => { root.rule-add(); }
                        remove-rule(f, i) => { root.rule-remove(f, i); }
                        toggle-rule(f, i) => { root.toggle-rule(f, i); }
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i, key) => { root.view-file(i, key); }
                    }
                }

                if root.page == Page.shaders && root.shader-editor-open: ShaderEditorPage {
                    width: 100%;
                    height: 100%;
                    editing: root.shader-editor-editing;
                    used-by: root.shader-editor-used-by;
                    name <=> root.shader-editor-name;
                    text <=> root.shader-editor-text;
                    note: root.shader-editor-note;
                    kinds: root.shader-kinds;
                    kind <=> root.shader-editor-kind;
                    steps: root.shader-steps;
                    step-kinds: root.shader-step-kinds;
                    builder-locked: root.shader-builder-locked;
                    preview-image: root.shader-preview-image;
                    preview-progress <=> root.shader-preview-progress;
                    preview-direction: root.shader-preview-direction;
                    preview-ready: root.shader-preview-ready;
                    preview-note: root.shader-preview-note;
                    preview-events: root.shader-preview-events;
                    preview-event <=> root.shader-preview-event;
                    preview-length-ms: root.shader-preview-length-ms;
                    confirm-close <=> root.shader-editor-confirm-close;
                    kind-picked(i) => { root.shader-editor-kind-picked(i); }
                    builder-reset => { root.shader-builder-reset(); }
                    step-add(k) => { root.shader-step-add(k); }
                    step-remove(i) => { root.shader-step-remove(i); }
                    step-move(i, d) => { root.shader-step-move(i, d); }
                    step-param(i, s, v) => { root.shader-step-param(i, s, v); }
                    step-param-live(i, s, v) => { root.shader-step-param-live(i, s, v); }
                    preview-event-picked(i) => { root.shader-preview-event-picked(i); }
                    preview-scrub(v) => { root.shader-preview-scrub(v); }
                    preview-direction-toggled => { root.shader-preview-direction-toggled(); }
                    text-changed(t, a, c, k) => { root.shader-editor-text-changed(t, a, c, k); }
                    code-layer(t, i) => { root.shader-code-layer(t, i) }
                    code-history(k) => { root.shader-code-history(k) }
                    code-key(t, a, c, k) => { root.shader-code-key(t, a, c, k) }
                    close => { root.shader-editor-close(); }
                    discard => { root.shader-editor-open = false; }
                    delete => { root.shader-editor-delete(); }
                    save-request => { root.shader-editor-save-request(); }
                }

                if root.page == Page.shaders && !root.shader-editor-open: shsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: shaders-page.preferred-height;

                    shaders-page := ShadersPage {
                        width: min(1100px, shsv.visible-width);
                        x: (shsv.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        shaders: root.shaders;
                        assignments: root.shader-assignments;
                        download-note: root.shader-download-note;
                        include-missing: root.shader-include-missing;
                        legacy-note: root.shader-legacy-note;
                        community-installed: root.shader-community-installed;
                        update-available: root.shader-update-available;
                        downloading <=> root.shader-downloading;
                        tab <=> root.shader-tab;
                        own-count: root.shader-own-count;
                        other-count: root.shader-other-count;
                        grid <=> root.shader-grid;
                        hover-preview <=> root.shader-hover-preview;
                        live-image: root.shader-preview-image;
                        download => { root.shaders-download(); }

                        fix-include => { root.shader-fix-include(); }
                        convert-legacy => { root.shader-convert-legacy(); }
                        pick(key, event, current) => {
                            root.shader-picker-key = key;
                            root.shader-picker-kind = root.shader-assignments[event].kind;
                            root.shader-picker-title = "Shader for " + root.shader-assignments[event].label;
                            root.shader-picker-selected = current;
                            root.shader-preview-event = event;
                            root.shader-picker-open = true;
                            if (current >= 0) {
                                root.shader-preview-file(current, event);
                            }
                        }
                        open-preview(index) => {
                            root.shader-picker-key = "";
                            root.shader-picker-kind = -1;
                            root.shader-picker-title = root.shaders[index].name;
                            root.shader-picker-selected = index;
                            root.shader-picker-open = true;
                            root.shader-preview-file(index, root.shader-preview-event);
                        }
                        play(index) => { root.shader-preview-file(index, 0); }
                        scrub(v) => { root.shader-preview-scrub(v); }
                        view-changed => { root.shader-view-changed(); }
                        thumbs-wanted => { root.shader-thumbs-wanted(); }
                        editor-new => { root.shader-editor-new(); }
                        editor-edit(p) => { root.shader-editor-edit(p); }
                        editor-fork(p, n) => { root.shader-editor-fork(p, n); }
                        editor-delete(p) => { root.shader-delete-file(p); }
                    }
                }

                if root.page == Page.section && !root.schema-empty: svs := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: section-page.preferred-height;

                    // Full content width; the page's own layout padding
                    // insets the cards. Width depends only on the
                    // ScrollView's visible width, so no intrinsic-size
                    // feedback cycles.
                    section-page := CategoryPage {
                        width: min(880px, svs.visible-width);
                        x: (svs.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        cards: root.cards;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i, key) => { root.view-file(i, key); }
                        toggle-card(title) => { root.toggle-card(title); }
                    }
                }

                if root.page == Page.search: sev := ScrollView {
                    VerticalLayout {
                        width: min(880px, sev.visible-width);
                        x: (sev.visible-width - self.width) / 2;
                        padding: Theme.space-l;
                        spacing: Theme.space-m;
                        alignment: start;
                        Text {
                            text: root.page-title;
                            color: Theme.text-1;
                            font-size: Theme.font-title;
                            font-weight: 700;
                        }

                        for row in root.search-rows: PointerRow {
                            label: row.label;
                            home-label: row.home-label;
                            is-new: row.is-new;
                            open => {
                                // A keybind hit lands on the keybinds page
                                // filtered to the query (which is the page
                                // title while searching).
                                if (row.kind == "keybind") {
                                    root.keybinds-search-requested(root.page-title);
                                } else {
                                    root.section-selected(row.home-section);
                                }
                            }
                        }
                        if root.search-rows.length == 0: Text {
                            text: "No matches.";
                            color: Theme.text-2;
                        }
                    }
                }
                if root.page == Page.settings: stv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: settings-page.preferred-height;

                    settings-page := SettingsPage {
                        width: min(880px, stv.visible-width);
                        x: (stv.visible-width - self.width) / 2;
                        app-version: root.app-version;
                        umbriel-missing: root.umbriel-missing;
                        check-updates-on-start: root.check-updates-on-start;
                        update-channel: root.update-channel;
                        canary-auto-install: root.canary-auto-install;
                        dark-mode: root.dark-mode;
                        config-path: root.config-path;
                        include-files: root.include-files;
                        sync-note: root.sync-note;
                        sync-clean: root.sync-clean;
                        update-note: root.update-note;
                        update-available: root.update-available;
                        update-notes: root.update-notes;
                        update-can-install: root.update-can-install;
                        update-hint: root.update-hint;
                        update-installed: root.update-installed;
                        install-update => { root.install-update(); }
                        restart-app => { root.restart-app(); }
                        view-changelog => { root.view-changelog(); }
                        view-update-notes => { root.view-update-notes(); }
                        upstream-note: root.upstream-note;
                        check-now => { root.check-updates-requested(); }
                        toggled(v) => { root.check-updates-toggled(v); }
                        channel-selected(i) => { root.update-channel-selected(i); }
                        auto-install-toggled(v) => { root.canary-auto-install-toggled(v); }
                        theme-selected(d) => { root.theme-selected(d); }
                        open-url(u) => { root.open-url(u); }
                        relaunch => { root.guide-relaunch(); }
                        sync-schema => { root.sync-schema-requested(); }
                    }
                }

                if root.page == Page.backups: bsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: backups-page.preferred-height;

                    backups-page := BackupsPage {
                        width: min(880px, bsv.visible-width);
                        x: (bsv.visible-width - self.width) / 2;
                        backup-note: root.backup-note;
                        backups: root.backup-choices;
                        selected-backup: root.backup-selected;
                        restore-possible: root.restore-possible;
                        restore-diff: root.restore-diff;
                        // Two-way: one-way bindings detach once the user
                        // edits a field (the slider bug again) — after
                        // that, a reset or Browse could no longer update
                        // the field.
                        count-text <=> root.backup-count-text;
                        dir-text <=> root.backup-dir-text;
                        backup-now => { root.backup-now(); }
                        backup-chosen(i) => { root.backup-chosen(i); }
                        restore-backup => { root.restore-backup(); }
                        count-chosen(t) => { root.backup-count-chosen(t); }
                        dir-chosen(t) => { root.backup-dir-chosen(t); }
                        browse-location => { root.browse-location(); }
                    }
                }

                // No settings: an honest empty state instead of a
                // blank page (plain install after create / continue).
                if root.page == Page.section && root.schema-empty: Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-m;
                        padding: Theme.space-xl;

                        Text {
                            text: "No settings to show";
                            color: Theme.text-1;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "No settings could be read from umbriel's docs. Sync from Settings to download them again.";
                            color: Theme.text-2;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Your config: " + root.config-path;
                            color: Theme.text-2;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Click \"Sync schema\" in Settings to download umbriel's docs. Its settings will appear here.";
                            color: Theme.text-2;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: center;

                            ActionButton {
                                text: "Install docs";
                                clicked => { root.open-url("https://docs.noctalia.dev/umbriel/"); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── first-run onboarding (plain install state) ──────────
    if root.show-onboarding: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        Rectangle {
            width: min(parent.width - 96px, 520px);
            height: min(parent.height - 96px, 440px);
            border-radius: Theme.radius-xl;
            background: Theme.bg-3;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-m;
                alignment: start;

                Text {
                    text: "Welcome to Umbriel Config";
                    color: Theme.text-1;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }

                Text {
                    text: root.umbriel-missing
                        ? "Umbriel wasn't detected on this system or no config file exists."
                        : "No config file exists yet, create one to be guided on setting the frequently used settings.";
                    color: Theme.text-1;
                    wrap: TextWrap.word-wrap;
                }

                Text {
                    text: "Right now you can create and edit config.toml, change values, and use include files.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                }

                Text {
                    text: "Without umbriel, saved changes can't be validated. The setting pages still work: they come from umbriel's docs.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                    visible: root.umbriel-missing;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Install docs";
                        visible: root.umbriel-missing;
                        clicked => { root.open-url("https://docs.noctalia.dev/umbriel/"); }
                    }

                    ActionButton {
                        text: "Continue anyway";
                        clicked => { root.show-onboarding = false; }
                    }

                    ActionButton {
                        text: "Create config.toml";
                        primary: true;
                        clicked => { root.onboarding-create(); }
                    }
                }
            }
        }
    }

    // ── guided setup (after create, schema present) ─────────
    if root.show-guide: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        Rectangle {
            width: min(parent.width - 128px, 760px);
            height: min(parent.height - 96px, 560px);
            border-radius: Theme.radius-xl;
            background: Theme.bg-3;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: root.guide-title;
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Suggested defaults are filled in, change anything you like. A value you leave alone is saved as the suggested default.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                }

                gsv := ScrollView {
                    vertical-stretch: 1;
                    viewport-height: guide-page.preferred-height;

                    guide-page := CategoryPage {
                        width: gsv.visible-width;
                        title: "";
                        description: "";
                        cards: root.cards;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i, key) => { root.view-file(i, key); }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    if root.guide-cancellable: ActionButton {
                        text: "Cancel";
                        clicked => { root.guide-cancel(); }
                    }

                    ActionButton {
                        text: "Back";
                        enabled: !root.guide-first;
                        clicked => { root.guide-back(); }
                    }

                    ActionButton {
                        text: root.guide-last ? "Finish and save" : "Next";
                        primary: true;
                        clicked => { root.guide-next(); }
                    }
                }
            }
        }
    }

    // ── save popup: per-key destinations + confirm ──────────
    if root.show-save-popup: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        // Scrim click cancels; the card absorbs its own clicks.
        TouchArea {
            clicked => { root.show-save-popup = false; }
        }

        Rectangle {
            width: min(parent.width - 96px, 640px);
            height: min(parent.height - 96px, 480px);
            border-radius: Theme.radius-xl;
            background: Theme.bg-3;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: "Save changes";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Pick where each changed setting should live, or reset it.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                }

                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;

                        for entry in root.save-entries: HorizontalLayout {
                            spacing: Theme.space-m;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                Text {
                                    text: entry.label;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: entry.value;
                                    color: Theme.text-2;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            ComboBox {
                                width: 200px;
                                model: root.destinations;
                                current-index: entry.dest-index;
                                selected(v) => { root.save-dest-chosen(entry.key, v); }
                            }

                            ActionButton {
                                text: "Reset";
                                clicked => { root.reset-entry(entry.key); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Discard all";
                        clicked => { root.discard-all(); }
                    }

                    ActionButton {
                        text: "Cancel";
                        clicked => { root.show-save-popup = false; }
                    }

                    ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => { root.save-confirmed(); }
                    }
                }
            }
        }
    }

    // ── unsaved-changes confirm overlay ──────────────────────
    if root.show-exit-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        Rectangle {
            width: 340px;
            height: 150px;
            border-radius: Theme.radius-xl;
            background: Theme.bg-3;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: "Unsaved changes";
                    color: Theme.danger;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Quit without saving?";
                    color: Theme.text-2;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;
                    ActionButton {
                        text: "Keep editing";
                        clicked => { root.show-exit-confirm = false; }
                    }

                    ActionButton {
                        text: "Quit anyway";
                        primary: true;
                        clicked => { root.exit-requested(); }
                    }
                }
            }
        }
    }

    // ── what's new / changelog overlay ────────────────────
    if root.show-whatsnew: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {
                root.whatsnew-notice = "";
                root.show-whatsnew = false;
            }
        }

        Rectangle {
            width: min(parent.width - 96px, 720px);
            height: min(parent.height - 96px, 680px);
            border-radius: Theme.radius-xl;
            background: Theme.bg-3;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                HorizontalLayout {
                    spacing: Theme.space-m;

                    Text {
                        text: root.whatsnew-title;
                        color: Theme.text-1;
                        font-size: Theme.font-large;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: "Close";
                        clicked => {
                            root.whatsnew-notice = "";
                            root.show-whatsnew = false;
                        }
                    }
                }

                if root.whatsnew-notice != "": Rectangle {
                    background: Theme.bg-2;
                    border-radius: Theme.radius-m;
                    border-width: 1px;
                    border-color: Theme.accent;

                    VerticalLayout {
                        padding: Theme.space-m;
                        spacing: Theme.space-s;

                        Text {
                            text: root.whatsnew-notice;
                            color: Theme.text-1;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                        }

                        HorizontalLayout {
                            alignment: start;

                            ActionButton {
                                text: "Open update settings";
                                primary: true;
                                clicked => {
                                    root.whatsnew-notice = "";
                                    root.show-whatsnew = false;
                                    root.settings-requested();
                                }
                            }
                        }
                    }
                }

                if root.whatsnew-full && root.whatsnew-canary-url != "": HorizontalLayout {
                    spacing: Theme.space-m;

                    Text {
                        text: "This canary build also has changes since the last release.";
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        wrap: TextWrap.word-wrap;
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: "Commits on GitHub";
                        clicked => { root.open-url(root.whatsnew-canary-url); }
                    }
                }

                sv := ScrollView {
                    viewport-height: notes.preferred-height;

                    notes := VerticalLayout {
                        width: sv.visible-width;
                        alignment: start;
                        spacing: Theme.space-l;

                        ReleaseNotes {
                            cards: root.whatsnew-cards;
                        }

                        if !root.whatsnew-full && root.whatsnew-cards.length > 0: HorizontalLayout {
                            alignment: center;
                            padding-bottom: Theme.space-s;

                            ActionButton {
                                text: "Show full changelog";
                                clicked => { root.view-changelog(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── read-only file viewer (from a row's "in <file>" badge) ──
    if root.show-file-popup: FileViewer {
        title: root.popup-file-title;
        path: root.popup-file-path;
        stats: root.file-stats;
        lines: root.popup-file-lines;
        focus-line: root.popup-focus-line;
        close => { root.show-file-popup = false; }
        open-in-editor => { root.open-url(root.popup-file-path); }
    }

    // ── shader "Use for" checklist (the editor's Save step) ──
    if root.page == Page.shaders && root.shader-editor-open && root.shader-use-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;

        // Absorb clicks: this step is left with Back or Save.
        TouchArea { }

        Rectangle {
            width: min(440px, parent.width - 48px);
            height: use-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xl;
            background: Theme.bg-3;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            border-width: 1px;
            border-color: Theme.border;

            use-layout := VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-s;

                Text {
                    text: "Use this shader for";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Ticked events switch to this shader and unticked ones stop using it, as changes you save with the main Save button. Save only keeps the file and changes no assignments.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }

                for row in root.shader-use-for: HorizontalLayout {
                    spacing: Theme.space-m;

                    CheckBox {
                        text: row.label;
                        checked: row.checked;
                        toggled => { row.checked = self.checked; }
                    }

                    Text {
                        text: row.current;
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;
                    padding-top: Theme.space-s;

                    ActionButton {
                        text: "Back";
                        clicked => { root.shader-use-open = false; }
                    }

                    // Keep the file, leave every assignment as it is.
                    ActionButton {
                        text: "Save only";
                        clicked => {
                            root.shader-use-open = false;
                            root.shader-editor-save(false);
                        }
                    }

                    ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.shader-use-open = false;
                            root.shader-editor-save(true);
                        }
                    }
                }
            }
        }
    }

    // ── shader picker (opened from an assignment or the library) ──
    if root.shader-picker-open: ShaderPicker {
        title: root.shader-picker-title;
        key: root.shader-picker-key;
        kind: root.shader-picker-kind;
        kind-counts: root.shader-kind-counts;
        shaders: root.shaders;
        own-count: root.shader-own-count;
        other-count: root.shader-other-count;
        grid <=> root.shader-grid;
        hover-preview <=> root.shader-hover-preview;
        selected <=> root.shader-picker-selected;
        preview-image: root.shader-preview-image;
        preview-ready: root.shader-preview-ready;
        preview-note: root.shader-preview-note;
        direction-in: root.shader-preview-direction > 0;
        progress <=> root.shader-preview-progress;
        events: root.shader-preview-events;
        event-index <=> root.shader-preview-event;
        configured-ms: root.shader-preview-length-ms;
        close => { root.shader-picker-open = false; }
        assign(index) => {
            root.shader-assign(root.shader-picker-key, index + 1);
            root.shader-picker-open = false;
        }
        show(index) => { root.shader-preview-file(index, root.shader-preview-event); }
        event-picked(i) => { root.shader-preview-event-picked(i); }
        scrub(v) => { root.shader-preview-scrub(v); }
        toggle-direction => { root.shader-preview-direction-toggled(); }
        view-changed => { root.shader-view-changed(); }
        edit(index) => {
            root.shader-picker-open = false;
            root.shader-editor-edit(root.shaders[index].path);
        }
        fork(index) => {
            root.shader-picker-open = false;
            root.shader-editor-fork(root.shaders[index].path, root.shaders[index].name);
        }
        delete(index) => {
            root.shader-picker-open = false;
            root.shader-delete-file(root.shaders[index].path);
        }
    }

    // ── alert: something failed and the user must know ──────
    if root.alert-title != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 64px, 440px);
            height: alert-layout.preferred-height;
            border-radius: Theme.radius-xl;
            background: Theme.bg-3;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;

            alert-layout := VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-m;

                Text {
                    text: root.alert-title;
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 600;
                    wrap: TextWrap.word-wrap;
                }

                Text {
                    text: root.alert-body;
                    color: Theme.text-2;
                    wrap: TextWrap.word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    padding-top: Theme.space-s;

                    ActionButton {
                        text: "OK";
                        primary: true;
                        clicked => { root.alert-title = ""; }
                    }
                }
            }
        }
    }

    // ── toasts: bottom-right, newest at the bottom ──────────
    Rectangle {
        x: parent.width - self.width - Theme.space-l;
        y: parent.height - self.height - Theme.space-l;
        width: min(parent.width - 2 * Theme.space-l, 380px);
        height: toast-list.preferred-height;

        toast-list := VerticalLayout {
            spacing: Theme.space-s;

            for toast in root.toasts: Rectangle {
                // Starts hidden and low; init flips it so the animation
                // runs as the toast arrives.
                in-out property <bool> shown: false;
                init => { self.shown = true; }
                opacity: self.shown ? 1 : 0;
                animate opacity { duration: 180ms; }
                height: toast-row.preferred-height;
                border-radius: Theme.radius-l;
                background: Theme.bg-3;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #00000055;

                toast-row := HorizontalLayout {
                    padding-left: Theme.space-m;
                    padding-right: Theme.space-s;
                    padding-top: Theme.space-s;
                    padding-bottom: Theme.space-s;
                    spacing: Theme.space-s;

                    VerticalLayout {
                        alignment: center;

                        Image {
                            width: 16px;
                            height: 16px;
                            source: toast.kind == ToastKind.success ? @image-url("../assets/icons/check.svg")
                                : toast.kind == ToastKind.info ? @image-url("../assets/icons/info.svg")
                                : @image-url("../assets/icons/alert.svg");
                            colorize: toast.kind == ToastKind.success ? Theme.success
                                : toast.kind == ToastKind.warning ? Theme.warning
                                : toast.kind == ToastKind.error ? Theme.danger
                                : Theme.text-2;
                        }
                    }

                    Text {
                        text: toast.text;
                        color: Theme.text-1;
                        wrap: TextWrap.word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-height: 28px;
                    }

                    if toast.action != "": VerticalLayout {
                        alignment: center;

                        ActionButton {
                            text: toast.action;
                            clicked => { root.toast-action(toast.id, toast.action); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: Theme.radius-s;
                            background: close-ta.has-hover ? Theme.bg-2 : transparent;

                            Image {
                                width: 14px;
                                height: 14px;
                                source: @image-url("../assets/icons/close.svg");
                                colorize: Theme.text-2;
                            }

                            close-ta := TouchArea {
                                clicked => { root.toast-closed(toast.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── color picker popup (opened from a row's color swatch) ──
    // Last overlay so it also rides above the guide walk, whose
    // appearance step has color rows of its own. Drags only move the
    // card's draft; Apply writes (a no-op when the color didn't
    // change) and closes, Close/scrim discards.
    if PickerState.open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea {
            clicked => { PickerState.open = false; }
        }

        ColorPickerCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            apply(text) => {
                if (text != PickerState.hex) {
                    root.set-value(PickerState.key, text);
                }
                PickerState.open = false;
            }
        }
    }
}
