// Main window shell: header, sidebar, page frame, and the app-level
// overlays (onboarding, guide, save popup, exit confirm, what's-new,
// file view, shader editor). Pages live in ui/pages/, shared widgets in
// ui/widgets.slint, shared structs in ui/types.slint; everything visual
// reads tokens from theme.slint.

import { Theme } from "theme.slint";
import { Palette } from "std-widgets.slint";
// Re-export so the generated Rust code exposes the global (set_dark).
export {
    Theme,
}
// Re-exported for the Rust side too: rows.rs installs the ColorMath
// handlers that the picker popup's bindings call.
export { ColorMath }
import {
    CheckBox,
    ComboBox,
    LineEdit,
    ScrollView,
    TextEdit,
} from "std-widgets.slint";

import {
    ActionButton,
    ColorPickerCard,
    NavRow,
    PointerRow,
} from "widgets.slint";
import {
    ColorMath,
    KeybindRow,
    MonitorCard,
    PickerState,
    RuleCard,
    SaveEntry,
    SectionNav,
    SectionRow,
    SettingsCard,
    CodeEdit,
    ShaderAssignment,
    ShaderInfo,
    ShaderStep,
    ShaderUse,
} from "types.slint";
import { CategoryPage } from "pages/category.slint";
import { SettingsPage } from "pages/settings.slint";
import { BackupsPage } from "pages/backups.slint";
import { KeybindsPage } from "pages/keybinds.slint";
import { OutputsPage } from "pages/outputs.slint";
import { RulePage } from "pages/rules.slint";
import {
    ShaderBuilderPanel,
    ShaderCodeEditor,
    ShaderPreviewRow,
    ShadersPage,
} from "pages/shaders.slint";

// Embedded fonts (compiler bakes these into the binary). Family names are
// the fonts' internal names, verified with fc-scan.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/JetBrainsMono-Regular.ttf";

export enum Page { section, search, settings, backups, keybinds, outputs, rules, shaders }

export component AppWindow inherits Window {
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 480px;
    title: "Umbriel Config";
    background: Theme.bg-0;
    default-font-family: "Inter";
    default-font-size: Theme.font-body;

    in property <string> config-path;
    in property <[string]> include-files;
    in property <string> sync-note;
    in property <bool> sync-clean: true;
    in property <string> include-note;
    in property <bool> dirty;
    in property <[SectionNav]> sections;
    in property <string> page-title;
    in property <string> page-description;
    in property <string> status;
    in-out property <string> current-section;
    in-out property <bool> show-exit-confirm: false;
    in-out property <Page> page: Page.section;
    in property <[SettingsCard]> cards;
    in property <[SectionRow]> search-rows;
    // Keys whose current value differs from the on-disk snapshot.
    in property <int> changed-count;
    in property <[string]> destinations;
    in-out property <bool> show-save-popup: false;
    in property <[SaveEntry]> save-entries;
    // Validation result of the last save (empty = nothing to report).
    in-out property <string> validate-note;
    in-out property <bool> show-file-popup: false;
    in property <string> popup-file-title;
    in property <string> popup-file-path;
    in property <string> popup-file-text;
    in property <string> file-stats;

    callback search-edited(string);
    callback section-selected(string);
    // Open the keybinds page with its filter pre-filled.
    callback keybinds-search-requested(string);
    callback set-value(string, string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int);
    callback save-dest-chosen(string, string);
    callback save-confirmed();
    callback reset-entry(string);
    callback reset-key(string);
    callback discard-all();
    callback save-requested();
    callback sync-schema-requested();
    callback exit-requested();
    callback outputs-refresh();
    callback output-add(string);
    callback output-remove(string);
    callback rule-add();
    callback rule-remove(int, int);
    callback toggle-card(string);
    callback toggle-monitor(string);
    callback toggle-rule(int, int);
    callback shaders-download();
    // Assignment dropdown pick: (key, choice index); 0 clears.
    callback shader-assign(string, int);
    callback shader-fix-include();
    // What's new / changelog overlay.
    in-out property <bool> show-whatsnew;
    in property <string> whatsnew-title;
    in property <string> whatsnew-body;
    // One-time notice above the notes; empty once it has been read.
    in-out property <string> whatsnew-notice;
    callback view-changelog();
    callback view-update-notes();

    // Keybinds page
    in property <[KeybindRow]> keybind-rows;
    in-out property <string> keybind-search;
    in property <[string]> action-choices;
    in-out property <bool> kb-editor-open;
    in-out property <bool> kb-capturing;
    in-out property <bool> keybind-editing;
    in property <[MonitorCard]> monitors;
    in property <string> outputs-live-note;
    in-out property <string> outputs-add-name;
    in property <[RuleCard]> rule-cards;
    in property <[ShaderInfo]> shaders;
    in property <[ShaderAssignment]> shader-assignments;
    in property <string> shader-download-note;
    in property <bool> shader-include-missing;
    in property <bool> shader-community-installed;
    in property <bool> shader-update-available;
    in-out property <bool> shader-downloading;
    // Shader editor overlay.
    in-out property <bool> shader-editor-open;
    in property <bool> shader-editor-editing;
    // Events assigned the shader being edited, for the delete confirm.
    in property <string> shader-editor-used-by;
    in-out property <string> shader-editor-name;
    in-out property <string> shader-editor-text;
    in property <string> shader-editor-note;
    in property <[ShaderStep]> shader-steps;
    // The code pane isn't builder output (hand-edited or foreign), so
    // the builder is read-only until reset.
    in property <bool> shader-builder-locked;
    in property <[string]> shader-step-kinds;
    callback shader-editor-new();
    callback shader-editor-edit(string);
    callback shader-editor-fork(string, string);
    // Save asks which events use the shader first: request fills the
    // checklist and opens it, save does the work.
    callback shader-editor-save-request();
    // true: apply the "Use for" ticks; false: save the file only.
    callback shader-editor-save(bool);
    in-out property <[ShaderUse]> shader-use-for;
    in-out property <bool> shader-use-open;
    callback shader-editor-delete();
    // Delete a library card's own shader by path.
    callback shader-delete-file(string);
    // Close request; with unsaved code Rust raises confirm-close instead.
    callback shader-editor-close();
    in-out property <bool> shader-editor-confirm-close;
    // (text, anchor, cursor, kind); see ShaderCodeEditor.edited.
    callback shader-editor-text-changed(string, int, int, int);
    callback shader-code-history(string) -> CodeEdit;
    // Editor keys (Tab/Shift+Tab/Enter) done in Rust; see ShaderCodeEditor.
    callback shader-code-key(string, int, int, string) -> CodeEdit;
    callback shader-step-add(string);
    callback shader-builder-reset();
    callback shader-step-remove(int);
    callback shader-step-move(int, int);
    callback shader-step-param(int, int, float);
    callback shader-step-param-live(int, int, float);
    // Preview scrubber for the editor.
    in property <image> shader-preview-image;
    in-out property <float> shader-preview-progress: 0;
    in-out property <float> shader-preview-direction: 1;
    in property <bool> shader-preview-ready;
    in property <string> shader-preview-note;
    callback shader-preview-scrub(float);
    // "Preview as": the events (labels, umbriel order), the chosen one,
    // and how long that event runs as configured.
    in property <[string]> shader-preview-events;
    in-out property <int> shader-preview-event;
    in property <int> shader-preview-length-ms: 250;
    callback shader-preview-event-picked(int);
    callback shader-preview-direction-toggled();
    in-out property <string> kb-draft-chord;
    in-out property <bool> kb-draft-use-mod;
    in-out property <string> kb-draft-scope;
    in-out property <int> kb-draft-action;
    in-out property <string> kb-draft-param;
    in-out property <bool> kb-draft-no-repeat;
    in-out property <bool> kb-draft-locked;
    in-out property <string> kb-draft-submap;
    in property <string> kb-conflict-note;
    in-out property <int> kb-original-index;
    in-out property <string> kb-original-chord;
    callback keybind-search-edited(string);
    callback keybind-add();
    callback keybind-edit(int);
    callback keybind-remove(int);
    callback keybind-apply();

    // Backups page
    in property <[string]> backup-choices;
    in-out property <int> backup-selected: 0;
    in property <bool> restore-possible: false;
    in property <string> restore-diff;
    in property <string> backup-action-note;
    in property <string> backup-note;
    in-out property <string> backup-count-text;
    in-out property <string> backup-dir-text;
    callback backups-requested();
    callback backup-now();
    callback backup-chosen(int);
    callback restore-backup();
    callback backup-count-chosen(string);
    callback backup-dir-chosen(string);
    callback browse-location();

    // Settings page
    in property <string> app-version;
    in-out property <bool> check-updates-on-start: true;
    in-out property <bool> update-prereleases: true;
    in-out property <bool> dark-mode: true;
    // Standard widgets (LineEdit, CheckBox, ComboBox, AboutSlint) follow
    // Slint's builtin palette, not our tokens — keep it in step.
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    in property <string> update-note;
    in property <bool> update-available: false;
    in property <string> update-notes;
    // Tarball installs replace themselves; the rest show update-hint.
    in property <bool> update-can-install: false;
    in property <string> update-hint;
    in-out property <string> update-version;
    in-out property <bool> update-installed: false;
    in property <string> upstream-note;
    callback settings-requested();
    callback check-updates-requested();
    callback check-updates-toggled(bool);
    callback update-channel-selected(bool);
    callback install-update();
    callback restart-app();
    callback theme-selected(bool);
    callback open-url(string);

    // First-run onboarding (plain install) + missing-umbriel banner.
    in-out property <bool> show-onboarding: false;
    in-out property <bool> umbriel-missing: false;
    // No schema source (umbriel not detected): the section page becomes
    // an empty-state pointer instead of a blank page.
    in property <bool> schema-empty: false;
    callback onboarding-create();

    // Guided setup after create (schema present): one card per section,
    // suggested defaults filled in and editable.
    in-out property <bool> show-guide: false;
    in property <string> guide-title;
    in property <bool> guide-first: false;
    in property <bool> guide-last: false;
    callback guide-back();
    callback guide-next();
    callback guide-relaunch();

    VerticalLayout {
        // ── header ─────────────────────────────────────────────
        Rectangle {
            height: 44px;
            background: Theme.bg-1;

            HorizontalLayout {
                padding-left: Theme.space-l;
                padding-right: Theme.space-l;
                spacing: Theme.space-m;
                alignment: start;

                Text {
                    text: "Umbriel Config";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // Flexes with the window between a usable minimum and a
                // compact maximum; the spacer keeps the rest.
                LineEdit {
                    min-width: 160px;
                    max-width: 320px;
                    horizontal-stretch: 1;
                    placeholder-text: "Search Settings";
                    edited(t) => { root.search-edited(t); }
                }

                ActionButton {
                    text: "Save" + (root.changed-count > 0 ? " · " + root.changed-count : "");
                    primary: true;
                    enabled: root.dirty;
                    clicked => { root.save-requested(); }
                }
            }
        }

        // include warning strip (only when notes exist)
        if root.include-note != "": Rectangle {
            height: 24px;
            background: Theme.bg-1;
            Text {
                x: Theme.space-l;
                text: "⚠ " + root.include-note;
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        // validation result of the last save (errors and warnings)
        if root.validate-note != "": Rectangle {
            height: 24px;
            background: Theme.bg-1;
            Text {
                x: Theme.space-l;
                text: "⚠ " + root.validate-note;
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        // quiet banner: umbriel missing but a config exists
        if root.umbriel-missing: Rectangle {
            height: 24px;
            background: Theme.bg-1;

            banner-ta := TouchArea {
                clicked => { root.umbriel-missing = false; }
            }

            Text {
                x: Theme.space-l;
                text: "Umbriel not detected, validation unavailable · click to dismiss";
                color: Theme.warning;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            // ── sidebar ─────────────────────────────────────────
                        Rectangle {
                width: 208px;
                background: Theme.bg-1;

                VerticalLayout {
                    spacing: Theme.space-xs;

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: Theme.space-s;
                            spacing: Theme.space-xs;
                            alignment: start;

                            Text {
                                text: "Settings";
                                color: Theme.text-1;
                                font-size: Theme.font-large;
                                font-weight: 700;
                            }

                            for section in root.sections: NavRow {
                                label: section.label;
                                count: section.new-count;
                                header: section.is-header;
                                selected: !section.is-header
                                    && section.id == root.current-section
                                    && (root.page == Page.section
                                    || root.page == Page.keybinds
                                    || root.page == Page.outputs
                                    || root.page == Page.rules);
                                selected-fired => { root.section-selected(section.id); }
                            }
                        }
                    }

                    VerticalLayout {
                        vertical-stretch: 0;
                        padding: Theme.space-s;
                        spacing: Theme.space-xs;

                        NavRow {
                            label: "Backups";
                            selected: root.page == Page.backups;
                            selected-fired => { root.backups-requested(); }
                        }

                        NavRow {
                            label: "Settings" + (root.update-available ? " •" : "");
                            selected: root.page == Page.settings;
                            selected-fired => { root.settings-requested(); }
                        }

                        ActionButton {
                            text: "Exit";
                            clicked => {
                                if (root.dirty) {
                                    root.show-exit-confirm = true;
                                } else {
                                    root.exit-requested();
                                }
                            }
                        }
                    }
                }
            }

            // ── content ─────────────────────────────────────────
            Rectangle {
                background: Theme.bg-0;

                if root.page == Page.keybinds: kbv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: keybinds-page.preferred-height;

                    keybinds-page := KeybindsPage {
                        width: min(1100px, kbv.visible-width);
                        x: (kbv.visible-width - self.width) / 2;
                        rows: root.keybind-rows;
                        search <=> root.keybind-search;
                        action-choices: root.action-choices;
                        editor-open <=> root.kb-editor-open;
                        capturing <=> root.kb-capturing;
                        editing <=> root.keybind-editing;
                        draft-chord <=> root.kb-draft-chord;
                        draft-use-mod <=> root.kb-draft-use-mod;
                        draft-scope <=> root.kb-draft-scope;
                        draft-action <=> root.kb-draft-action;
                        draft-param <=> root.kb-draft-param;
                        draft-no-repeat <=> root.kb-draft-no-repeat;
                        draft-locked <=> root.kb-draft-locked;
                        draft-submap <=> root.kb-draft-submap;
                        conflict-note: root.kb-conflict-note;
                        search-edited(t) => { root.keybind-search-edited(t); }
                        add => { root.keybind-add(); }
                        edit(i) => { root.keybind-edit(i); }
                        remove(i) => { root.keybind-remove(i); }
                        apply => { root.keybind-apply(); }
                    }
                }

                if root.page == Page.outputs: opsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: outputs-page.preferred-height;

                    outputs-page := OutputsPage {
                        width: min(1100px, opsv.visible-width);
                        x: (opsv.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        monitors: root.monitors;
                        live-note: root.outputs-live-note;
                        add-name <=> root.outputs-add-name;
                        refresh => { root.outputs-refresh(); }
                        add(n) => { root.output-add(n); }
                        remove(n) => { root.output-remove(n); }
                        toggle-monitor(n) => { root.toggle-monitor(n); }
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i) => { root.view-file(i); }
                    }
                }

                if root.page == Page.rules: rpv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: rule-page.preferred-height;

                    rule-page := RulePage {
                        width: min(1100px, rpv.visible-width);
                        x: (rpv.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        rule-cards: root.rule-cards;
                        add-rule => { root.rule-add(); }
                        remove-rule(f, i) => { root.rule-remove(f, i); }
                        toggle-rule(f, i) => { root.toggle-rule(f, i); }
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i) => { root.view-file(i); }
                    }
                }

                if root.page == Page.shaders: shsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: shaders-page.preferred-height;

                    shaders-page := ShadersPage {
                        width: min(1100px, shsv.visible-width);
                        x: (shsv.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        shaders: root.shaders;
                        assignments: root.shader-assignments;
                        download-note: root.shader-download-note;
                        include-missing: root.shader-include-missing;
                        community-installed: root.shader-community-installed;
                        update-available: root.shader-update-available;
                        downloading <=> root.shader-downloading;
                        download => { root.shaders-download(); }

                        fix-include => { root.shader-fix-include(); }
                        // Without this wiring the dropdowns silently no-op:
                        // no edit, no dirty flag, nothing to save.
                        assign(k, i) => { root.shader-assign(k, i); }
                        editor-new => { root.shader-editor-new(); }
                        editor-edit(p) => { root.shader-editor-edit(p); }
                        editor-fork(p, n) => { root.shader-editor-fork(p, n); }
                        editor-delete(p) => { root.shader-delete-file(p); }
                    }
                }

                if root.page == Page.section && !root.schema-empty: svs := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: section-page.preferred-height;

                    // Full content width; the page's own layout padding
                    // insets the cards. Width depends only on the
                    // ScrollView's visible width, so no intrinsic-size
                    // feedback cycles.
                    section-page := CategoryPage {
                        width: min(880px, svs.visible-width);
                        x: (svs.visible-width - self.width) / 2;
                        title: root.page-title;
                        description: root.page-description;
                        cards: root.cards;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i) => { root.view-file(i); }
                        toggle-card(title) => { root.toggle-card(title); }
                    }
                }

                if root.page == Page.search: sev := ScrollView {
                    VerticalLayout {
                        width: min(880px, sev.visible-width);
                        x: (sev.visible-width - self.width) / 2;
                        padding: Theme.space-l;
                        spacing: Theme.space-m;
                        alignment: start;
                        Text {
                            text: root.page-title;
                            color: Theme.text-1;
                            font-size: Theme.font-title;
                            font-weight: 700;
                        }

                        for row in root.search-rows: PointerRow {
                            label: row.label;
                            home-label: row.home-label;
                            open => {
                                // A keybind hit lands on the keybinds page
                                // filtered to the query (which is the page
                                // title while searching).
                                if (row.kind == "keybind") {
                                    root.keybinds-search-requested(root.page-title);
                                } else {
                                    root.section-selected(row.home-section);
                                }
                            }
                        }
                        if root.search-rows.length == 0: Text {
                            text: "No matches.";
                            color: Theme.text-2;
                        }
                    }
                }
                if root.page == Page.settings: stv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: settings-page.preferred-height;

                    settings-page := SettingsPage {
                        width: min(880px, stv.visible-width);
                        x: (stv.visible-width - self.width) / 2;
                        app-version: root.app-version;
                        umbriel-missing: root.umbriel-missing;
                        check-updates-on-start: root.check-updates-on-start;
                        update-prereleases: root.update-prereleases;
                        dark-mode: root.dark-mode;
                        config-path: root.config-path;
                        include-files: root.include-files;
                        sync-note: root.sync-note;
                        sync-clean: root.sync-clean;
                        update-note: root.update-note;
                        update-available: root.update-available;
                        update-notes: root.update-notes;
                        update-can-install: root.update-can-install;
                        update-hint: root.update-hint;
                        update-installed: root.update-installed;
                        install-update => { root.install-update(); }
                        restart-app => { root.restart-app(); }
                        view-changelog => { root.view-changelog(); }
                        view-update-notes => { root.view-update-notes(); }
                        upstream-note: root.upstream-note;
                        check-now => { root.check-updates-requested(); }
                        toggled(v) => { root.check-updates-toggled(v); }
                        channel-selected(p) => { root.update-channel-selected(p); }
                        theme-selected(d) => { root.theme-selected(d); }
                        open-url(u) => { root.open-url(u); }
                        relaunch => { root.guide-relaunch(); }
                        sync-schema => { root.sync-schema-requested(); }
                    }
                }

                if root.page == Page.backups: bsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: backups-page.preferred-height;

                    backups-page := BackupsPage {
                        width: min(880px, bsv.visible-width);
                        x: (bsv.visible-width - self.width) / 2;
                        backup-note: root.backup-note;
                        backups: root.backup-choices;
                        selected-backup: root.backup-selected;
                        restore-possible: root.restore-possible;
                        restore-diff: root.restore-diff;
                        action-note: root.backup-action-note;
                        // Two-way: one-way bindings detach once the user
                        // edits a field (the slider bug again) — after
                        // that, a reset or Browse could no longer update
                        // the field.
                        count-text <=> root.backup-count-text;
                        dir-text <=> root.backup-dir-text;
                        backup-now => { root.backup-now(); }
                        backup-chosen(i) => { root.backup-chosen(i); }
                        restore-backup => { root.restore-backup(); }
                        count-chosen(t) => { root.backup-count-chosen(t); }
                        dir-chosen(t) => { root.backup-dir-chosen(t); }
                        browse-location => { root.browse-location(); }
                    }
                }

                // No schema source: an honest empty state instead of a
                // blank page (plain install after create / continue).
                if root.page == Page.section && root.schema-empty: Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-m;
                        padding: Theme.space-xl;

                        Text {
                            text: "No settings to show";
                            color: Theme.text-1;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Umbriel isn't detected, so there are no setting pages. The packaged default config is the schema source.";
                            color: Theme.text-2;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Your config: " + root.config-path;
                            color: Theme.text-2;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        if root.status != "": Text {
                            text: root.status;
                            color: Theme.success;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Install umbriel, then click \"Sync schema\". Its settings will appear here.";
                            color: Theme.text-2;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: center;

                            ActionButton {
                                text: "Install docs";
                                clicked => { root.open-url("https://docs.noctalia.dev/umbriel/"); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── first-run onboarding (plain install state) ──────────
    if root.show-onboarding: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        Rectangle {
            width: min(parent.width - 96px, 520px);
            height: min(parent.height - 96px, 440px);
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-m;
                alignment: start;

                Text {
                    text: "Welcome to Umbriel Config";
                    color: Theme.text-1;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }

                Text {
                    text: root.umbriel-missing
                        ? "Umbriel wasn't detected on this system or no config file exists."
                        : "No config file exists yet, create one to be guided on setting the frequently used settings.";
                    color: Theme.text-1;
                    wrap: TextWrap.word-wrap;
                }

                Text {
                    text: "Right now you can create and edit config.toml, change values, and use include files.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                }

                Text {
                    text: "Without umbriel there are no schema-driven setting pages (the packaged default is the schema source), no defaults shown, and validation is unavailable.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                    visible: root.umbriel-missing;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Install docs";
                        visible: root.umbriel-missing;
                        clicked => { root.open-url("https://docs.noctalia.dev/umbriel/"); }
                    }

                    ActionButton {
                        text: "Continue anyway";
                        clicked => { root.show-onboarding = false; }
                    }

                    ActionButton {
                        text: "Create config.toml";
                        primary: true;
                        clicked => { root.onboarding-create(); }
                    }
                }
            }
        }
    }

    // ── guided setup (after create, schema present) ─────────
    if root.show-guide: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        Rectangle {
            width: min(parent.width - 128px, 760px);
            height: min(parent.height - 96px, 560px);
            border-radius: Theme.radius-l;
            background: Theme.bg-0;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: root.guide-title;
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Suggested defaults are filled in, change anything you like. A value you leave alone is saved as the suggested default.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                }

                gsv := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: guide-page.preferred-height;

                    guide-page := CategoryPage {
                        width: gsv.visible-width;
                        title: "";
                        description: "";
                        cards: root.cards;
                        set-value(k, v) => { root.set-value(k, v); }
                        reset-key(k) => { root.reset-key(k); }
                        set-slider-value(k, v) => { root.set-slider-value(k, v); }
                        slider-preview(k, v) => { root.slider-preview(k, v); }
                        view-file(i) => { root.view-file(i); }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Back";
                        enabled: !root.guide-first;
                        clicked => { root.guide-back(); }
                    }

                    ActionButton {
                        text: root.guide-last ? "Finish and save" : "Next";
                        primary: true;
                        clicked => { root.guide-next(); }
                    }
                }
            }
        }
    }

    // ── save popup: per-key destinations + confirm ──────────
    if root.show-save-popup: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        // Scrim click cancels; the card absorbs its own clicks.
        TouchArea {
            clicked => { root.show-save-popup = false; }
        }

        Rectangle {
            width: min(parent.width - 96px, 640px);
            height: min(parent.height - 96px, 480px);
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: "Save changes";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Pick where each changed setting should live, or reset it.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                }

                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;

                        for entry in root.save-entries: HorizontalLayout {
                            spacing: Theme.space-m;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                Text {
                                    text: entry.label;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: entry.value;
                                    color: Theme.text-2;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            ComboBox {
                                width: 200px;
                                model: root.destinations;
                                current-index: entry.dest-index;
                                selected(v) => { root.save-dest-chosen(entry.key, v); }
                            }

                            ActionButton {
                                text: "Reset";
                                clicked => { root.reset-entry(entry.key); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    ActionButton {
                        text: "Discard all";
                        clicked => { root.discard-all(); }
                    }

                    ActionButton {
                        text: "Cancel";
                        clicked => { root.show-save-popup = false; }
                    }

                    ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => { root.save-confirmed(); }
                    }
                }
            }
        }
    }

    // ── unsaved-changes confirm overlay ──────────────────────
    if root.show-exit-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        Rectangle {
            width: 340px;
            height: 150px;
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: "Unsaved changes";
                    color: Theme.danger;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Quit without saving?";
                    color: Theme.text-2;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;
                    ActionButton {
                        text: "Keep editing";
                        clicked => { root.show-exit-confirm = false; }
                    }

                    ActionButton {
                        text: "Quit anyway";
                        primary: true;
                        clicked => { root.exit-requested(); }
                    }
                }
            }
        }
    }

    // ── what's new / changelog overlay ────────────────────
    if root.show-whatsnew: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {
                root.whatsnew-notice = "";
                root.show-whatsnew = false;
            }
        }

        Rectangle {
            width: min(parent.width - 96px, 560px);
            height: min(parent.height - 96px, 520px);
            background: Theme.bg-1;
            border-radius: Theme.radius-l;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                HorizontalLayout {
                    spacing: Theme.space-m;

                    Text {
                        text: root.whatsnew-title;
                        color: Theme.text-1;
                        font-size: Theme.font-large;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: "Close";
                        clicked => {
                            root.whatsnew-notice = "";
                            root.show-whatsnew = false;
                        }
                    }
                }

                if root.whatsnew-notice != "": Rectangle {
                    background: Theme.bg-0;
                    border-radius: Theme.radius-m;
                    border-width: 1px;
                    border-color: Theme.accent;

                    VerticalLayout {
                        padding: Theme.space-m;
                        spacing: Theme.space-s;

                        Text {
                            text: root.whatsnew-notice;
                            color: Theme.text-1;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                        }

                        HorizontalLayout {
                            alignment: start;

                            ActionButton {
                                text: "Open update settings";
                                primary: true;
                                clicked => {
                                    root.whatsnew-notice = "";
                                    root.show-whatsnew = false;
                                    root.settings-requested();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    background: Theme.bg-0;
                    border-radius: Theme.radius-m;

                    sv := ScrollView {
                        width: 100%;
                        height: 100%;
                        viewport-height: changelog-text.preferred-height + 2 * Theme.space-m;

                        changelog-text := Text {
                            x: Theme.space-m;
                            width: sv.visible-width - 2 * Theme.space-m;
                            y: Theme.space-m;
                            text: root.whatsnew-body;
                            color: Theme.text-1;
                            font-size: Theme.font-small;
                            wrap: TextWrap.word-wrap;
                        }
                    }
                }
            }
        }
    }

    // ── read-only file view popup (opened from a row's "in <file>" badge) ──
    if root.show-file-popup: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        // Clicking the scrim closes the popup…
        TouchArea {
            clicked => { root.show-file-popup = false; }
        }

        Rectangle {
            width: min(parent.width - 96px, 760px);
            height: parent.height - 96px;
            border-radius: Theme.radius-l;
            background: Theme.bg-1;
            border-width: 1px;
            border-color: Theme.border;

            // …the card absorbs its own clicks so it stays open.
            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                HorizontalLayout {
                    spacing: Theme.space-m;

                    VerticalLayout {
                        spacing: 2px;

                        Text {
                            text: root.popup-file-title;
                            color: Theme.text-1;
                            font-size: Theme.font-large;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.popup-file-path;
                            color: Theme.text-2;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.file-stats;
                            color: Theme.text-2;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            visible: root.file-stats != "";
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: "Close";
                        clicked => { root.show-file-popup = false; }
                    }
                }

                ScrollView {
                    width: 100%;
                    height: 100%;
                    // Non-layout child: the viewport must be pinned to the
                    // content's natural size or nothing ever scrolls.
                    viewport-width: file-text.preferred-width;
                    viewport-height: file-text.preferred-height;

                    file-text := Text {
                        text: root.popup-file-text;
                        color: Theme.text-1;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                        wrap: no-wrap;
                        width: self.preferred-width;
                        height: self.preferred-height;
                    }
                }
            }
        }
    }

    // ── shader editor overlay (create, edit, fork, delete own shaders) ──
    // Saving writes the .glsl file; umbriel live-reloads it, which is the
    // preview loop. Assign the shader to an event to see it run.
    if root.shader-editor-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => { root.shader-editor-close(); }
        }

        Rectangle {
            width: min(1400px, parent.width - 48px);
            height: parent.height - 48px;
            x: (parent.width - self.width) / 2;
            y: 24px;
            background: Theme.bg-1;
            border-radius: Theme.radius-l;
            border-width: 1px;
            border-color: Theme.border;

            // Absorb clicks so the scrim underneath doesn't fire.
            TouchArea { }

            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;

                Text {
                    text: root.shader-editor-editing ? "Edit shader" : "New shader";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: Theme.space-m;
                    alignment: start;

                    Text {
                        text: "Name";
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        min-width: 130px;
                        max-width: 260px;
                        horizontal-stretch: 1;
                        text <=> root.shader-editor-name;
                        placeholder-text: "my-effect";
                    }

                    Text {
                        text: ".glsl";
                        color: Theme.text-2;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                // Fluid middle: builder beside preview + code with stretch
                // ratios, so every pane scales with the window instead of
                // competing over fixed pixel sizes. Narrow cards shrink the
                // builder to its minimum; wide ones give every pane room.
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.space-m;

                    ShaderBuilderPanel {
                        min-width: 280px;
                        max-width: 460px;
                        horizontal-stretch: 2;
                        steps: root.shader-steps;
                        kinds: root.shader-step-kinds;
                        locked: root.shader-builder-locked;
                        reset => { root.shader-builder-reset(); }
                        add(k) => { root.shader-step-add(k); }
                        step-remove(i) => { root.shader-step-remove(i); }
                        step-move(i, d) => { root.shader-step-move(i, d); }
                        step-param(i, s, v) => { root.shader-step-param(i, s, v); }
                        step-param-live(i, s, v) => { root.shader-step-param-live(i, s, v); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: Theme.space-m;

                        if root.shader-preview-ready: ShaderPreviewRow {
                            source: root.shader-preview-image;
                            note: root.shader-preview-note;
                            direction-in: root.shader-preview-direction > 0;
                            progress <=> root.shader-preview-progress;
                            events: root.shader-preview-events;
                            event-index <=> root.shader-preview-event;
                            configured-ms: root.shader-preview-length-ms;
                            event-picked(i) => { root.shader-preview-event-picked(i); }
                            scrub(v) => { root.shader-preview-scrub(v); }
                            toggle-direction() => { root.shader-preview-direction-toggled(); }
                        }

                        VerticalLayout {
                            vertical-stretch: 1;
                            spacing: Theme.space-xs;

                            // The editor's keys, where people look for them.
                            HorizontalLayout {
                                spacing: Theme.space-m;

                                Text {
                                    text: "Code";
                                    color: Theme.text-2;
                                    font-size: Theme.font-small;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Tab indents · Shift+Tab outdents · Enter keeps the indent · right-click to cut, copy or paste";
                                    color: Theme.text-2;
                                    font-size: Theme.font-small;
                                    horizontal-alignment: right;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            ShaderCodeEditor {
                                vertical-stretch: 1;
                                min-height: 200px;
                                text <=> root.shader-editor-text;
                                edited(text, anchor, cursor, kind) => {
                                    root.shader-editor-text-changed(text, anchor, cursor, kind);
                                }
                                history(kind) => { root.shader-code-history(kind) }
                                code-key(text, anchor, cursor, kind) => {
                                    root.shader-code-key(text, anchor, cursor, kind)
                                }
                            }
                        }
                    }
                }

                if !root.shader-preview-ready && root.shader-preview-note != "": Text {
                    text: root.shader-preview-note;
                    color: Theme.warning;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }

                if root.shader-editor-note != "": Text {
                    text: root.shader-editor-note;
                    color: Theme.warning;
                    font-size: Theme.font-small;
                    wrap: TextWrap.word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;

                    if root.shader-editor-confirm-close: Text {
                        text: "Discard unsaved changes?";
                        color: Theme.warning;
                        vertical-alignment: center;
                    }

                    if root.shader-editor-confirm-close: ActionButton {
                        text: "Keep editing";
                        clicked => { root.shader-editor-confirm-close = false; }
                    }

                    if root.shader-editor-confirm-close: ActionButton {
                        text: "Discard";
                        clicked => {
                            root.shader-editor-confirm-close = false;
                            root.shader-editor-open = false;
                        }
                    }

                    if !root.shader-editor-confirm-close && root.shader-editor-editing: ActionButton {
                        property <bool> confirming: false;
                        text: !self.confirming ? "Delete" : root.shader-editor-used-by == "" ? "Really delete?" : "Delete? Used by " + root.shader-editor-used-by;
                        clicked => {
                            if (self.confirming) {
                                root.shader-editor-delete();
                            } else {
                                self.confirming = true;
                            }
                        }
                    }

                    if !root.shader-editor-confirm-close: ActionButton {
                        text: "Cancel";
                        clicked => { root.shader-editor-close(); }
                    }

                    if !root.shader-editor-confirm-close: ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => { root.shader-editor-save-request(); }
                    }
                }
            }
        }
    }

    // ── shader "Use for" checklist (the editor's Save step) ──
    if root.shader-editor-open && root.shader-use-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;

        // Absorb clicks: this step is left with Back or Save.
        TouchArea { }

        Rectangle {
            width: min(440px, parent.width - 48px);
            height: use-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg-1;
            border-radius: Theme.radius-l;
            border-width: 1px;
            border-color: Theme.border;

            use-layout := VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-s;

                Text {
                    text: "Use this shader for";
                    color: Theme.text-1;
                    font-size: Theme.font-large;
                    font-weight: 700;
                }

                Text {
                    text: "Ticked events switch to this shader and unticked ones stop using it, as changes you save with the main Save button. Save only keeps the file and changes no assignments.";
                    color: Theme.text-2;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }

                for row in root.shader-use-for: HorizontalLayout {
                    spacing: Theme.space-m;

                    CheckBox {
                        text: row.label;
                        checked: row.checked;
                        toggled => { row.checked = self.checked; }
                    }

                    Text {
                        text: row.current;
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-s;
                    padding-top: Theme.space-s;

                    ActionButton {
                        text: "Back";
                        clicked => { root.shader-use-open = false; }
                    }

                    // Keep the file, leave every assignment as it is.
                    ActionButton {
                        text: "Save only";
                        clicked => {
                            root.shader-use-open = false;
                            root.shader-editor-save(false);
                        }
                    }

                    ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.shader-use-open = false;
                            root.shader-editor-save(true);
                        }
                    }
                }
            }
        }
    }

    // ── color picker popup (opened from a row's color swatch) ──
    // Last overlay so it also rides above the guide walk, whose
    // appearance step has color rows of its own. Drags only move the
    // card's draft; Apply writes (a no-op when the color didn't
    // change) and closes, Close/scrim discards.
    if PickerState.open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea {
            clicked => { PickerState.open = false; }
        }

        ColorPickerCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            apply(text) => {
                if (text != PickerState.hex) {
                    root.set-value(PickerState.key, text);
                }
                PickerState.open = false;
            }
        }
    }
}
