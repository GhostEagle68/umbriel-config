// Shared widgets: buttons, nav rows, edit fields, and the setting-row
// renderer used by every page.

import { Theme } from "theme.slint";
import { ComboBox, LineEdit, Slider, Switch } from "std-widgets.slint";
import {
    ColorMath,
    Hsva,
    NoteLine,
    NotesCard,
    PickerState,
    SettingRow,
    ValueKind,
} from "types.slint";

// Small token-driven button; std-widgets are avoided so the whole shell
// carries one identity.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    width: label.width + 28px;
    border-radius: Theme.radius-m;
    background: !root.enabled ? Theme.bg-2
        : ta.has-hover ? (root.primary ? Theme.primary-hover : Theme.border)
        : (root.primary ? Theme.primary : Theme.bg-2);
    opacity: root.enabled ? 1.0 : 0.5;
    animate background { duration: 100ms; }

    label := Text {
        text: root.text;
        // The primary fill is light on dark (and dark on light); a
        // disabled primary sits on the neutral card color and must stay
        // readable in both designs.
        color: root.primary && root.enabled ? Theme.on-primary : Theme.text-1;
        font-weight: root.primary ? 600 : 400;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One sidebar row: a page, a collapsible group header (icon, label,
// chevron), or a page under an open header, drawn on a tree line. The
// selected row is a soft filled pill.
export component NavRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected: false;
    in property <int> count: 0;
    in property <bool> header: false;
    in property <bool> expanded: false;
    in property <bool> child: false;
    // Last child of its group: the tree line stops at this row.
    in property <bool> last: false;
    callback selected-fired();

    height: 34px;

    // Tree line down the open group, under the header's icon.
    if root.child: Rectangle {
        x: 18px;
        y: 0;
        width: 1px;
        height: root.last ? parent.height / 2 : parent.height;
        background: Theme.border;
    }

    if root.child: Rectangle {
        x: 18px;
        y: parent.height / 2;
        width: 8px;
        height: 1px;
        background: Theme.border;
    }

    pill := Rectangle {
        x: root.child ? 30px : 0;
        width: parent.width - self.x;
        border-radius: Theme.radius-m;
        background: root.selected ? Theme.bg-2 : ta.has-hover ? Theme.bg-1 : transparent;
        animate background { duration: 100ms; }

        HorizontalLayout {
            padding-left: root.child ? Theme.space-s : 10px;
            padding-right: 10px;
            spacing: 10px;

            if root.has-icon: Image {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                source: root.icon;
                colorize: root.selected ? Theme.text-1 : Theme.text-2;
            }

            Text {
                text: root.label;
                color: root.selected || (root.header && root.expanded) ? Theme.text-1 : Theme.text-2;
                font-weight: root.selected ? 600 : 400;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.count > 0: Text {
                text: root.count;
                color: Theme.accent;
                font-size: Theme.font-small;
                font-weight: 600;
                vertical-alignment: center;
            }

            if root.header: Image {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/icons/chevron-down.svg");
                colorize: Theme.text-2;
                transform-rotation: root.expanded ? 0deg : -90deg;
                animate transform-rotation { duration: 150ms; }
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected-fired(); }
    }
}

// A "setting lives in file X" pointer row used by section and search pages.
export component PointerRow inherits Rectangle {
    in property <string> label;
    in property <string> home-label;
    callback open();

    height: 32px;
    border-radius: Theme.radius-s;
    background: ta.has-hover ? Theme.bg-2 : transparent;

    ta := TouchArea {
        clicked => { root.open(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;

        Text {
            text: root.label;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "in " + root.home-label + " — open";
            color: Theme.accent;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
}

// LineEdit that commits on Enter or when focus leaves with edits pending.
// `draft` holds the working text so blur can compare against the stored
// value and only commits real changes. Wrapped in a Rectangle (rather than
// inheriting LineEdit directly) so an `invalid` edit can get a visible red
// outline without reaching into the native widget's own styling.
export component DraftEdit inherits Rectangle {
    in property <string> value;
    in property <bool> invalid: false;
    callback commit(string);

    property <string> draft: root.value;
    changed value => { root.draft = root.value; }

    height: max(30px, inner.preferred-height);
    border-width: root.invalid ? 1px : 0px;
    border-color: Theme.danger;
    border-radius: Theme.radius-s;

    inner := LineEdit {
        width: 100%;
        height: 100%;
        // Shown only while text is truly empty — a real "" value (e.g.
        // input.keyboard.layout, meaning "system default") reads as
        // intentional rather than looking like a broken/blank box. The
        // "—" unset placeholder is literal text, not an empty string, so
        // this never fires for an unset row.
        placeholder-text: "empty";
        text <=> root.draft;
        accepted(t) => { root.commit(t); }
        changed has-focus => {
            if (!self.has-focus && root.draft != root.value) {
                root.commit(root.draft);
            }
        }
    }
}

// Page title and description, with the page's actions on the right.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: Theme.space-l;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.space-xs;

        Text {
            text: root.title;
            color: Theme.text-1;
            font-size: Theme.font-title;
            font-weight: 700;
        }

        if root.description != "": Text {
            text: root.description;
            color: Theme.text-2;
            wrap: TextWrap.word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            spacing: Theme.space-s;

            @children
        }
    }
}

// A section title; collapsible ones toggle on click and show a chevron.
export component SectionHeader inherits Rectangle {
    in property <string> title;
    // Grey text after the title: a count, or where things are kept.
    in property <string> caption;
    in property <bool> collapsible: false;
    in property <bool> expanded: true;
    callback toggle();
    height: 28px;

    ta := TouchArea {
        enabled: root.collapsible;
        mouse-cursor: root.collapsible ? pointer : default;
        clicked => { root.toggle(); }
    }

    HorizontalLayout {
        spacing: Theme.space-s;

        Text {
            text: root.title;
            color: Theme.text-1;
            font-size: Theme.font-large;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.caption != "": Text {
            text: root.caption;
            color: Theme.text-2;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.collapsible: Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../assets/icons/chevron-down.svg");
            colorize: ta.has-hover ? Theme.text-1 : Theme.text-2;
            transform-rotation: root.expanded ? 0deg : -90deg;
            animate transform-rotation { duration: 150ms; }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

// One item of a list that opens in place (a monitor, a rule): icon,
// title and grey caption, the item's own actions, then a chevron. The
// whole row toggles; its fields go underneath, indented.
export component ExpandRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> title;
    in property <string> caption;
    in property <bool> expanded;
    callback toggle();
    min-height: 56px;
    border-radius: Theme.radius-m;
    background: ta.has-hover ? Theme.bg-1 : transparent;
    animate background { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        padding-top: Theme.space-s;
        padding-bottom: Theme.space-s;
        spacing: Theme.space-m;

        // The row grows with its caption, so center in a layout.
        if root.has-icon: VerticalLayout {
            alignment: center;

            Image {
                width: 18px;
                height: 18px;
                source: root.icon;
                colorize: Theme.text-2;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.text-1;
                font-weight: root.expanded ? 600 : 400;
                overflow: elide;
            }

            if root.caption != "": Text {
                text: root.caption;
                color: Theme.text-2;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: Theme.space-s;

                @children
            }
        }

        VerticalLayout {
            alignment: center;

            Image {
                width: 16px;
                height: 16px;
                source: @image-url("../assets/icons/chevron-down.svg");
                colorize: Theme.text-2;
                transform-rotation: root.expanded ? 180deg : 0deg;
                animate transform-rotation { duration: 150ms; }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }
}

// One preference: title and grey subtitle on the left, its controls on
// the right, a hairline underneath.
export component PrefRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <color> subtitle-color: Theme.text-2;
    min-height: 56px;

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        padding-top: Theme.space-s;
        padding-bottom: Theme.space-s;
        spacing: Theme.space-l;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.text-1;
                wrap: TextWrap.word-wrap;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: root.subtitle-color;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: Theme.space-s;

                @children
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }
}

// One setting row, the PrefRow layout with the setting's own subtitle:
// changed dot, "New" pill and the file that sets it by the label; the
// hint (or the error) underneath; the editor and a reset icon on the
// right. Shared by the category, outputs, rules and guide pages.
export component SettingRowView inherits Rectangle {
    in property <SettingRow> setting;
    callback set-value(string, string);
    callback reset-key(string);
    callback set-slider-value(string, float);
    callback slider-preview(string, float);
    callback view-file(int);
    min-height: 56px;

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        padding-top: Theme.space-s;
        padding-bottom: Theme.space-s;
        spacing: Theme.space-l;
        opacity: setting.available ? 0.55 : 1.0;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                if setting.changed: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.accent;
                    }
                }

                Text {
                    text: setting.label;
                    color: Theme.text-1;
                    wrap: TextWrap.word-wrap;
                    vertical-alignment: center;
                }

                if setting.is-new: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: new-text.preferred-width + 12px;
                        height: 18px;
                        border-radius: 9px;
                        background: Theme.accent-soft;

                        new-text := Text {
                            text: "New";
                            color: Theme.accent;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                }

                // The file that sets this key: click to read it.
                if setting.home >= 0: Text {
                    text: "in " + setting.home-label;
                    color: badge-ta.has-hover ? Theme.accent : Theme.text-2;
                    font-size: Theme.font-small;
                    vertical-alignment: center;

                    badge-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.view-file(setting.home); }
                    }
                }
            }

            if setting.error != "": Text {
                text: setting.error;
                color: Theme.danger;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }

            if setting.error == "" && setting.hint != "": Text {
                text: setting.hint;
                color: Theme.text-2;
                font-size: Theme.font-small;
                wrap: TextWrap.word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: Theme.space-s;
                alignment: end;

                if setting.kind == ValueKind.boolean: Switch {
                    checked: setting.checked;
                    // A click detaches `checked` from the binding above,
                    // so a reset or a rejected write must push it back.
                    property <bool> watched: setting.checked;
                    changed watched => {
                        self.checked = setting.checked;
                    }
                    toggled => { root.set-value(setting.key, self.checked ? "true" : "false"); }
                }
                if setting.kind == ValueKind.integer || setting.kind == ValueKind.float: HorizontalLayout {
                    spacing: Theme.space-m;
                    alignment: end;

                    if setting.max > setting.min && !setting.available: Slider {
                        width: 180px;
                        minimum: setting.min;
                        maximum: setting.max;
                        value: setting.value.to-float();
                        // A drag detaches the slider's value from the
                        // binding above, so watch the row and push
                        // resets/external edits back into the thumb.
                        property <string> watched: setting.value;
                        changed watched => {
                            self.value = setting.value.to-float();
                        }
                        changed(v) => { root.slider-preview(setting.key, v); }
                        released(v) => { root.set-slider-value(setting.key, v); }
                    }

                    DraftEdit {
                        width: 96px;
                        value: setting.preview == "" ? setting.value : setting.preview;
                        invalid: setting.error != "";
                        commit(t) => { root.set-value(setting.key, t); }
                    }
                }
                if setting.kind == ValueKind.color: HorizontalLayout {
                    spacing: Theme.space-s;
                    alignment: end;

                    // Click opens the picker popup for this key; the
                    // app-window hosts the overlay, the swatch only aims it.
                    swatch := TouchArea {
                        width: 30px;
                        mouse-cursor: pointer;

                        Rectangle {
                            border-radius: Theme.radius-s;
                            border-width: 1px;
                            border-color: swatch.has-hover ? Theme.accent : Theme.border;
                            background: setting.swatch;
                        }

                        clicked => {
                            PickerState.key = setting.key;
                            PickerState.hex = setting.value;
                            PickerState.open = true;
                        }
                    }

                    DraftEdit {
                        width: 130px;
                        value: setting.value;
                        invalid: setting.error != "";
                        commit(t) => { root.set-value(setting.key, t); }
                    }
                }
                if setting.kind == ValueKind.curve || setting.kind == ValueKind.choice: ComboBox {
                    width: 200px;
                    model: setting.choices;
                    current-value: setting.value;
                    selected(v) => { root.set-value(setting.key, v); }
                }
                if setting.kind == ValueKind.list || setting.kind == ValueKind.text: DraftEdit {
                    width: 240px;
                    value: setting.value;
                    invalid: setting.error != "";
                    commit(t) => { root.set-value(setting.key, t); }
                }
                // A big-but-not-closed vocabulary (hot-corner actions, rule
                // outputs): a dropdown of the known values plus a free-text
                // box for anything else valid. Both read `setting.value`, so
                // picking a dropdown item immediately fills the box too —
                // there is only ever one value, shown two ways.
                if setting.kind == ValueKind.open-choice: HorizontalLayout {
                    spacing: Theme.space-s;
                    alignment: end;

                    ComboBox {
                        // Wide: Slint's ComboBox popup width follows the
                        // closed box's own width, and some known values
                        // (e.g. hot-corner actions) run past 35 characters;
                        // a narrow box truncates the list itself.
                        width: 260px;
                        model: setting.choices;
                        current-value: setting.value;
                        selected(v) => { root.set-value(setting.key, v); }
                    }

                    DraftEdit {
                        width: 160px;
                        value: setting.value;
                        invalid: setting.error != "";
                        commit(t) => { root.set-value(setting.key, t); }
                    }
                }
                if setting.kind == ValueKind.unset: Text {
                    text: setting.value;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }

                // One reset for every editable kind: the changed dot
                // lights up for any kind, so every kind needs a way back.
                if setting.changed && setting.kind != ValueKind.unset: Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.radius-s;
                    background: reset-ta.has-hover ? Theme.bg-2 : transparent;

                    Image {
                        width: 15px;
                        height: 15px;
                        source: @image-url("../assets/icons/reset.svg");
                        colorize: reset-ta.has-hover ? Theme.text-1 : Theme.text-2;
                    }

                    reset-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.reset-key(setting.key); }
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }
}

// Color picker popup card for the key in PickerState: saturation/value
// square over hue and alpha bars, live preview. Dragging only moves the
// popup's own h/s/v/a draft — nothing is written until Apply (which
// hands "#RRGGBBAA" to the overlay for the row's regular set-value
// path); Close/scrim discards. Only instantiated while
// PickerState.open, so the properties below re-derive from
// PickerState.hex on every open.
export component ColorPickerCard inherits Rectangle {
    width: 320px;
    height: body.preferred-height;
    border-radius: Theme.radius-l;
    background: Theme.bg-1;
    border-width: 1px;
    border-color: Theme.border;

    // Emitted with the drafted hex when Apply is pressed.
    callback apply(string);

    property <Hsva> parsed: ColorMath.to-hsva(PickerState.hex);
    // h in degrees 0..360, the rest 0..1.
    property <float> h: parsed.h;
    property <float> s: parsed.s;
    property <float> v: parsed.v;
    property <float> a: parsed.a;

    // Absorb card clicks so the scrim underneath doesn't close the popup.
    TouchArea { }

    body := VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;

        HorizontalLayout {
            spacing: Theme.space-m;

            Text {
                text: "Edit " + PickerState.key;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            ActionButton {
                text: "Close";
                clicked => { PickerState.open = false; }
            }

            ActionButton {
                text: "Apply";
                primary: true;
                clicked => { root.apply(ColorMath.to-hex(root.h, root.s, root.v, root.a)); }
            }
        }

        // Saturation rightward, value downward, for the current hue.
        Rectangle {
            height: 170px;
            clip: true;
            border-radius: Theme.radius-s;
            border-width: 1px;
            border-color: Theme.border;

            Rectangle {
                background: ColorMath.to-color(root.h, 1.0, 1.0, 1.0);
            }

            Rectangle {
                background: @linear-gradient(90deg, #FFFFFF, #FFFFFF00);
            }

            Rectangle {
                background: @linear-gradient(180deg, #00000000, #000000);
            }

            Rectangle {
                width: 14px;
                height: 14px;
                x: root.s * (parent.width - self.width);
                y: (1.0 - root.v) * (parent.height - self.height);
                border-radius: 7px;
                border-width: 2px;
                border-color: white;
            }

            TouchArea {
                // `move` also fires on bare hover; track the pointer only
                // while a button is actually held.
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down
                        || (ev.kind == PointerEventKind.move && self.pressed)) {
                        root.s = clamp(self.mouse-x / parent.width, 0.0, 1.0);
                        root.v = clamp(1.0 - self.mouse-y / parent.height, 0.0, 1.0);
                    }
                }
            }
        }

        // Hue strip.
        Rectangle {
            height: 16px;
            border-radius: Theme.radius-s;
            background: @linear-gradient(90deg, #FF0000 0%, #FFFF00 17%, #00FF00 33%, #00FFFF 50%, #0000FF 67%, #FF00FF 83%, #FF0000 100%);

            Rectangle {
                width: 12px;
                height: parent.height;
                x: (root.h / 360.0) * (parent.width - self.width);
                border-radius: 4px;
                background: white;
                border-width: 1px;
                border-color: #000000;
            }

            TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down
                        || (ev.kind == PointerEventKind.move && self.pressed)) {
                        root.h = clamp(self.mouse-x / parent.width, 0.0, 1.0) * 360.0;
                    }
                }
            }
        }

        // Alpha strip: full color fading into the card background.
        Rectangle {
            height: 16px;
            border-radius: Theme.radius-s;
            background: @linear-gradient(90deg, ColorMath.to-color(root.h, root.s, root.v, 0.0), ColorMath.to-color(root.h, root.s, root.v, 1.0));

            Rectangle {
                width: 12px;
                height: parent.height;
                x: root.a * (parent.width - self.width);
                border-radius: 4px;
                background: white;
                border-width: 1px;
                border-color: #000000;
            }

            TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down
                        || (ev.kind == PointerEventKind.move && self.pressed)) {
                        root.a = clamp(self.mouse-x / parent.width, 0.0, 1.0);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-s;
                border-width: 1px;
                border-color: Theme.border;
                background: ColorMath.to-color(root.h, root.s, root.v, root.a);
            }

            Text {
                text: ColorMath.to-hex(root.h, root.s, root.v, root.a);
                font-family: Theme.font-mono;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }
    }
}

// One line of release notes (see NoteLine for the kinds). Placed by
// hand rather than with layouts: a wrapping Text inside a layout in a
// repeater is often measured a line short, while its own
// preferred-height is right, so the height here comes from that.
component NoteLineView inherits Rectangle {
    in property <NoteLine> line;
    property <bool> prose: line.kind >= 2;
    property <bool> bullet: line.kind == 2 || line.kind == 3;
    property <color> tone: line.tone == 1 ? Theme.accent
        : line.tone == 2 ? Theme.success
        : line.tone == 3 ? Theme.warning
        : line.tone == 4 ? Theme.danger
        : Theme.text-2;
    property <length> indent: line.kind == 3 ? 18px : line.kind == 4 ? 14px : 0px;
    property <length> text-x: indent + (bullet ? 6px + Theme.space-s : 0px);
    property <length> top: line.kind == 0 ? Theme.space-l : line.kind == 1 ? Theme.space-m : 0px;
    property <length> gap: line.kind == 1 || line.kind == 4 || line.kind == 5 ? Theme.space-xs : 2px;

    height: top + gap + (line.kind == 0 ? chip.height
        : line.kind == 1 ? scope.preferred-height
        : body.preferred-height + (line.meta != "" ? meta.preferred-height : 0px));

    // Group heading: a tinted chip.
    chip := Rectangle {
        visible: line.kind == 0;
        x: 0px;
        y: top;
        width: chip-text.preferred-width + 20px;
        height: chip-text.preferred-height + 6px;
        border-radius: self.height / 2;
        background: tone.with-alpha(0.16);

        chip-text := Text {
            text: line.kind == 0 ? line.text : "";
            color: tone;
            font-size: Theme.font-small;
            font-weight: 700;
        }
    }

    // Scope: a bold label with a hairline running to the edge.
    scope := Text {
        visible: line.kind == 1;
        x: 0px;
        y: top;
        text: line.kind == 1 ? line.text : "";
        color: Theme.text-1;
        font-size: Theme.font-body;
        font-weight: 700;
    }

    Rectangle {
        visible: line.kind == 1;
        x: scope.preferred-width + Theme.space-m;
        y: top + scope.preferred-height / 2;
        width: max(0px, parent.width - self.x);
        height: 1px;
        background: Theme.border;
    }

    // The marker on the first line: a dot in the group's color, or a
    // ring for a sub-bullet.
    Rectangle {
        visible: bullet;
        x: indent;
        y: top + 6px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: line.kind == 2 ? tone : transparent;
        border-width: line.kind == 3 ? 1px : 0px;
        border-color: Theme.text-2;
    }

    body := Text {
        visible: prose;
        x: text-x;
        y: top;
        width: parent.width - self.x;
        height: self.preferred-height;
        text: prose ? line.text : "";
        color: line.kind == 2 ? Theme.text-1 : Theme.text-2;
        font-size: line.kind == 4 ? Theme.font-small : Theme.font-body;
        wrap: word-wrap;
    }

    meta := Text {
        visible: line.meta != "";
        x: text-x;
        y: top + body.preferred-height;
        text: line.meta;
        color: Theme.text-2;
        font-size: Theme.font-small;
        font-family: Theme.font-mono;
    }
}

// Release notes, newest first: one card per release, a pill naming its
// channel, and each change group as a tinted chip.
export component ReleaseNotes inherits VerticalLayout {
    in property <[NotesCard]> cards;
    property <length> pad: 20px;

    alignment: start;
    spacing: Theme.space-l;

    for card in root.cards: Rectangle {
        property <color> channel: card.badge == "Canary" ? Theme.warning
            : card.badge == "Stable" ? Theme.success
            : Theme.accent;

        border-radius: Theme.radius-l;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.bg-0;

        // A short bar in the channel's color beside the title.
        Rectangle {
            x: 0px;
            y: pad + 4px;
            width: 3px;
            height: 22px;
            border-radius: 1.5px;
            background: channel;
        }

        VerticalLayout {
            padding: pad;
            spacing: 3px;

            HorizontalLayout {
                spacing: Theme.space-m;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;

                    Text {
                        text: card.title;
                        color: Theme.text-1;
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }

                    if card.date != "": Text {
                        text: card.date;
                        color: Theme.text-2;
                        font-size: Theme.font-small;
                    }
                }

                if card.badge != "": VerticalLayout {
                    alignment: start;

                    Rectangle {
                        border-radius: 11px;
                        background: channel.with-alpha(0.16);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 3px;
                            padding-bottom: 3px;

                            Text {
                                text: card.badge;
                                color: channel;
                                font-size: Theme.font-small;
                                font-weight: 700;
                            }
                        }
                    }
                }
            }

            for line in card.lines: NoteLineView {
                line: line;
            }
        }
    }
}
