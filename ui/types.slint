// Shared structs, enums, and globals crossing page boundaries. The
// Rust side sees the same generated names no matter which file
// declares them.

// A picked color: h in degrees 0..360, s/v/a in 0..1. `ok` is false
// when the source hex was unparseable (channels fall back to opaque
// black); the picker ignores it on init.
export struct Hsva {
    h: float,
    s: float,
    v: float,
    a: float,
    ok: bool,
}

// Which color key the popup edits. Set by a row's swatch, read by the
// app-window overlay. A global rather than callbacks so every page
// that renders SettingRowView — category, outputs, rules, guide —
// gets the picker with no per-page plumbing.
export global PickerState {
    in-out property <bool> open: false;
    in-out property <string> key;
    in-out property <string> hex;
}

// Pure hex ⇄ HSVA math for the picker; implemented in Rust
// (rows.rs installs the handlers) because hex parsing and formatting
// are not feasible in Slint bindings. Declared pure so bindings may
// call them.
export global ColorMath {
    pure callback to-hsva(string) -> Hsva;
    pure callback to-hex(float, float, float, float) -> string;
    pure callback to-color(float, float, float, float) -> color;
}

export struct SectionRow {
    label: string,
    home-label: string,
    home-section: string,
    // "" = a setting, "page" = a whole page, "keybind" = a chord that
    // opens the keybinds page pre-filtered to the query.
    kind: string,
}
export enum ValueKind { unset, boolean, integer, float, text, list, choice, color, curve, open-choice }

export struct SettingRow {
    label: string,
    value: string,
    key: string,
    kind: ValueKind,
    choices: [string],
    swatch: brush,
    checked: bool,
    hint: string,
    min: float,
    max: float,
    // Chain index of the file that owns this key (-1 = not set anywhere).
    home: int,
    home-label: string,
    // Differs from the on-disk saved value.
    changed: bool,
    // True while the key isn't set in any file yet.
    available: bool,
    // Added by an umbriel update or the last schema sync.
    is-new: bool,
    // Live slider feedback for the text box; empty when not dragging.
    preview: string,
    // Set when the last edit to this row was rejected; empty otherwise.
    error: string,
}

export struct SettingsCard {
    title: string,
    // Stable identity for the expansion map; also what toggle-card
    // sends back.
    key: string,
    // Collapsible cards remember their state across rebuilds.
    expanded: bool,
    rows: [SettingRow],
}

// One Keybinds list row. Header rows carry the group title in `chord`,
// plus `expanded` and `count`; bind rows point at the merged user bind
// (`index`, -1 for a compositor default).
export struct KeybindRow {
    chord: string,
    summary: string,
    extras: string,
    source: string,
    is-header: bool,
    is-user: bool,
    shadowing: bool,
    is-command: bool,
    expanded: bool,
    count: int,
    index: int,
}

// An action picker entry; `value` is what gets picked (spawn appears
// twice: as "launch an app" and "run a shell command").
export struct ActionChoice {
    name: string,
    summary: string,
    value: string,
}

export struct AppChoice {
    name: string,
    command: string,
}

// How the keybind editor asks for an action's parameter.
export enum ParamInput { none, app, command, choice, text }
export struct MonitorCard {
    name: string,
    info: string,
    connected: bool,
    configured: bool,
    removable: bool,
    expanded: bool,
    rows: [SettingRow],
}

export struct RuleCard {
    title: string,
    index: int,
    // Chain document this rule lives in (main = include count).
    file: int,
    file-label: string,
    expanded: bool,
    match-rows: [SettingRow],
    setting-rows: [SettingRow],
}

export struct ShaderInfo {
    name: string,
    // Value written into a config (relative or absolute path).
    value: string,
    source: string,
    description: string,
    // Why umbriel would reject the file; empty when usable.
    invalid: string,
    // Absolute file location; is-own marks the user's own shaders
    // (config directory, outside the community clone) — the only ones
    // the editor opens for in-place editing and deletion.
    path: string,
    is-own: bool,
    // Events assigned this shader ("Windows out, Overview"), or "".
    used-by: string,
}

// A code-editor key's result: the new text and the selection to restore
// (UTF-8 byte offsets, as TextInput reports them).
export struct CodeEdit {
    text: string,
    anchor: int,
    cursor: int,
}

// One effect-builder step with its (up to three) parameters, padded
// into a fixed shape for the model.
export struct ShaderStep {
    index: int,
    label: string,
    p1-label: string,
    p1-value: float,
    p1-min: float,
    p1-max: float,
    // Decimal places the value is shown and written with.
    p1-decimals: int,
    p2-label: string,
    p2-value: float,
    p2-min: float,
    p2-max: float,
    p2-decimals: int,
    p3-label: string,
    p3-value: float,
    p3-min: float,
    p3-max: float,
    p3-decimals: int,
    p-count: int,
}

// One row of the editor's "Use for" checklist on Save.
export struct ShaderUse {
    label: string,
    // What the event uses now ("uses reveal", "uses this shader"), or "".
    current: string,
    checked: bool,
}

// One animation event's shader assignment row.
export struct ShaderAssignment {
    // Dotted schema key, e.g. animation.windows_in.shader.
    key: string,
    label: string,
    // Dropdown: index 0 = built-in, then shaders in order, then (when
    // the value matches no library shader) one trailing entry for it.
    choices: [string],
    // Index into choices of the event's current shader.
    current: int,
    // The raw current value, for the warning.
    current-value: string,
    // Why umbriel won't load the value ("file not found", ...), or "".
    warning: string,
}

// One changed key, as shown in the save popup.
export struct SaveEntry {
    key: string,
    label: string,
    value: string,
    dest-label: string,
    dest-index: int,
}

// One sidebar entry: a dimmed header (group caption) or a page row.
// `label` is what's shown; `id` is what navigation keys off.
export struct SectionNav {
    label: string,
    id: string,
    new-count: int,
    is-header: bool,
}
