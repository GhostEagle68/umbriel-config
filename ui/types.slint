// Shared structs, enums, and globals crossing page boundaries. The
// Rust side sees the same generated names no matter which file
// declares them.

// A picked color: h in degrees 0..360, s/v/a in 0..1. `ok` is false
// when the source hex was unparseable (channels fall back to opaque
// black); the picker ignores it on init.
export struct Hsva {
    h: float,
    s: float,
    v: float,
    a: float,
    ok: bool,
}

// Which color key the popup edits. Set by a row's swatch, read by the
// app-window overlay. A global rather than callbacks so every page
// that renders SettingRowView — category, outputs, rules, guide —
// gets the picker with no per-page plumbing.
export global PickerState {
    in-out property <bool> open: false;
    in-out property <string> key;
    in-out property <string> hex;
}

// Pure hex ⇄ HSVA math for the picker; implemented in Rust
// (rows.rs installs the handlers) because hex parsing and formatting
// are not feasible in Slint bindings. Declared pure so bindings may
// call them.
export global ColorMath {
    pure callback to-hsva(string) -> Hsva;
    pure callback to-hex(float, float, float, float) -> string;
    pure callback to-color(float, float, float, float) -> color;
}

export struct SectionRow {
    label: string,
    home-label: string,
    home-section: string,
    // "" = a setting, "page" = a whole page, "keybind" = a chord that
    // opens the keybinds page pre-filtered to the query.
    kind: string,
    // A setting umbriel added that hasn't been seen yet.
    is-new: bool,
}
export enum ValueKind { unset, boolean, integer, float, text, list, choice, color, curve, open-choice }

export struct SettingRow {
    label: string,
    value: string,
    key: string,
    kind: ValueKind,
    choices: [string],
    swatch: brush,
    checked: bool,
    hint: string,
    min: float,
    max: float,
    // Chain index of the file that owns this key (-1 = not set anywhere).
    home: int,
    home-label: string,
    // Differs from the on-disk saved value.
    changed: bool,
    // True while the key isn't set in any file yet.
    available: bool,
    // Added by an umbriel update or the last schema sync.
    is-new: bool,
    // Live slider feedback for the text box; empty when not dragging.
    preview: string,
    // Set when the last edit to this row was rejected; empty otherwise.
    error: string,
}

export struct SettingsCard {
    title: string,
    // Stable identity for the expansion map; also what toggle-card
    // sends back.
    key: string,
    // Collapsible cards remember their state across rebuilds.
    expanded: bool,
    rows: [SettingRow],
}

// One Keybinds list row. Header rows carry the group title in `chord`,
// plus `expanded` and `count`; bind rows point at the merged user bind
// (`index`, -1 for a compositor default).
export struct KeybindRow {
    chord: string,
    summary: string,
    extras: string,
    source: string,
    is-header: bool,
    is-user: bool,
    shadowing: bool,
    is-command: bool,
    expanded: bool,
    count: int,
    index: int,
}

// An action picker entry; `value` is what gets picked (spawn appears
// twice: as "launch an app" and "run a shell command").
export struct ActionChoice {
    name: string,
    summary: string,
    value: string,
}

export struct AppChoice {
    name: string,
    command: string,
}

// How the keybind editor asks for an action's parameter.
export enum ParamInput { none, app, command, choice, text }
export struct MonitorCard {
    name: string,
    info: string,
    connected: bool,
    configured: bool,
    removable: bool,
    expanded: bool,
    rows: [SettingRow],
}

export struct RuleCard {
    title: string,
    index: int,
    // Chain document this rule lives in (main = include count).
    file: int,
    file-label: string,
    expanded: bool,
    match-rows: [SettingRow],
    setting-rows: [SettingRow],
}

export struct ShaderInfo {
    name: string,
    // Value written into a config (relative or absolute path).
    value: string,
    source: string,
    description: string,
    // Why umbriel would reject the file; empty when usable.
    invalid: string,
    // Absolute file location; is-own marks the user's own shaders
    // (config directory, outside the community clone) — the only ones
    // the editor opens for in-place editing and deletion.
    path: string,
    is-own: bool,
    // Events assigned this shader ("Windows out, Overview"), or "".
    used-by: string,
    // A still frame mid-animation, once the preview worker has drawn it.
    thumb: image,
    has-thumb: bool,
    // Position within its section (yours, or built-in and community),
    // for laying out the grid.
    slot: int,
    // What it draws ("Animation", "Cursor", ...), its place in the
    // kinds, and its position among the same kind in its section (the
    // picker shows one kind).
    kind: string,
    kind-index: int,
    kind-slot: int,
}

// How many shaders of one kind each library section holds.
export struct KindCount {
    own: int,
    other: int,
}

// A code-editor key's result: the new text and the selection to restore
// (UTF-8 byte offsets, as TextInput reports them).
export struct CodeEdit {
    text: string,
    anchor: int,
    cursor: int,
}

// One effect-builder step with its (up to three) parameters, padded
// into a fixed shape for the model.
export struct ShaderStep {
    index: int,
    label: string,
    p1-label: string,
    p1-value: float,
    p1-min: float,
    p1-max: float,
    // Decimal places the value is shown and written with.
    p1-decimals: int,
    p2-label: string,
    p2-value: float,
    p2-min: float,
    p2-max: float,
    p2-decimals: int,
    p3-label: string,
    p3-value: float,
    p3-min: float,
    p3-max: float,
    p3-decimals: int,
    p-count: int,
}

// One row of the editor's "Use for" checklist on Save.
export struct ShaderUse {
    label: string,
    // What the event uses now ("uses reveal", "uses this shader"), or "".
    current: string,
    checked: bool,
}

// One animation event's shader assignment row.
export struct ShaderAssignment {
    // The slot: an animation event ("windows_in") or "effects.<kind>".
    key: string,
    label: string,
    // Which kind of shader it takes (index into the kinds).
    kind: int,
    // The event's shader: 0 none, 1.. library shader (index + 1), past
    // the library a value that matches none of it.
    current: int,
    current-name: string,
    // The raw current value, for the warning.
    current-value: string,
    // Why umbriel won't load the value ("file not found", ...), or "".
    warning: string,
}

// One changed key, as shown in the save popup.
export struct SaveEntry {
    key: string,
    label: string,
    value: string,
    dest-label: string,
    dest-index: int,
}

// One sidebar entry: a collapsible group header or a page row.
// `label` is what's shown; `id` is what navigation keys off (a header's
// is `group:<group>`, which toggles it). `group` picks the icon; `child`
// rows sit under an open header, `last` ends its tree line.
export struct SectionNav {
    label: string,
    id: string,
    new-count: int,
    is-header: bool,
    group: string,
    expanded: bool,
    child: bool,
    last: bool,
}

// One line of release notes, split from their markdown in Rust
// (changelog.rs `blocks`); Slint draws markdown only from literals.
// kind: 0 = group heading ("Fixed"), 1 = scope ("Schema"),
// 2 = bullet, 3 = sub-bullet, 4 = a bullet's detail text,
// 5 = paragraph. tone: the group's color (0 neutral, 1 features,
// 2 fixes, 3 highlights, 4 removals). meta: a bullet's date and
// commit, muted.
export struct NoteLine {
    kind: int,
    tone: int,
    text: string,
    meta: string,
}

// One release in the notes view. badge: "Canary", "Beta", "Stable",
// or "" for none.
export struct NotesCard {
    title: string,
    date: string,
    badge: string,
    lines: [NoteLine],
}

// Home page: a clickable line that opens a page (an unsaved change, or
// a page with newly synced settings).
export struct HomeLink {
    label: string,
    detail: string,
    page-id: string,
}

// Home desktop drawing: one window, as fractions of its monitor's
// usable area (gaps are applied when drawn, so they stay visible).
export struct DeskWindow {
    x: float,
    y: float,
    w: float,
    h: float,
    focused: bool,
}

// Home desktop drawing: one monitor in desktop pixels, offset so the
// layout's top-left is 0, 0.
export struct DeskMonitor {
    name: string,
    x: float,
    y: float,
    w: float,
    h: float,
    // Noctalia's wallpaper for this screen, when there is one.
    wallpaper: image,
    has-wallpaper: bool,
    windows: [DeskWindow],
}

// Home desktop drawing: the config values it renders, in real pixels.
export struct DeskStyle {
    gap: float,
    border: float,
    radius: float,
    focused: color,
    unfocused: color,
    background: color,
    // The wallpaper stand-in: a wash of the user's two accents.
    accent: color,
    accent-2: color,
    shadow: bool,
    strut-top: float,
    strut-bottom: float,
    strut-left: float,
    strut-right: float,
    // Desktop bounding box, in the same pixels as the monitors.
    extent-w: float,
    extent-h: float,
    mode: string,
}

export enum ToastKind { info, success, warning, error }

// One note in the bottom-right stack. `action` is a button label and
// also the name Rust routes the click by; "" means no button.
export struct Toast {
    id: int,
    kind: ToastKind,
    text: string,
    action: string,
}

// A shader-editor suggestion or reference entry: what to insert, a
// function's parameter list (or the kind of GLSL word), what it is.
export struct CodeHint {
    label: string,
    detail: string,
    doc: string,
}

// The shader editor's timing card: the event the preview plays as, its
// curve (`mode`: 0 a named curve, 1 a Bézier, 2 a spring), the plot of it
// and the values each mode edits.
export struct TimingView {
    event: string,
    // The curve as the config says it.
    text: string,
    mode: int,
    // Index into the preset names, -1 when it isn't one.
    preset: int,
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    damping: float,
    stiffness: float,
    duration-ms: int,

    // Whether the duration applies: a spring, named or inline, sets its own.
    timed: bool,

    // How long a spring takes to settle.
    settle-ms: int,
    // The curve as an SVG path in a 220 x 150 box, and the value range
    // that box spans.
    path: string,
    ymin: float,
    ymax: float,
    note: string,
}

// One row of the shader editor's settings strip: a preset parameter.
// `control`: 0 switch, 1 slider, 2 pick of a window preset (`choice`
// indexes the overlay names). Rows of a group start `indent`ed and are
// `shown` only while the group is on.
export struct ParamRow {
    key: string,
    label: string,
    description: string,
    control: int,
    on: bool,
    number: float,
    min: float,
    max: float,
    decimals: int,
    choice: int,
    indent: bool,
    shown: bool,
}

// A span of one line for the shader editor to highlight: 0-based line
// and character column, and how many characters.
export struct Mark {
    line: int,
    col: int,
    len: int,
}

// One compile problem for the shader editor to mark: its 1-based line
// (0 when the driver named none) and the driver's message.
export struct Diagnostic {
    line: int,
    message: string,
}

// A colored piece of a line in the file viewer. `kind`: 0 plain,
// 1 comment, 2 table header, 3 key, 4 string, 5 number or bool,
// 6 punctuation (toml_lines::Token, in order).
export struct CodeSpan {
    text: string,
    kind: int,
}

export struct CodeLine {
    number: int,
    spans: [CodeSpan],
}
