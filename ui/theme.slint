// Design tokens for the Slint shell. Every component reads colors, spacing,
// radii, and type sizes from this global — restyling happens here, nowhere
// else. Colors come in a dark and a light design; `dark` flips the whole
// app (set from Rust at startup and by the Settings page switcher).

export global Theme {
    // true = dark design, false = light design.
    in property <bool> dark: true;

    // Backgrounds: neutral charcoal (no blue cast), window → panel →
    // hover/selected → raised.
    out property <color> bg-0: root.dark ? #1b1b1c : #fafafa;
    out property <color> bg-1: root.dark ? #222223 : #f2f2f3;
    out property <color> bg-2: root.dark ? #2b2b2d : #e7e7e9;
    // Raised surfaces above the page: toasts, popups.
    out property <color> bg-3: root.dark ? #303032 : #ffffff;

    // Text.
    out property <color> text-1: root.dark ? #ededee : #19191a;
    out property <color> text-2: root.dark ? #9b9b9f : #6b6b70;

    // One accent + semantic colors.
    out property <color> accent: root.dark ? #7aa3ff : #3d63dd;
    out property <color> accent-hover: root.dark ? #93b4ff : #5a7ce8;
    // Accent wash for selected rows (sidebar highlight).
    out property <color> accent-soft: root.dark ? #7aa3ff26 : #3d63dd1a;
    out property <color> danger: root.dark ? #e06c75 : #c2404b;
    out property <color> warning: root.dark ? #e5b567 : #a4741c;
    out property <color> success: root.dark ? #98c379 : #3f7d3c;
    out property <color> border: root.dark ? #333335 : #e0e0e3;
    // The one strong button per page: light on dark, dark on light.
    out property <color> primary: root.dark ? #ededee : #19191a;
    out property <color> primary-hover: root.dark ? #ffffff : #33333a;
    out property <color> on-primary: root.dark ? #19191a : #fafafa;
    // Hairline between the rows of a boxed list.
    out property <color> divider: root.dark ? #ffffff12 : #00000014;

    // Spacing on a 4/8 grid.
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 24px;

    // Radius vocabulary: small controls, fields, overlays, boxed lists.
    out property <length> radius-s: 6px;
    out property <length> radius-m: 8px;
    out property <length> radius-l: 12px;
    out property <length> radius-xl: 14px;

    // Type scale: Inter for UI (default via Window), mono for values.
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-large: 16px;
    out property <length> font-title: 22px;
    out property <string> font-mono: "JetBrains Mono";
}
