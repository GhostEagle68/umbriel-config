// Design tokens for the Slint shell. Every component reads colors, spacing,
// radii, and type sizes from this global — restyling happens here, nowhere
// else. Current values are placeholders seeded from the spike; the owner's
// palette pass (Noctalia screenshots + gpick) replaces them in Phase 1.

export global Theme {
    // Backgrounds: three elevation levels, window → panel → card/hover.
    out property <color> bg-0: #1e2027;
    out property <color> bg-1: #23252d;
    out property <color> bg-2: #2c2f3a;

    // Text.
    out property <color> text-1: #f5f6f8;
    out property <color> text-2: #9aa0ae;

    // One accent + semantic colors.
    out property <color> accent: #7c9aff;
    out property <color> accent-hover: #93adff;
    out property <color> danger: #e06c75;
    out property <color> warning: #e5b567;
    out property <color> success: #98c379;
    out property <color> border: #3a3e4a;

    // Spacing on a 4/8 grid.
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 24px;

    // Radius vocabulary: exactly three.
    out property <length> radius-s: 4px;
    out property <length> radius-m: 6px;
    out property <length> radius-l: 10px;

    // Type scale: Inter for UI (default via Window), mono for values.
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-large: 16px;
    out property <length> font-title: 20px;
    out property <string> font-mono: "JetBrains Mono";
}
